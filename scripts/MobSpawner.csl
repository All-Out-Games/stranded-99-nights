MobSpawner :: class : Component {
    mob_prefab_path: string @ao_serialize;
    spawn_navmesh: Navmesh @ao_serialize;
    spawn_radius: float @ao_serialize;
    max_mobs: s64 @ao_serialize;
    spawn_rate_seconds: float @ao_serialize;
    NightOnly: bool @ao_serialize;
    NightCounter: s64 @ao_serialize;
    log_spawn_warnings: bool @ao_serialize;

    SPAWN_PLAYER_CLEARANCE_RADIUS :: 7.0;

    spawned_mobs: [..]Entity;
    rng: u64;
    navmesh_triangle_hint: s64;
    respawn_timer_remaining_seconds: float;
    respawn_timer_active: bool;
    missing_prefab_warning_logged: bool;
    missing_navmesh_warning_logged: bool;
    temporary_spawn_cap_bonus: s64;

    ao_start :: method() {
        if spawn_radius <= 0.0 { spawn_radius = 6.0; }
        if max_mobs < 0 { max_mobs = 0; }
        if spawn_rate_seconds < 0.0 { spawn_rate_seconds = 0.0; }
        if NightCounter < 0 { NightCounter = 0; }

        rng = rng_seed(entity.id);
        navmesh_triangle_hint = 0;
        respawn_timer_remaining_seconds = 0.0;
        respawn_timer_active = false;
        missing_prefab_warning_logged = false;
        missing_navmesh_warning_logged = false;
        temporary_spawn_cap_bonus = 0;

        if !Game.is_server() return;

        if NightOnly && !can_spawn_night_only_mobs() return;

        spawn_to_target_immediately(max_mobs);
    }

    ao_update :: method(dt: float) {
        if !Game.is_server() return;

        prune_spawned_mobs();

        if NightOnly && !can_spawn_night_only_mobs() {
            if spawned_mobs.count > 0 {
                destroy_all_spawned_mobs();
            }
            respawn_timer_active = false;
            respawn_timer_remaining_seconds = 0.0;
            return;
        }

        target_count := get_target_mob_cap();
        if spawned_mobs.count >= target_count {
            respawn_timer_active = false;
            respawn_timer_remaining_seconds = 0.0;
            return;
        }

        if !respawn_timer_active {
            respawn_timer_active = true;
            respawn_timer_remaining_seconds = spawn_rate_seconds;
        }

        if respawn_timer_remaining_seconds > 0.0 {
            respawn_timer_remaining_seconds -= dt;
        }

        if respawn_timer_remaining_seconds > 0.0 return;

        if try_spawn_one_mob() {
            if spawned_mobs.count < target_count {
                respawn_timer_remaining_seconds = spawn_rate_seconds;
                respawn_timer_active = true;
            } else {
                respawn_timer_remaining_seconds = 0.0;
                respawn_timer_active = false;
            }
            return;
        }

        // Keep retrying at spawn rate when a spawn attempt fails (for example: no valid navmesh).
        respawn_timer_remaining_seconds = spawn_rate_seconds;
        respawn_timer_active = true;
    }

    ao_end :: method() {
        if !Game.is_server() return;
        destroy_all_spawned_mobs();
    }

    spawn_to_target_immediately :: method(target_count: s64) {
        if target_count <= 0 return;

        attempts: s64 = 0;
        max_attempts := max(target_count * 4, 4);
        while spawned_mobs.count < target_count && attempts < max_attempts {
            if !try_spawn_one_mob() {
                attempts += 1;
                continue;
            }
            attempts += 1;
        }
    }

    get_target_mob_cap :: method() -> s64 {
        scaled_base_cap := get_scaled_base_mob_cap();
        return max(scaled_base_cap + temporary_spawn_cap_bonus, 0);
    }

    get_scaled_base_mob_cap :: method() -> s64 {
        base_cap := max(max_mobs, 0);
        if base_cap <= 0 return 0;
        if NightOnly return base_cap;

        manager := get_game_manager();
        if manager == null return base_cap;

        scale := manager->get_non_night_only_spawner_spawn_scale();
        if scale <= 1.0 return base_cap;

        scaled_cap := (base_cap.(float) * scale + 0.5).(s64);
        return max(scaled_cap, base_cap);
    }

    set_temporary_spawn_cap_bonus :: method(bonus: s64) {
        temporary_spawn_cap_bonus = max(bonus, 0);
    }

    clear_temporary_spawn_cap_bonus :: method() {
        temporary_spawn_cap_bonus = 0;
    }

    force_fill_to_current_cap :: method() {
        if !Game.is_server() return;
        prune_spawned_mobs();
        spawn_to_target_immediately(get_target_mob_cap());
    }

    prune_spawned_mobs :: method() {
        i: s64 = 0;
        while i < spawned_mobs.count {
            mob_entity := spawned_mobs[i];
            if mob_entity == null || !#alive(mob_entity) {
                spawned_mobs->unordered_remove_by_index(i);
                continue;
            }
            i += 1;
        }
    }

    destroy_all_spawned_mobs :: method() {
        for mob_entity: spawned_mobs {
            if mob_entity == null continue;
            if !#alive(mob_entity) continue;
            mob_entity->destroy();
        }
        spawned_mobs->clear();
    }

    try_spawn_one_mob :: method() -> bool {
        prefab_path := mob_prefab_path;
        if prefab_path == "" {
            if log_spawn_warnings && !missing_prefab_warning_logged {
                missing_prefab_warning_logged = true;
                log_info("MobSpawner missing mob_prefab_path on entity %.", {entity.id});
            }
            return false;
        }

        prefab := get_asset(Prefab_Asset, prefab_path);
        if prefab == null {
            if log_spawn_warnings && !missing_prefab_warning_logged {
                missing_prefab_warning_logged = true;
                log_info("MobSpawner could not load prefab at path '%'.", {prefab_path});
            }
            return false;
        }
        missing_prefab_warning_logged = false;

        navmesh := resolve_spawn_navmesh();
        if navmesh == null {
            if log_spawn_warnings && !missing_navmesh_warning_logged {
                missing_navmesh_warning_logged = true;
                log_info("MobSpawner has no navmesh assigned/fallback on entity %.", {entity.id});
            }
            return false;
        }
        missing_navmesh_warning_logged = false;

        desired_pos := sample_spawn_position_in_radius();
        spawn_pos: v2;
        hint_as_int := navmesh_triangle_hint.(int);
        if !navmesh->try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
            return false;
        }
        navmesh_triangle_hint = hint_as_int.(s64);

        if !is_spawn_position_clear_of_players(spawn_pos) {
            return false;
        }

        spawned_entity := Scene.instantiate(prefab);
        if spawned_entity == null return false;

        spawned_entity->set_local_position(spawn_pos);
        spawned_mobs->append(spawned_entity);
        return true;
    }

    resolve_spawn_navmesh :: method() -> Navmesh {
        if spawn_navmesh != null return spawn_navmesh;

        manager := get_game_manager();
        if manager != null {
            return manager.player_navmesh;
        }

        return null;
    }

    sample_spawn_position_in_radius :: method() -> v2 {
        center := entity.world_position;
        angle := rng_range_float(ref rng, 0.0, 6.2831853);
        radius_t := sqrt(rng_range_float(ref rng, 0.0, 1.0));
        dist := radius_t * spawn_radius;

        return v2{
            center.x + cos(angle) * dist,
            center.y + sin(angle) * dist
        };
    }

    is_spawn_position_clear_of_players :: method(spawn_pos: v2) -> bool {
        clearance_sq := SPAWN_PLAYER_CLEARANCE_RADIUS * SPAWN_PLAYER_CLEARANCE_RADIUS;
        foreach p: component_iterator(Player) {
            if p.health <= 0.0 continue;

            dist_sq := length_squared(p.entity.world_position - spawn_pos);
            if dist_sq <= clearance_sq {
                return false;
            }
        }
        return true;
    }

    can_spawn_night_only_mobs :: method() -> bool {
        manager := get_game_manager();
        if manager == null return false;
        if !manager->is_night_time() return false;
        return manager->get_nights() > NightCounter;
    }
}
