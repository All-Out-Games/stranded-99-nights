import "core:ao"

GroupStorage :: class : Interactable {
    prompt_text: string @ao_serialize;

    ao_start :: method() {
        this.set_listener(this);

        if radius <= 0.0 {
            radius = 2.0;
        }

        if prompt_text.count <= 0 {
            prompt_text = "Group Storage";
        }

        this.set_text(prompt_text);
        this.set_hold_text("Opening...");
    }

    can_use :: method(player: Player) -> bool {
        return player != null;
    }

    on_interact :: method(player: Player) {
        if player == null return;
        game_sfx_play(.UI_CLICK, player.entity);
        // Placeholder shell component; storage behavior intentionally removed.
    }
}
