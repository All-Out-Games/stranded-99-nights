import "core:ao"
import "core:dropped_items"
import "reusable_weapons"

ao_before_scene_load :: proc() {
    // Called before the scene is loaded
    ItemManager.AllItemDefinitions();

     // Economy currency registration (global, safe to call once).
    #static moon_currency_registered: bool;
    if !moon_currency_registered {
        moon_currency_registered = true;
        moon_icon := get_asset(Texture_Asset, "Items/Moon.png");
        Economy.register_currency("Moons", moon_icon);
    }
}

ao_start :: proc() {
    // Called after the scene is loaded
    ensure_game_manager_exists();

    // Use left mouse button as the default primary ability keybind for desktop players.
    core_globals.ability_keybinds[0] = Keybinds.register("Ability 1", .MOUSE_LEFT);
}

ao_update :: proc(dt: float) {
    // Called once per frame
     
}

ao_late_update :: proc(dt: float) {
    // Called once per frame after physics has been resolved
}

MOON_CURRENCY :: "Moons";


PLAYER_LIGHT_BASE_INNER_RADIUS :: 12;
PLAYER_LIGHT_BASE_OUTER_RADIUS :: 14;
PLAYER_LIGHT_MIN_INNER_RADIUS :: 5;
PLAYER_LIGHT_MIN_OUTER_RADIUS :: 7;
PLAYER_LIGHT_RADIUS_Y_PADDING :: 2.0;
PLAYER_VOYAGE_LOS_RADIUS_BONUS :: 3.0;
PLAYER_LIGHT_FIXED_RADIUS :: 40.0;
PLAYER_LIGHT_INTENSITY :: 1.0;
PLAYER_LIGHT_COLOR := v4.{1.0, 1.0, 1.0, 1.0};
PLAYER_CAMERA_NORMAL_ZOOM_OUT_MULTIPLIER :: 1.35;
PLAYER_CAMERA_VOYAGE_ZOOM_OUT_MULTIPLIER :: 1.65;
PLAYER_DAMAGE_PULSE_DURATION_SECONDS :: 0.65;
PLAYER_DAMAGE_PULSE_OSCILLATIONS :: 7.0;

CLOCK_ROTATION_LERP_STEP :: 0.35;
CLOCK_ALPHA_LERP_STEP :: 0.03;
NIGHT_TINT_MAX_ALPHA :: 0.35;
NIGHT_TINT_COLOR := v4.{0.0, 0.0, 0.95, 1.0};
RESOURCE_GATHER_SWING_INTERVAL :: 0.5;
MELEE_IDLE_AIM_DISTANCE :: 3.0;
MELEE_ATTACK_AIM_LOCK_SECONDS :: 0.45;
PLAYER_DEATH_FADE_SECONDS :: 2.0;
PLAYER_DEATH_BLACK_HOLD_SECONDS :: 2.0;
PLAYER_DEATH_FADE_IN_SECONDS :: 2.0;
PLAYER_DOWNED_DURATION_SECONDS :: 45.0;
PLAYER_DOWNED_REVIVE_HEALTH :: 25.0;
PLAYER_DEATH_DROP_SELF_PICKUP_BLOCK_SECONDS :: 5.0;
PLAYER_MANUAL_DROP_SELF_PICKUP_BLOCK_SECONDS :: 2.5;
GHOST_HIDE_FROM_LIVING_REASON :: "ghost_hide_from_living";
GHOST_FACING_DELTA_THRESHOLD :: 0.01;
ISLAND1_RESPAWN_ENTITY_NAME :: "Island1Spawn";
DEFAULT_RESPAWN_POSITION := v2.{0.0, 0.0};
PRE_NIGHT_BEACON_ARROW_HIDE_DISTANCE :: 10.0;
SUPPLY_DROP_ARROW_HIDE_DISTANCE :: 8.0;

Death_Drop_Pickup_Block :: struct {
    dropped_entity_id: u64;
    expires_time: float;
}

lerp_towards :: proc(current: float, target: float, max_step: float) -> float {
    delta := target - current;
    if delta == 0.0 return target;

    step := max(max_step, 0.0);
    if abs(delta) <= step return target;

    return current + (delta / abs(delta)) * step;
}

get_respawn_position :: proc() -> v2 {
    manager := get_game_manager();
    if manager != null && manager.island1_spawn != null {
        return manager.island1_spawn.world_position;
    }

    spawn_entity := Scene.get_entity_by_name(ISLAND1_RESPAWN_ENTITY_NAME);
    if spawn_entity != null {
        return spawn_entity.world_position;
    }

    return DEFAULT_RESPAWN_POSITION;
}

Player_Death_Effect :: class : Effect_Base {
    did_respawn: bool;

    effect_start :: method() {
        player_specific.freeze_player = true;
        did_respawn = false;
        if player != null {
            player->trigger_death_animation();
        }
    }

    effect_update :: method(dt: float) {
        elapsed := get_elapsed_time();
        respawn_time := PLAYER_DEATH_FADE_SECONDS + PLAYER_DEATH_BLACK_HOLD_SECONDS;
        total_time := respawn_time + PLAYER_DEATH_FADE_IN_SECONDS;

        if !did_respawn && elapsed >= respawn_time {
            did_respawn = true;
            if Game.is_server() && player != null {
                player.health = player.max_health;
                player.entity->set_local_position(get_respawn_position());
            }
        }

        if elapsed >= total_time {
            remove_effect(false);
            return;
        }
    }

    effect_late_update :: method(dt: float) {
        if player == null return;
        if !player->is_local() return;

        elapsed := get_elapsed_time();
        fade_out_t := clamp(elapsed / PLAYER_DEATH_FADE_SECONDS, 0.0, 1.0);
        fade_in_start := PLAYER_DEATH_FADE_SECONDS + PLAYER_DEATH_BLACK_HOLD_SECONDS;

        alpha: float;
        if elapsed < PLAYER_DEATH_FADE_SECONDS {
            alpha = fade_out_t;
        } else if elapsed < fade_in_start {
            alpha = 1.0;
        } else {
            fade_in_t := clamp((elapsed - fade_in_start) / PLAYER_DEATH_FADE_IN_SECONDS, 0.0, 1.0);
            alpha = 1.0 - fade_in_t;
        }

        if alpha <= 0.0 return;

        UI.push_screen_draw_context();
        defer UI.pop_draw_context();
        screen := UI.get_screen_rect();
        UI.quad(screen, core_globals.white_sprite, {0, 0, 0, alpha});
    }

    effect_end :: method(interrupt: bool) {
        if player != null {
            player->reset_death_animation();
        }
    }
}

Downed_Revive_Interactable :: class : Interactable {
    downed_player: Player;

    ao_start :: method() {
        this->set_listener(this);
        this->set_text("Revive");
        this->set_hold_text("Reviving...");
        if radius <= 0.0 {
            radius = 2.0;
        }
        if required_hold_time <= 0.0 {
            required_hold_time = 0.35;
        }
        prompt_offset = v2{0.0, 1.0};
    }

    can_use :: method(player: Player) -> bool {
        if player == null return false;
        if downed_player == null return false;
        if player == downed_player return false;
        if player->is_dead_for_night_state() return false;
        return downed_player->is_downed_for_night();
    }

    on_interact :: method(player: Player) {
        if downed_player == null return;
        if downed_player->revive_from_downed(PLAYER_DOWNED_REVIVE_HEALTH) {
            game_sfx_play(.REVIVE, downed_player.entity);
        }
    }
}

Player_Downed_Effect :: class : Effect_Base {
    revive_interactable_entity: Entity;

    effect_start :: method() {
        player_specific.freeze_player = true;
        if player != null {
            player->trigger_death_animation();
        }
        spawn_revive_interactable();
    }

    spawn_revive_interactable :: method() {
        if !Game.is_server() return;
        if player == null return;
        if player.entity == null return;

        revive_interactable_entity = Scene.create_entity();
        if revive_interactable_entity == null return;

        revive_interactable_entity->set_parent(player.entity, false);
        revive_interactable_entity->set_local_position(v2{0.0, 0.0});

        revive := revive_interactable_entity->add_component(Downed_Revive_Interactable);
        if revive == null return;
        revive.downed_player = player;
        revive.priority = 50;
    }

    destroy_revive_interactable :: method() {
        if !Game.is_server() return;
        if revive_interactable_entity == null return;
        if #alive(revive_interactable_entity) {
            revive_interactable_entity->destroy();
        }
        revive_interactable_entity = null;
    }

    revive_in_place :: method(revive_health: float) {
        if player == null return;
        player->set_ghost_mode_enabled(false);
        player.health = clamp(revive_health, 1.0, player.max_health);
        remove_effect(false);
    }

    revive_at_respawn :: method() {
        if player == null return;
        player->set_ghost_mode_enabled(false);
        player.health = player.max_health;
        if player.entity != null {
            player.entity->set_local_position(get_respawn_position());
        }
        remove_effect(false);
    }

    effect_update :: method(dt: float) {
        if player == null return;

        manager := get_game_manager();
        if manager == null || manager->get_phase() != .IN_ROUND {
            this->revive_at_respawn();
            return;
        }

        if !manager->is_night_time() {
            this->revive_at_respawn();
            return;
        }

        elapsed := get_elapsed_time();
        if elapsed >= PLAYER_DOWNED_DURATION_SECONDS {
            player->set_ghost_mode_enabled(true);
            remove_effect(false);
            return;
        }
    }

    effect_late_update :: method(dt: float) {
        if Game.is_server() return;
        if player == null return;
        if player.entity == null return;

        elapsed := get_elapsed_time();
        remaining_seconds := max(PLAYER_DOWNED_DURATION_SECONDS - elapsed, 0.0);
        fill_t := clamp(remaining_seconds / PLAYER_DOWNED_DURATION_SECONDS, 0.0, 1.0);

        center := player.entity.world_position + v2{0.0, 2.2};
        bar_rect := Rect{center, center}->grow(0.04, 0.72, 0.04, 0.72);
        fill_rect := bar_rect->inset(0.01);
        fill_rect.max.x = fill_rect.min.x + fill_rect->width() * fill_t;

        UI.push_world_draw_context();
        defer UI.pop_draw_context();
        UI.push_z(center.y - 0.0002);
        defer UI.pop_z();

        UI.quad(bar_rect, core_globals.white_sprite, {0.0, 0.0, 0.0, 0.85});
        UI.quad(fill_rect, core_globals.white_sprite, {0.86, 0.18, 0.18, 0.95});

        text_rect := bar_rect->offset(0.0, 0.22)->grow(0.2, 0.2, 0.2, 0.2);
        ts := UI.default_text_settings();
        ts.size = 0.20;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.color = {1, 1, 1, 1};
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        UI.text(text_rect, ts, "%", {format_float(remaining_seconds, decimals=1)});
    }

    effect_end :: method(interrupt: bool) {
        destroy_revive_interactable();
        if player != null && !player.is_ghost_mode {
            player->reset_death_animation();
        }
    }
}

Player :: class : Player_Base {
    health: float;
    max_health: float;
    equipped_weapon_type: Weapon_Type;
    equipped_item_def: Item_Definition;
    last_selected_index: s64;
    boomwheel_cannon: Boomwheel_Cannon; // only needed if using Boomwheel
    next_resource_gather_swing_time: float;
    melee_attack_aim_lock_until_time: float;
    crafting_ui_open: bool;
    selected_crafting_recipe_index: s64;
    beacon_ui_open: bool;
    active_beacon: Beacon;
    death_drop_pickup_blocks: [..]Death_Drop_Pickup_Block;
    is_ghost_mode: bool;
    ghost_current_animation_name: string;
    ghost_last_world_position: v2;
    ghost_last_world_position_initialized: bool;

    // Local-only LOS light (viewer-specific).
	local_light_entity: Entity;
	local_light: Light;
	local_light_caster: LOS_Caster;
	clock_cur_alpha: float;
	clock_cur_rotation: float;
    default_camera_size: float;
    damage_pulse_elapsed_seconds: float;

    ao_start :: method() {
        health = 100.0;
        max_health = 100.0;
        last_selected_index = -1;
        clock_cur_alpha = 1.0;
        clock_cur_rotation = -90.0;
        next_resource_gather_swing_time = 0.0;
        melee_attack_aim_lock_until_time = 0.0;
        crafting_ui_open = false;
        selected_crafting_recipe_index = 0;
        beacon_ui_open = false;
        active_beacon = null;
        is_ghost_mode = false;
        ghost_current_animation_name = "";
        ghost_last_world_position = entity.world_position;
        ghost_last_world_position_initialized = true;
        damage_pulse_elapsed_seconds = PLAYER_DAMAGE_PULSE_DURATION_SECONDS;
        default_camera_size = max(camera.size, 1.0);
        camera.size = max(default_camera_size * PLAYER_CAMERA_NORMAL_ZOOM_OUT_MULTIPLIER, 1.0);

        if Game.is_server() {
            init_weapon_items();
            manager := ensure_game_manager_exists();
            if manager != null {
                manager->on_player_joined(this);
            }
        }
        setup_reusable_weapons_player_state_machine(this);
    }

    ao_update :: method(dt: float) {
        // Called once per frame
        this->update_damage_pulse(dt);
        this->update_ghost_mode_animation();
        this->update_ghost_visibility_for_local_view();
        if this->is_local() {
            this->update_voyage_camera_zoom();
        }
        if this->is_local_or_server() {
			if this->is_local() {
				this->update_local_vision_light();
			}
            this->update_melee_weapon_idle_aim();
        }
    }

    update_voyage_camera_zoom :: method() {
        manager := get_game_manager();
        if manager != null && manager->should_use_voyage_camera_zoom() {
            camera.size = max(default_camera_size * PLAYER_CAMERA_VOYAGE_ZOOM_OUT_MULTIPLIER, 1.0);
            return;
        }
        camera.size = max(default_camera_size * PLAYER_CAMERA_NORMAL_ZOOM_OUT_MULTIPLIER, 1.0);
    }

    update_melee_weapon_idle_aim :: method() {
        if equipped_weapon_type == .NONE return;

        config := get_weapon_config(equipped_weapon_type);
        if config.fire_mode != .MELEE return;

        if get_time() < melee_attack_aim_lock_until_time return;

        // Match the player's current facing when holding melee weapons.
        scale_x := entity.local_scale.x;
        forward := v2{1.0, 0.0};
        if scale_x < 0.0 {
            forward.x = -1.0;
        }
        this->set_aim_target(entity.world_position + forward * MELEE_IDLE_AIM_DISTANCE);
    }

   ao_late_update :: method(dt: float) {
    this->update_ghost_facing_from_movement();
    dead_for_night := this->is_dead_for_night_state();
    if dead_for_night {
        crafting_ui_open = false;
        beacon_ui_open = false;
        active_beacon = null;
    }

    this->draw_night_tint_overlay();

    draw_coin_currency_hud(this);

    if is_local_or_server() && !dead_for_night {
        // Draw hotbar first so held-item abilities react immediately on selection change.
        options := Inventory_Draw_Options.default();
        hotbar := Items.draw_hotbar(this, default_inventory, options);
        handle_equipped_item_changing(hotbar.selected_item_index);

        if player_is_holding_healing_item(this) {
            draw_ability_button(this, Eat_Fish_Ability, 0);
        } else {
            // Primary ability: default melee unless a weapon overrides it.
            if equipped_weapon_type != .NONE {
                config := get_weapon_config(equipped_weapon_type);
                switch config.fire_mode {
                    case .CONTINUOUS:  { draw_ability_button(this, Continuous_Fire_Ability, 0); }
                    case .SINGLE_SHOT: { draw_ability_button(this, Single_Shot_Ability, 0); }
                    case .SPREAD:      { draw_ability_button(this, Spread_Shot_Ability, 0); }
                    case .LOBBED:      { draw_ability_button(this, Lobbed_Shot_Ability, 0); }
                    case .BEAM:        { draw_ability_button(this, Beam_Ability, 0); }
                    case .SPECIAL:     { draw_ability_button(this, Special_Ability, 0); }
                    case .MELEE:       { draw_ability_button(this, Melee_Ability, 0); }
                }
            } else {
                draw_ability_button(this, Melee_Ability, 0);
            }
        }

        // Always-available secondary movement ability.
        draw_ability_button(this, Dodge_Roll_Ability, 1);

        manager := get_game_manager();
        if manager != null && manager->can_player_force_start_from_lobby(this) {
            draw_ability_button(this, Private_Server_Start_Ability, 5);
        }

        dropped_item: Dropped_Item;
        if Dropped_Item.handle_dropped_item(hotbar, entity.world_position, ref dropped_item) {
            manager = get_game_manager();
            drop_navmesh: Navmesh;
            if manager != null {
                drop_navmesh = manager.player_navmesh;
            }

            drop_rng := rng_seed_time();
            dropped_item->do_spawn_animation(ref drop_rng, drop_navmesh);
            this->register_pickup_block(dropped_item, PLAYER_MANUAL_DROP_SELF_PICKUP_BLOCK_SECONDS);
            game_sfx_play(.ITEM_DROP, entity);
        }

        // Crafting UI and actions are player-scoped state.
        CraftingSystem.draw_ui(this);
        BeaconSystem.draw_ui(this);
    }

    if !Game.is_server() {
        draw_health_bar(this); // from weapons_ui_helpers.csl
    }

    if this->is_local_or_server() && !crafting_ui_open && !beacon_ui_open {
        this->draw_day_night_clock();
    }

    if this->is_local_or_server() {
        this->draw_pre_night_beacon_arrow();
        this->draw_supply_drop_arrow();
    }

    if this->is_local_or_server() {
        this->draw_lobby_waiting_text();
        this->draw_round_start_intro();
        draw_global_notification_banner(this);
    }
   }

    draw_night_tint_overlay :: method() {
        if !this->is_local_or_server() return;

        manager := get_game_manager();
        if manager == null return;
        if manager->get_phase() != .IN_ROUND return;
        if !manager->is_night_time() return;

        tint_alpha := clamp(manager->get_night_blend(), 0.0, 1.0) * NIGHT_TINT_MAX_ALPHA;
        if tint_alpha <= 0.0 return;

        UI.push_screen_draw_context();
        defer UI.pop_draw_context();
        UI.quad(UI.get_screen_rect(), core_globals.white_sprite, {NIGHT_TINT_COLOR.x, NIGHT_TINT_COLOR.y, NIGHT_TINT_COLOR.z, tint_alpha});
    }

    ao_end :: method() {
        // Called when this component is destroyed
        // Local-only: destroy LOS light.
		if this->is_local() {
			if local_light_entity != null && #alive(local_light_entity) {
				local_light_entity->destroy();
			}
			local_light_entity = null;
			local_light = null;
			local_light_caster = null;
		}
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Called to determine if the player is allowed to use the given ability
        if entity.active_effect != null && entity.active_effect.#type == Player_Death_Effect return false;
        if this->is_dead_for_night_state() return false;
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Called to determine if the player is allowed to use the given interactable
        if entity.active_effect != null && entity.active_effect.#type == Player_Death_Effect return false;
        if this->is_dead_for_night_state() return false;
        if this->is_death_drop_pickup_blocked(interactable) return false;
        return true;
    }

    ao_on_interactable_used :: method(interactable: Interactable) {
        // Called when the player uses the given interactable
        if interactable == null return;
        if interactable.#type != ResourceNode return;

        node := interactable.(ResourceNode);
        this->drive_resource_gather_feedback(node);
    }

    ao_on_holding_interactable :: method(interactable: Interactable) {
        // Called once per frame while the player is holding on the interactable
        if interactable == null return;
        if interactable.#type != ResourceNode return;

        node := interactable.(ResourceNode);
        this->drive_resource_gather_feedback(node);
    }

    draw_coin_currency_hud :: proc(player: Player) {
    if player == null return;
    if !player->is_local() return;

    safe := UI.get_safe_screen_rect();

    // Top-right coin panel
    panel := safe->bottom_left_rect()->grow(50, 100, 50, 100)->offset(150, 70);
    #static gold_frame := get_asset(Texture_Asset, "UI/GoldFrame.png");
    if gold_frame != null {
        UI.quad(panel, gold_frame, {0.5, 0.5, 0.5, 1});
    }
    else {
        UI.quad(panel, core_globals.white_sprite, {0.15, 0.15, 0.15, 0.85});
    }

    inner := panel->inset(12);
    icon_rect := inner->cut_left_unscaled(54);
    _ := inner->cut_left_unscaled(12);

    #static coin_icon := get_asset(Texture_Asset, "Items/Moon.png");
    if coin_icon != null {
        UI.quad(icon_rect->fit_aspect(coin_icon->get_aspect()), coin_icon);
    }

    balance := Economy.get_balance(player, MOON_CURRENCY);

    ts := UI.default_text_settings();
    ts.size = 36;
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 3;
    ts.outline_color = {0, 0, 0, 1};
    UI.text(inner, ts, "%", {balance});
    }

    draw_global_notification_banner :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;

    manager := get_game_manager();
    if manager == null return;
    if !manager->should_draw_broadcast_notification() return;

    message := manager->get_broadcast_notification_text();
    if message.count <= 0 return;

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(10000);
    defer UI.pop_layer();

    screen_rect := UI.get_screen_rect();
    top_third_rect := screen_rect->subrect(0.0, 0.6667, 1.0, 1.0);
    banner_rect := top_third_rect->center_rect()->offset_unscaled(0, -screen_rect->height() * 0.15);

    #static notif_ribbon := get_asset(Texture_Asset, "UI/NotifRibbon.png");
    if notif_ribbon != null {
        banner_width := screen_rect->width();
        banner_height := min(banner_width / notif_ribbon->get_aspect(), top_third_rect->height() * 0.9);
        banner_rect = banner_rect->grow_unscaled(
            banner_height * 0.5,
            banner_width * 0.5,
            banner_height * 0.5,
            banner_width * 0.5
        );
        UI.quad(banner_rect, notif_ribbon);
    } else {
        banner_height := min(screen_rect->height() * 0.14, top_third_rect->height() * 0.9);
        banner_rect = banner_rect->grow_unscaled(
            banner_height * 0.5,
            screen_rect->width() * 0.5,
            banner_height * 0.5,
            screen_rect->width() * 0.5
        );
        UI.quad(banner_rect, core_globals.white_sprite, {0.95, 0.1, 0.1, 1.0});
    }

    text_rect := banner_rect->inset(28, 180, 28, 180);
    ts := UI.default_text_settings();
    ts.size = 44;
    ts.color = {1, 1, 1, 1};
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 3;
    ts.outline_color = {0, 0, 0, 1};
    ts.word_wrap = true;
    ts.do_autofit = true;
    ts.autofit_min_size = 24;
    ts.autofit_max_size = 52;
    UI.text(text_rect, ts, message);
    }

    drive_resource_gather_feedback :: method(node: ResourceNode) {
        if node == null return;
        if node.entity == null return;
        if !is_local_or_server() return;

        this->set_aim_target(node.entity.world_position);

        if animator == null return;
        if animator.instance == null return;
        if animator.instance.state_machine == null return;

        now := get_time();
        if now < next_resource_gather_swing_time return;

        node->trigger_harvest_visual_pulse();
        next_resource_gather_swing_time = now + RESOURCE_GATHER_SWING_INTERVAL;
        game_sfx_play(.RESOURCE_GATHER, entity);

        if animator == null return;
        if animator.instance == null return;
        if animator.instance.state_machine == null return;

        animator.instance.state_machine->set_trigger("resource_gather_swing");
    }

    apply_mob_damage :: method(amount: float) {
        if amount <= 0.0 return;
        if health <= 0.0 return;
        if this->is_dead_for_night_state() return;
        manager := get_game_manager();
        raid_active := false;
        if manager != null {
            raid_active = manager->should_mobs_ignore_beacon_safety();
        }
        if !raid_active && BeaconSystem.is_position_inside_active_safety_zone(entity.world_position) return;

        if manager != null && manager->is_voyage_damage_redirect_active() {
            absorbed_damage := manager->apply_voyage_damage(amount);
            if absorbed_damage > 0.0 {
                this->trigger_damage_feedback(absorbed_damage);
                game_sfx_play(.DAMAGE_HIT, entity);
            }
            return;
        }

        health -= amount;
        if health < 0.0 {
            health = 0.0;
        }

        this->trigger_damage_feedback(amount);
        game_sfx_play(.DAMAGE_HIT, entity);
        if health <= 0.0 {
            game_sfx_play(.DEATH, entity);
            this->drop_all_inventory_items_on_death();
            manager := get_game_manager();
            if manager != null && manager->get_phase() == .IN_ROUND && manager->is_night_time() {
                this->begin_downed_effect();
                manager->notify_all_players_player_downed(this);
            } else {
                this->begin_death_effect();
            }
        }
    }

    prune_expired_death_drop_pickup_blocks :: method() {
        now := get_time();
        i: s64 = 0;
        while i < death_drop_pickup_blocks.count {
            entry := death_drop_pickup_blocks[i];
            if now >= entry.expires_time {
                death_drop_pickup_blocks->ordered_remove_by_index(i);
                continue;
            }
            i += 1;
        }
    }

    is_death_drop_pickup_blocked :: method(interactable: Interactable) -> bool {
        if interactable == null return false;
        if interactable.entity == null return false;
        if death_drop_pickup_blocks.count <= 0 return false;

        this->prune_expired_death_drop_pickup_blocks();
        interactable_id := interactable.entity.id;
        for entry: death_drop_pickup_blocks {
            if entry.dropped_entity_id == interactable_id {
                return true;
            }
        }
        return false;
    }

    register_death_drop_pickup_block :: method(dropped: Dropped_Item) {
        this->register_pickup_block(dropped, PLAYER_DEATH_DROP_SELF_PICKUP_BLOCK_SECONDS);
    }

    register_pickup_block :: method(dropped: Dropped_Item, block_seconds: float) {
        if dropped == null return;
        if dropped.entity == null return;

        if block_seconds < 0.0 {
            block_seconds = 0.0;
        }

        block: Death_Drop_Pickup_Block;
        block.dropped_entity_id = dropped.entity.id;
        block.expires_time = get_time() + block_seconds;
        death_drop_pickup_blocks->append(block);
    }

    drop_all_inventory_items_on_death :: method() {
        if !Game.is_server() return;
        if default_inventory == null return;
        if default_inventory.self == null return;
        if default_inventory.capacity <= 0 return;

        manager := get_game_manager();
        drop_navmesh: Navmesh;
        if manager != null {
            drop_navmesh = manager.player_navmesh;
        }

        // Keep exactly one equipped weapon item in inventory on death.
        keep_equipped_weapon_item: Item_Instance;
        if equipped_weapon_type != .NONE {
            if last_selected_index >= 0 && last_selected_index < default_inventory.capacity {
                selected_item := default_inventory->get_item(last_selected_index);
                if selected_item != null {
                    selected_def := selected_item->get_definition();
                    if selected_def != null && get_weapon_type_for_item(selected_def) == equipped_weapon_type {
                        keep_equipped_weapon_item = selected_item;
                    }
                }
            }

            if keep_equipped_weapon_item == null && equipped_item_def != null {
                for i: 0..default_inventory.capacity-1 {
                    item := default_inventory->get_item(i);
                    if item == null continue;
                    if item->get_definition() != equipped_item_def continue;
                    keep_equipped_weapon_item = item;
                    break;
                }
            }
        }

        drop_origin := entity.world_position;
        drop_rng := rng_seed_time();
        for i: 0..default_inventory.capacity-1 {
            item := default_inventory->get_item(i);
            if item == null continue;
            if item == keep_equipped_weapon_item continue;

            Items.remove_item_from_inventory(item, default_inventory);

            dropped := Dropped_Item.spawn(drop_origin, item);
            if dropped == null continue;

            dropped->do_spawn_animation(ref drop_rng, drop_navmesh);
            this->register_death_drop_pickup_block(dropped);
        }
    }

    trigger_damage_feedback :: method(amount: float) {
        damage_pulse_elapsed_seconds = 0.0;

        manager := get_game_manager();
        if manager == null return;

        damage_text: string;
        whole_damage := amount.(int);
        whole_damage_as_float := whole_damage.(float);
        if abs(amount - whole_damage_as_float) <= 0.01 {
            damage_text = format_string("%", {whole_damage});
        } else {
            damage_text = format_string("%", {format_float(amount, decimals=1)});
        }

        dn := new(DamageNumbers);
        dn.Text = damage_text;
        dn.Position = entity.world_position + v2{0, 1.85};
        dn.LastPosition = dn.Position;
        dn.Color = {1.0, 0.2, 0.2, 1.0};
        dn.T = 0.0;
        dn.SpaceText = false;
        dn.DoingFading = true;

        ts := UI.default_text_settings();
        ts.size = 0.30;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        ts.color = {1, 1, 1, 1};
        dn.TextSettings = ts;

        manager.damage_numbers->append(dn);
    }

    begin_death_effect :: method() {
        if this->is_dead_for_night_state() return;
        if entity.active_effect != null && entity.active_effect.#type == Player_Death_Effect return;
        effect := new(Player_Death_Effect);
        entity->set_active_effect(effect);
    }

    begin_downed_effect :: method() {
        if this->is_dead_for_night_state() return;
        if entity.active_effect != null && entity.active_effect.#type == Player_Downed_Effect return;
        effect := new(Player_Downed_Effect);
        entity->set_active_effect(effect);
    }

    is_downed_for_night :: method() -> bool {
        return entity.active_effect != null && entity.active_effect.#type == Player_Downed_Effect;
    }

    is_dead_for_night_state :: method() -> bool {
        if is_ghost_mode return true;
        return this->is_downed_for_night();
    }

    revive_from_downed :: method(revive_health: float) -> bool {
        if !this->is_downed_for_night() return false;
        downed := entity.active_effect.(Player_Downed_Effect);
        downed->revive_in_place(revive_health);
        return true;
    }

    revive_for_day_start :: method() {
        if this->is_downed_for_night() {
            downed := entity.active_effect.(Player_Downed_Effect);
            downed->revive_at_respawn();
            return;
        }

        if !is_ghost_mode return;
        this->set_ghost_mode_enabled(false);
        health = max_health;
        entity->set_local_position(get_respawn_position());
        this->reset_death_animation();
    }

    set_ghost_mode_enabled :: method(ghost_enabled: bool) {
        if is_ghost_mode == ghost_enabled return;

        is_ghost_mode = ghost_enabled;
        ghost_current_animation_name = "";
        ghost_last_world_position_initialized = false;
        // Ensure the animator leaves the death state before ghost playback starts.
        this->reset_death_animation();
    }

    update_ghost_visibility_for_local_view :: method() {
        if Game.is_server() return;

        hidden_from_local := false;
        if local_player, ok := Game.get_local_player(); ok {
            if local_player != this && is_ghost_mode && !local_player.is_ghost_mode {
                hidden_from_local = true;
            }
        }

        if hidden_from_local {
            this->add_invisibility_reason(GHOST_HIDE_FROM_LIVING_REASON);
            this->add_name_invisibility_reason(GHOST_HIDE_FROM_LIVING_REASON);
        } else {
            this->remove_invisibility_reason(GHOST_HIDE_FROM_LIVING_REASON);
            this->remove_name_invisibility_reason(GHOST_HIDE_FROM_LIVING_REASON);
        }
    }

    update_ghost_facing_from_movement :: method() {
        if entity == null return;

        current_world_position := entity.world_position;
        if !is_ghost_mode {
            ghost_last_world_position = current_world_position;
            ghost_last_world_position_initialized = true;
            return;
        }

        if !ghost_last_world_position_initialized {
            ghost_last_world_position = current_world_position;
            ghost_last_world_position_initialized = true;
            return;
        }

        delta_x := current_world_position.x - ghost_last_world_position.x;
        if delta_x > GHOST_FACING_DELTA_THRESHOLD {
            this->set_facing_right(true);
        } else if delta_x < -GHOST_FACING_DELTA_THRESHOLD {
            this->set_facing_right(false);
        }

        ghost_last_world_position = current_world_position;
    }

    update_ghost_mode_animation :: method() {
        if animator == null return;
        if animator.instance == null return;
        if animator.instance.state_machine == null return;

        animator.instance.state_machine->set_bool("is_ghost_mode", is_ghost_mode);
    }

    clear_inventory_for_restart :: method() {
        if !Game.is_server() return;
        if default_inventory == null || default_inventory.self == null return;
        if default_inventory.capacity <= 0 return;

        for i: 0..default_inventory.capacity-1 {
            item := default_inventory->get_item(i);
            if item == null continue;
            Items.remove_item_from_inventory(item, default_inventory);
        }
    }

    reset_for_game_restart :: method() {
        this->set_ghost_mode_enabled(false);
        if this->is_downed_for_night() {
            downed := entity.active_effect.(Player_Downed_Effect);
            downed->revive_at_respawn();
        } else if entity.active_effect != null && entity.active_effect.#type == Player_Death_Effect {
            death_effect := entity.active_effect.(Player_Death_Effect);
            death_effect->remove_effect(true);
            health = max_health;
            entity->set_local_position(get_respawn_position());
        } else {
            health = max_health;
            this->reset_death_animation();
        }

        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;
        last_selected_index = -1;
        this->set_mouse_ik_enabled(false);
        crafting_ui_open = false;
        beacon_ui_open = false;
        active_beacon = null;
        death_drop_pickup_blocks->clear();
        this->clear_inventory_for_restart();
    }

    trigger_death_animation :: method() {
        if is_ghost_mode return;
        if animator == null return;
        if animator.instance == null return;
        if animator.instance.state_machine == null return;
        animator.instance.state_machine->set_trigger("death_no_hp");
    }

    reset_death_animation :: method() {
        if animator == null return;
        if animator.instance == null return;
        if animator.instance.state_machine == null return;
        animator.instance.state_machine->set_trigger("death_reset");
    }

    update_damage_pulse :: method(dt: float) {
        if animator == null return;
        if animator.instance == null return;

        if damage_pulse_elapsed_seconds >= PLAYER_DAMAGE_PULSE_DURATION_SECONDS {
            animator.instance.color_multiplier = {1, 1, 1, 1};
            return;
        }

        damage_pulse_elapsed_seconds += dt;
        if damage_pulse_elapsed_seconds >= PLAYER_DAMAGE_PULSE_DURATION_SECONDS {
            animator.instance.color_multiplier = {1, 1, 1, 1};
            return;
        }

        t := clamp(damage_pulse_elapsed_seconds / PLAYER_DAMAGE_PULSE_DURATION_SECONDS, 0.0, 1.0);
        phase := t * PLAYER_DAMAGE_PULSE_OSCILLATIONS * 6.2831853;
        white_mix := 0.5 + 0.5 * sin(phase - 1.5707963);
        white_mix = clamp(white_mix, 0.0, 1.0);
        animator.instance.color_multiplier = {1.0, white_mix, white_mix, 1.0};
    }

    ao_on_state_sync :: method() {
        // Called on the client after applying a state sync from the server
        // Use this to override things for the local player only like name colors or lighting for example
        this->update_ghost_visibility_for_local_view();
    }

    get_local_light_radii :: proc(using this: Player) -> v2 {
		night_blend := 0.0;
		manager := get_game_manager();
		if manager != null {
			night_blend = clamp(manager->get_night_blend(), 0.0, 1.0);
		}

		base_inner := PLAYER_LIGHT_BASE_INNER_RADIUS.(float);
		min_inner := PLAYER_LIGHT_MIN_INNER_RADIUS.(float);
		min_outer := PLAYER_LIGHT_MIN_OUTER_RADIUS.(float);

		inner_radius := lerp(base_inner, min_inner, night_blend);
		inner_radius = max(inner_radius, min_inner);

		outer_radius := inner_radius + PLAYER_LIGHT_RADIUS_Y_PADDING;
		outer_radius = max(outer_radius, min_outer);

		return v2.{inner_radius, outer_radius};
	}

	ensure_local_vision_light :: proc(using this: Player) {
		if local_light_entity != null && #alive(local_light_entity) return;

		local_light_entity = Scene.create_entity();
		local_light_entity->set_parent(this.entity, false);
		local_light_entity->set_local_enabled(true);
		local_light_entity->set_local_position(v2.{0.0, 0.0});
		local_light_entity->set_local_rotation(0.0);
		local_light_entity->set_local_scale(v2.{1.0, 1.0});

		local_light = local_light_entity->add_component(Light);
		local_light.color = PLAYER_LIGHT_COLOR;
		local_light.intensity = PLAYER_LIGHT_INTENSITY;
		local_light.radii = v2.{PLAYER_LIGHT_FIXED_RADIUS, PLAYER_LIGHT_FIXED_RADIUS + PLAYER_LIGHT_RADIUS_Y_PADDING};

		local_light_caster = local_light_entity->add_component(LOS_Caster);
		local_light_caster.radii = local_light.radii;
	}

	update_local_vision_light :: proc(using this: Player) {
		if !this->is_local() return;
		if !#alive(this.entity) return;

		this->ensure_local_vision_light();

		if local_light == null && local_light_entity != null {
			local_light = local_light_entity->get_component(Light);
		}
		if local_light_caster == null && local_light_entity != null {
			local_light_caster = local_light_entity->get_component(LOS_Caster);
		}
		if local_light == null || local_light_caster == null return;

		radii := this->get_local_light_radii();
		local_light.radii = v2.{PLAYER_LIGHT_FIXED_RADIUS, PLAYER_LIGHT_FIXED_RADIUS + PLAYER_LIGHT_RADIUS_Y_PADDING};
	caster_radii := radii;
	manager := get_game_manager();
	if manager != null && manager->should_use_voyage_camera_zoom() {
		caster_radii.x += PLAYER_VOYAGE_LOS_RADIUS_BONUS;
		caster_radii.y += PLAYER_VOYAGE_LOS_RADIUS_BONUS;
	}
	local_light_caster.radii = caster_radii;
	}

    draw_day_night_clock :: method() {
        manager := get_game_manager();
        if manager == null return;
        if manager->get_phase() != .IN_ROUND return;

        clock_rect := UI.get_safe_screen_rect()->top_center_rect()->grow(75)->offset(0, -140);
        moon_rect := clock_rect->right_center_rect()->grow(68)->offset(120, 0);
        night := get_asset(Texture_Asset, "UI/Clock_Night.png");
        day := get_asset(Texture_Asset, "UI/Clock_Day.png");
        overlay := get_asset(Texture_Asset, "UI/Clock_OL.png");
        moon := get_asset(Texture_Asset, "UI/Moon.png");

        target_rotation := -90.0 + (360.0 * (manager->get_day_night_clock_hours() / 24.0));
        // Keep the target on a forward-only unwrapped timeline so the hand never rotates backward.
        while target_rotation < clock_cur_rotation {
            target_rotation += 360.0;
        }
        target_alpha := clamp(manager->get_day_alpha_target(), 0.0, 1.0);

        clock_cur_rotation = lerp_towards(clock_cur_rotation, target_rotation, CLOCK_ROTATION_LERP_STEP);
        clock_cur_alpha = lerp_towards(clock_cur_alpha, target_alpha, CLOCK_ALPHA_LERP_STEP);

        // Fallback baseline in case clock textures are not imported yet.
        if night == null || day == null || overlay == null {
            UI.quad(clock_rect, core_globals.white_sprite, {0.05, 0.05, 0.08, 0.85});
            return;
        }

        base_rect := clock_rect->inset(5)->fit_aspect(night->get_aspect());

        {
            UI.push_matrix(Matrix4.rotate_about_point(base_rect->center(), clock_cur_rotation));
            defer UI.pop_matrix();
            UI.quad(base_rect, night);
            UI.quad(base_rect, day, {1, 1, 1, clock_cur_alpha});
        }

        UI.quad(clock_rect->fit_aspect(overlay->get_aspect()), overlay);

        if moon != null {
            moon_draw_rect := moon_rect->fit_aspect(moon->get_aspect());
            UI.quad(moon_draw_rect, moon);

            ts := UI.default_text_settings();
            ts.size = 60;
            ts.halign = .CENTER;
            ts.valign = .CENTER;
            ts.color = {0.07, 0.07, 0.07, 1.0};
            ts.do_outline = true;
            ts.outline_thickness = 2;
            ts.outline_color = {1, 1, 1, 0.85};
            UI.text(moon_draw_rect, ts, "%", {manager->get_nights()});
        }

        if manager->should_draw_voyage_timer() {
            voyage_bar_rect := clock_rect->bottom_center_rect()->grow(10, 145, 10, 145)->offset(0, -55);
            voyage_fill_t := manager->get_voyage_progress_t();
            voyage_fill_rect := voyage_bar_rect->inset(3)->subrect(0.0, 0.0, voyage_fill_t, 1.0);

            UI.quad(voyage_bar_rect, core_globals.white_sprite, {0.05, 0.07, 0.10, 0.85});
            UI.quad(voyage_bar_rect->inset(1), core_globals.white_sprite, {0.16, 0.20, 0.28, 0.95});
            if voyage_fill_t > 0.0 {
                UI.quad(voyage_fill_rect, core_globals.white_sprite, {0.35, 0.80, 1.0, 1.0});
            }
        }

        if manager->should_draw_voyage_health_bar() {
            voyage_health_bar_rect := clock_rect->bottom_center_rect()->grow(12, 145, 12, 145)->offset(0, -90);
            voyage_health_fill_t := manager->get_voyage_health_fill_t();
            voyage_health_fill_rect := voyage_health_bar_rect->inset(3)->subrect(0.0, 0.0, voyage_health_fill_t, 1.0);
            voyage_health_text_rect := voyage_health_bar_rect->grow(18, 0, 18, 0);

            UI.quad(voyage_health_bar_rect, core_globals.white_sprite, {0.10, 0.04, 0.04, 0.90});
            UI.quad(voyage_health_bar_rect->inset(1), core_globals.white_sprite, {0.24, 0.08, 0.08, 0.95});
            if voyage_health_fill_t > 0.0 {
                UI.quad(voyage_health_fill_rect, core_globals.white_sprite, {0.95, 0.32, 0.24, 1.0});
            }

            voyage_health_ts := UI.default_text_settings();
            voyage_health_ts.size = 22;
            voyage_health_ts.halign = .CENTER;
            voyage_health_ts.valign = .CENTER;
            voyage_health_ts.color = {1, 1, 1, 1};
            voyage_health_ts.do_outline = true;
            voyage_health_ts.outline_thickness = 2;
            voyage_health_ts.outline_color = {0, 0, 0, 1};
            UI.text(voyage_health_text_rect, voyage_health_ts, "Voyage Health % / 300", {manager.VoyageHealth.(int)});
        }
    }

    // Port of the provided C# DrawArrowToPosition.
    // Draws a screen-space arrow pointing toward a world-space `position`.
    DrawArrowToPosition :: proc(using this: Player, position: v2) {
        if this == null return;
        if entity == null || entity.self == null return;

        // Screen-space overlay so it can't be occluded by world sprites.
        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        // Above almost everything else in the HUD.
        UI.push_layer(800);
        defer UI.pop_layer();

        safe := UI.get_safe_screen_rect();
        h := 1080.0;
        if h <= 0 {
            return;
        }
        aspect := 1920.0 / h;
        if aspect <= 0 {
            aspect = 1.0;
        }

        world_offset := position - entity.world_position;
        distance := length(world_offset);

        target_screen := world_to_screen(position + v2{0, 1.5});
        player_screen := world_to_screen(entity.world_position + v2{0, 1.5});

        delta_screen := target_screen - player_screen;
        dir := normalize(delta_screen);
        if length_squared(dir) < 0.00001 {
            dir = {1, 0};
        }

        arrow_size_px :: 40.0;
        anim := pow(abs(sin(PI * get_time())), 0.75);

        // distanceThreshold = ((dir * threshold) / (1, aspect)).Length
        distance_threshold_world :: 8.5;
        dvec := v2{dir.x * distance_threshold_world, dir.y * distance_threshold_world};
        scaled := v2{dvec.x, dvec.y / aspect};
        distance_threshold := length(scaled);

        #static arrow_tex := get_asset(Texture_Asset, "UI/Arrow.png");
        if arrow_tex == null {
            return;
        }

        if distance >= (distance_threshold + 0.5) {
            t := 1.0 - Ease.T(distance - distance_threshold, 1.0);
            t = clamp(t, 0.0, 1.0);

            arrow_screen := Rect{player_screen, player_screen}->offset_unscaled(dir.x * 300.0, dir.y * 300.0)->center();
            arrow_screen = lerp(arrow_screen, target_screen, t);

            rect := Rect{arrow_screen, arrow_screen}->grow(arrow_size_px);
            rotation := to_degrees(atan2(dir.y, dir.x));

            // Rotate around rect center via UI matrix.
            c := rect->center();
            UI.push_matrix(Matrix4.translate(v3{c.x, c.y, 0}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.rotate(rotation, v3{0, 0, 1}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.translate(v3{-c.x, -c.y, 0}));
            defer UI.pop_matrix();
            UI.quad(rect, arrow_tex, {1, 1, 1, 1});
        }
        else {
            rect := Rect{target_screen, target_screen}->grow(arrow_size_px);
            rect = rect->offset_unscaled(0, anim * 50.0);

            // Near target: fixed "down" arrow (270 degrees).
            c := rect->center();
            UI.push_matrix(Matrix4.translate(v3{c.x, c.y, 0}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.rotate(270, v3{0, 0, 1}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.translate(v3{-c.x, -c.y, 0}));
            defer UI.pop_matrix();
            UI.quad(rect, arrow_tex, {1, 1, 1, 1});
        }
    }

    draw_pre_night_beacon_arrow :: method() {
        manager := get_game_manager();
        if manager == null return;
        if !manager->is_night_warning_window_active() return;
        if manager.island1_spawn == null return;
        if entity == null return;

        to_spawn := manager.island1_spawn.world_position - entity.world_position;
        hide_dist_sq := PRE_NIGHT_BEACON_ARROW_HIDE_DISTANCE * PRE_NIGHT_BEACON_ARROW_HIDE_DISTANCE;
        if length_squared(to_spawn) <= hide_dist_sq return;

        DrawArrowToPosition(this, manager.island1_spawn.world_position);
    }

    draw_supply_drop_arrow :: method() {
        manager := get_game_manager();
        if manager == null return;
        if !manager->is_supply_drop_event_active() return;
        if entity == null return;

        target_pos, has_target := manager->get_supply_drop_arrow_target();
        if !has_target return;

        to_target := target_pos - entity.world_position;
        hide_dist_sq := SUPPLY_DROP_ARROW_HIDE_DISTANCE * SUPPLY_DROP_ARROW_HIDE_DISTANCE;
        if length_squared(to_target) <= hide_dist_sq return;

        DrawArrowToPosition(this, target_pos);
    }

    draw_lobby_waiting_text :: method() {
        manager := get_game_manager();
        if manager == null return;
        if manager->get_phase() != .LOBBY return;

        player_count := manager->get_player_count();
        required_players := manager->get_required_players_to_start();

        storm_rect := UI.get_safe_screen_rect()->bottom_center_rect()->grow(30, 450, 30, 450)->offset(0, 235);
        text_rect := UI.get_safe_screen_rect()->bottom_center_rect()->grow(35, 450, 35, 450)->offset(0, 180);
        ts := UI.default_text_settings();
        ts.size = 32;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.color = {1, 1, 1, 1};
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};

        UI.text(storm_rect, ts, "There's a storm coming...");
        ts.size = 36;
        UI.text(text_rect, ts, "Waiting for Players to Start: %/%", {player_count, required_players});
    }

    draw_round_start_intro :: method() {
        manager := get_game_manager();
        if manager == null return;

        overlay_alpha := max(
            manager->get_round_start_overlay_alpha(),
            max(manager->get_game_over_overlay_alpha(), manager->get_island_transition_overlay_alpha())
        );
        should_draw_text := manager->should_draw_round_start_text();
        should_draw_game_over_text := manager->should_draw_game_over_text();
        if overlay_alpha <= 0.0 && !should_draw_text && !should_draw_game_over_text return;

        UI.push_screen_draw_context();
        defer UI.pop_draw_context();
        UI.push_layer(5000);
        defer UI.pop_layer();

        if overlay_alpha > 0.0 {
            UI.quad(UI.get_screen_rect(), core_globals.white_sprite, {0, 0, 0, overlay_alpha});
        }

        if should_draw_text {
            text_rect := UI.get_safe_screen_rect()->center_rect()->grow(120, 550, 120, 550);
            night_text_rect := text_rect->offset(0, -120)->grow(0, -200, 0, -200);
            ts := UI.default_text_settings();
            ts.size = 96;
            ts.halign = .CENTER;
            ts.valign = .CENTER;
            ts.color = {1, 1, 1, 1};
            ts.do_outline = true;
            ts.outline_thickness = 3;
            ts.outline_color = {0, 0, 0, 1};
            UI.text(text_rect, ts, "Survive!");

            ts.size = 54;
            UI.text(night_text_rect, ts, "Night 1/99");
        }

        if should_draw_game_over_text {
            game_over_rect := UI.get_safe_screen_rect()->center_rect()->grow(140, 650, 140, 650)->offset(0, 40);
            nights_rect := game_over_rect->offset(0, -130)->grow(0, -120, 0, -120);

            title_ts := UI.default_text_settings();
            title_ts.size = 112;
            title_ts.halign = .CENTER;
            title_ts.valign = .CENTER;
            title_ts.color = {1.0, 0.25, 0.25, 1.0};
            title_ts.do_outline = true;
            title_ts.outline_thickness = 3;
            title_ts.outline_color = {0, 0, 0, 1};
            UI.text(game_over_rect, title_ts, "GAME OVER");

            detail_ts := UI.default_text_settings();
            detail_ts.size = 54;
            detail_ts.halign = .CENTER;
            detail_ts.valign = .CENTER;
            detail_ts.color = {1, 1, 1, 1};
            detail_ts.do_outline = true;
            detail_ts.outline_thickness = 2;
            detail_ts.outline_color = {0, 0, 0, 1};
            UI.text(nights_rect, detail_ts, "Nights Survived: %", {manager->get_game_over_nights_lasted()});
        }
    }

    handle_equipped_item_changing :: method(selected_index: s64) {
        // Ensure no-weapon state never leaves mouse IK active.
        if equipped_weapon_type == .NONE {
            this->set_mouse_ik_enabled(false);
        }

        // Resolve item from hotbar index
        selected_item: Item_Instance;
        if selected_index >= 0 && selected_index < default_inventory.capacity {
            selected_item = default_inventory->get_item(selected_index);
        }

        new_def: Item_Definition;
        if selected_item != null {
            new_def = selected_item->get_definition();
        }

        // Skip if nothing changed
        if selected_index == last_selected_index && new_def == equipped_item_def return;
        last_selected_index = selected_index;

        // Skip if same item definition
        if new_def == equipped_item_def return;

        // Unequip old weapon
        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;

        // Equip new weapon if it's a registered weapon
        if new_def != null {
            wt := get_weapon_type_for_item(new_def);
            if wt != .NONE {
                weapon_equip(this, wt);
                equipped_weapon_type = wt;
                equipped_item_def = new_def;
            }
        }
    }

}
