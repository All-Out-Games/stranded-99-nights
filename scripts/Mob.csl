MOB_DAMAGE_PULSE_DURATION_SECONDS :: 0.65;
MOB_DAMAGE_PULSE_OSCILLATIONS :: 7.0;
MOB_NIGHT_HEALTH_MULTIPLIER :: 2.0;
MOB_NIGHT_MOVE_SPEED_BONUS :: 50.0;
MOB_NIGHT_AGGRO_RADIUS_BONUS :: 10.0;
MOB_DEATH_DROP_CHANCE :: 0.75;
MOB_BOSS_MIN_KEEP_AWAY_DISTANCE :: 6.0;
MOB_BOSS_KEEP_AWAY_ATTACK_RANGE_MULTIPLIER :: 3.5;
MOB_BOSS_RETREAT_TRIGGER_RATIO :: 0.75;
MOB_BOSS_REPATH_DELAY_SECONDS :: 1.0;
MOB_BOSS_REPATH_TARGET_EPSILON_SQ :: 0.25;
MOB_BOSS_PATH_ARRIVAL_EPSILON_SQ :: 0.01;
MOB_KILLS_SAVE_KEY :: "mobs_killed";

MobTracking :: struct {
    increment_mob_kill_stat_by_player_id :: proc(player_entity_id: u64) {
        if player_entity_id == 0 return;
        if !Game.is_server() return;

        foreach player: component_iterator(Player) {
            if player == null continue;
            if player.entity == null continue;
            if player.entity.id != player_entity_id continue;

            current_value := Save.get_int(player, MOB_KILLS_SAVE_KEY, 0);
            Save.set_int(player, MOB_KILLS_SAVE_KEY, current_value + 1);
            return;
        }
    }
}

Mob :: class : Component {
    max_health: float @ao_serialize;
    move_speed: float @ao_serialize;
    attack_damage: float @ao_serialize;
    attack_speed: float @ao_serialize;
    attack_range: float @ao_serialize;
    acquire_range: float @ao_serialize;
    despawn_delay_seconds: float @ao_serialize;
    destination_spread_radius: float @ao_serialize;
    separation_radius: float @ao_serialize;
    separation_strength: float @ao_serialize;
    spine_animator: Spine_Animator @ao_serialize;
    idle_animation_name: string @ao_serialize;
    move_animation_name: string @ao_serialize;
    attack_animation_name: string @ao_serialize;
    attack_sfx_path: string @ao_serialize;
    attack_sfx_volume_scale: float @ao_serialize;
    death_animation_name: string @ao_serialize;
    death_drop_item_id: string @ao_serialize;
    Boss: bool @ao_serialize;
    NightAggro: s64 @ao_serialize;

    health: float;
    is_dead: bool;
    death_time_seconds: float;
    next_attack_time_seconds: float;
    target_player_id: u64;
    movement_agent: Movement_Agent;
    animation_state_machine: State_Machine;
    base_local_scale: v2;
    damage_pulse_elapsed_seconds: float;
    base_max_health: float;
    base_move_speed: float;
    base_acquire_range: float;
    night_stats_applied: bool;
    damage_aggro_target_player_id: u64;
    boss_is_provoked: bool;
    boss_next_repath_time_seconds: float;
    boss_last_repath_player_pos: v2;
    boss_last_path_destination: v2;
    boss_has_active_path_target: bool;
    attack_sfx_asset: SFX_Asset;

    ao_start :: method() {
        if max_health <= 0.0 { max_health = 100.0; }
        if move_speed <= 0.0 { move_speed = 3.0; }
        if attack_damage <= 0.0 { attack_damage = 10.0; }
        if attack_speed <= 0.0 { attack_speed = 1.0; }
        if attack_range <= 0.0 { attack_range = 1.2; }
        if acquire_range <= 0.0 { acquire_range = 100.0; }
        if despawn_delay_seconds < 0.0 { despawn_delay_seconds = 0.75; }
        if destination_spread_radius <= 0.0 {
            destination_spread_radius = max(attack_range * 0.75, 0.8);
        }
        if separation_radius <= 0.0 { separation_radius = 1.0; }
        if separation_strength <= 0.0 { separation_strength = 0.75; }
        if NightAggro < 0 { NightAggro = 0; }

        base_max_health = max_health;
        base_move_speed = move_speed;
        base_acquire_range = acquire_range;
        night_stats_applied = false;
        health = max_health;
        target_player_id = 0;
        damage_aggro_target_player_id = 0;
        boss_is_provoked = false;
        boss_next_repath_time_seconds = 0.0;
        boss_last_repath_player_pos = entity.world_position;
        boss_last_path_destination = entity.world_position;
        boss_has_active_path_target = false;
        damage_pulse_elapsed_seconds = MOB_DAMAGE_PULSE_DURATION_SECONDS;
        base_local_scale = entity.local_scale;
        if base_local_scale.x == 0.0 { base_local_scale.x = 1.0; }
        if base_local_scale.y == 0.0 { base_local_scale.y = 1.0; }

        movement_agent = entity->get_component(Movement_Agent);
        if movement_agent == null {
            movement_agent = entity->add_component(Movement_Agent);
        }

        if spine_animator == null {
            spine_animator = entity->get_component(Spine_Animator);
        }

        if idle_animation_name == "" { idle_animation_name = "idle"; }
        if move_animation_name == "" { move_animation_name = "move"; }
        if attack_animation_name == "" { attack_animation_name = "attack"; }
        if death_animation_name == "" { death_animation_name = "death"; }
        if attack_sfx_path.count > 0 {
            attack_sfx_asset = get_asset(SFX_Asset, attack_sfx_path);
        }

        setup_animation_state_machine();
        lock_to_game_navmesh();
        sync_night_stats();
        resolve_or_find_target_player();
    }

    ao_update :: method(dt: float) {
        update_is_moving_animation_state();
        update_damage_pulse(dt);

        //if !Game.is_server() return;

        if is_dead {
            update_is_moving_animation_state();
            if get_time() >= death_time_seconds + despawn_delay_seconds {
                entity->destroy();
            }
            return;
        }

        if movement_agent == null {
            movement_agent = entity->get_component(Movement_Agent);
            if movement_agent == null {
                movement_agent = entity->add_component(Movement_Agent);
            }
        }

        lock_to_game_navmesh();
        sync_night_stats();
        movement_agent.movement_speed = move_speed;

        ignore_beacon_safety := false;
        manager := get_game_manager();
        if manager != null {
            ignore_beacon_safety = manager->should_mobs_ignore_beacon_safety();
        }

        target: Player;
        attack_target_entity_id: u64;
        target_pos: v2;
        path_target_pos: v2;
        attack_distance_target_pos: v2;
        attacking_voyage_boat := false;

        if manager != null && manager->is_voyage_damage_redirect_active() {
            voyage_boat := resolve_voyage_boat_target();
            if voyage_boat == null {
                movement_agent.velocity = {0.0, 0.0};
                clear_boss_path_state();
                return;
            }

            voyage_target_entity := voyage_boat->resolve_attack_target_entity(entity.id);
            if voyage_target_entity != null {
                target_pos = voyage_target_entity.world_position;
                attack_target_entity_id = voyage_target_entity.id;
            } else {
                target_pos = voyage_boat->get_attack_position();
                attack_target_entity_id = voyage_boat.entity.id;
            }
            path_target_pos = get_path_target_position(target_pos);
            attack_distance_target_pos = target_pos;
            attacking_voyage_boat = true;
        } else {
            target = resolve_or_find_target_player();
            if target == null {
                clear_boss_path_state();
                return;
            }

            target_pos = target.entity.world_position;
            if !ignore_beacon_safety && BeaconSystem.is_position_inside_active_safety_zone(target_pos) {
                target_player_id = 0;
                damage_aggro_target_player_id = 0;
                clear_boss_path_state();
                return;
            }

            path_target_pos = get_path_target_position(target_pos);
            attack_distance_target_pos = target_pos;
            attack_target_entity_id = target.entity.id;
        }

        destination := get_spread_destination(path_target_pos, attack_target_entity_id);
        if attacking_voyage_boat {
            destination = path_target_pos;
        }
        self_pos := entity.world_position;
        if !ignore_beacon_safety {
            destination = BeaconSystem.clamp_position_outside_safety_zones(destination, self_pos);
        }
        destination = get_reachable_destination(destination, path_target_pos);
        to_target := v2{
            attack_distance_target_pos.x - self_pos.x,
            attack_distance_target_pos.y - self_pos.y
        };
        dist_sq := length_squared(to_target);
        attack_range_sq := attack_range * attack_range;
        if !attacking_voyage_boat && Boss && !this->is_boss_fully_aggro() {
            destination = get_boss_keep_away_destination(path_target_pos);
            if !ignore_beacon_safety {
                destination = BeaconSystem.clamp_position_outside_safety_zones(destination, self_pos);
            }
            destination = get_reachable_destination(destination, path_target_pos);

            now := get_time();
            if should_repath_boss_target(now, target_pos) {
                boss_last_repath_player_pos = target_pos;
                boss_last_path_destination = destination;
                boss_has_active_path_target = true;
                boss_next_repath_time_seconds = now + MOB_BOSS_REPATH_DELAY_SECONDS;
            }

            if length_squared(boss_last_path_destination - self_pos) <= MOB_BOSS_PATH_ARRIVAL_EPSILON_SQ {
                movement_agent.velocity = {0.0, 0.0};
                face_from_movement_direction(normalize_or_zero(to_target));
                return;
            }

            path_result := movement_agent->set_path_target(boss_last_path_destination, move_speed);
            if path_result.success {
                face_from_movement_direction(path_result.move_direction);
            } else {
                fallback_dir := v2{boss_last_path_destination.x - self_pos.x, boss_last_path_destination.y - self_pos.y};
                face_from_movement_direction(normalize_or_zero(fallback_dir));
            }
            return;
        }

        now := get_time();
        if dist_sq <= attack_range_sq {
            if now >= next_attack_time_seconds {
                if attacking_voyage_boat {
                    manager->apply_voyage_damage(manager->get_voyage_mob_damage());
                } else {
                    target->apply_mob_damage(attack_damage);
                }
                trigger_attack_animation();
                next_attack_time_seconds = now + attack_speed;
            }
            return;
        }

        path_result := movement_agent->set_path_target(destination, move_speed);
        if path_result.success {
            face_from_movement_direction(path_result.move_direction);
        } else {
            // Fallback while waiting for path result on the first frame.
            fallback_dir := v2{destination.x - self_pos.x, destination.y - self_pos.y};
            face_from_movement_direction(normalize_or_zero(fallback_dir));
        }
    }

    ao_late_update :: method(dt: float) {
        if Game.is_server() return;
        if !is_alive() return;

        material_player := resolve_material_player_for_ui();
        draw_mob_health_bar(this, material_player);
    }

    take_damage :: method(amount: float) -> bool {
        if is_dead return false;
        if amount <= 0.0 return false;

        health -= amount;
        if health < 0.0 {
            health = 0.0;
        }
        trigger_damage_feedback(amount);
        game_sfx_play(.DAMAGE_HIT, entity);

        if health <= 0.0 {
            killer_player_id := damage_aggro_target_player_id;
            is_dead = true;
            death_time_seconds = get_time();
            target_player_id = 0;
            damage_aggro_target_player_id = 0;
            MobTracking.increment_mob_kill_stat_by_player_id(killer_player_id);
            TutorialSystem.notify_mob_defeated_by_player_id(killer_player_id);
            try_spawn_death_drop();
            trigger_death_animation();
            game_sfx_play(.DEATH, entity);
            update_is_moving_animation_state();
            return true;
        }

        return false;
    }

    is_alive :: method() -> bool {
        return !is_dead && health > 0.0;
    }

    set_damage_aggro_target :: method(player_id: u64) {
        if player_id == 0 return;
        if is_dead return;

        boss_is_provoked = true;
        damage_aggro_target_player_id = player_id;
        target_player_id = player_id;
    }

    resolve_or_find_target_player :: method() -> Player {
        if Boss {
            return resolve_boss_target_player();
        }

        effective_acquire_range := get_effective_acquire_range();
        effective_acquire_range_sq := effective_acquire_range * effective_acquire_range;
        ignore_beacon_safety := should_ignore_beacon_safety();

        if damage_aggro_target_player_id != 0 {
            forced_target_id := damage_aggro_target_player_id;
            foreach p: component_iterator(Player) {
                if p.entity.id != forced_target_id continue;
                if !is_valid_target_player(p, ignore_beacon_safety) break;

                target_player_id = p.entity.id;
                return p;
            }

            if target_player_id == forced_target_id {
                target_player_id = 0;
            }
            damage_aggro_target_player_id = 0;
        }

        if target_player_id != 0 {
            foreach p: component_iterator(Player) {
                if p.entity.id != target_player_id continue;
                if !is_valid_target_player(p, ignore_beacon_safety) break;

                dist_sq := length_squared(p.entity.world_position - entity.world_position);
                if dist_sq <= effective_acquire_range_sq {
                    return p;
                }
                break;
            }
            target_player_id = 0;
        }

        closest: Player;
        closest_dist_sq := effective_acquire_range_sq;
        foreach p: component_iterator(Player) {
            if !is_valid_target_player(p, ignore_beacon_safety) continue;
            diff := p.entity.world_position - entity.world_position;
            dist_sq := length_squared(diff);
            if dist_sq <= closest_dist_sq {
                closest_dist_sq = dist_sq;
                closest = p;
            }
        }

        if closest != null {
            damage_aggro_target_player_id = 0;
            target_player_id = closest.entity.id;
            return closest;
        }

        return null;
    }

    resolve_voyage_boat_target :: method() -> VoyageBoat {
        closest: VoyageBoat;
        closest_dist_sq: float;
        found_closest := false;

        foreach boat: component_iterator(VoyageBoat) {
            if boat == null continue;
            if boat.entity == null continue;
            if !#alive(boat.entity) continue;

            dist_sq := length_squared(boat->get_attack_position() - entity.world_position);
            if !found_closest || dist_sq < closest_dist_sq {
                closest = boat;
                closest_dist_sq = dist_sq;
                found_closest = true;
            }
        }

        return closest;
    }

    get_effective_acquire_range :: method() -> float {
        return acquire_range;
    }

    clear_boss_path_state :: method() {
        boss_next_repath_time_seconds = 0.0;
        boss_has_active_path_target = false;
        boss_last_repath_player_pos = entity.world_position;
        boss_last_path_destination = entity.world_position;
    }

    should_repath_boss_target :: method(now: float, target_pos: v2) -> bool {
        if !boss_has_active_path_target return true;
        if now < boss_next_repath_time_seconds return false;
        return length_squared(target_pos - boss_last_repath_player_pos) > MOB_BOSS_REPATH_TARGET_EPSILON_SQ;
    }

    should_ignore_beacon_safety :: method() -> bool {
        manager := get_game_manager();
        if manager == null return false;
        return manager->should_mobs_ignore_beacon_safety();
    }

    should_path_to_closest_reachable_target_point :: method() -> bool {
        manager := get_game_manager();
        if manager == null return false;
        return manager->should_mobs_path_to_closest_reachable_target_point();
    }

    get_path_target_position :: method(target_pos: v2) -> v2 {
        if !should_path_to_closest_reachable_target_point() return target_pos;

        manager := get_game_manager();
        if manager == null return target_pos;

        navmesh := manager.player_navmesh;
        if navmesh == null return target_pos;

        hint_as_int: int = 0;
        snapped_pos: v2;
        if navmesh->try_find_closest_point_on_navmesh(target_pos, ref snapped_pos, ref hint_as_int) {
            return snapped_pos;
        }

        return target_pos;
    }

    get_reachable_destination :: method(desired_pos: v2, fallback_pos: v2) -> v2 {
        if !should_path_to_closest_reachable_target_point() return desired_pos;

        manager := get_game_manager();
        if manager == null return desired_pos;

        navmesh := manager.player_navmesh;
        if navmesh == null return desired_pos;

        hint_as_int: int = 0;
        snapped_pos: v2;
        if navmesh->try_find_closest_point_on_navmesh(desired_pos, ref snapped_pos, ref hint_as_int) {
            return snapped_pos;
        }

        if navmesh->try_find_closest_point_on_navmesh(fallback_pos, ref snapped_pos, ref hint_as_int) {
            return snapped_pos;
        }

        return desired_pos;
    }

    is_valid_target_player :: method(player: Player, ignore_beacon_safety: bool) -> bool {
        if player == null return false;
        if player.entity == null return false;
        if player.health <= 0.0 return false;
        if player->is_dead_for_night_state() return false;
        if !ignore_beacon_safety && BeaconSystem.is_position_inside_active_safety_zone(player.entity.world_position) {
            return false;
        }
        return true;
    }

    resolve_boss_target_player :: method() -> Player {
        ignore_beacon_safety := should_ignore_beacon_safety();
        closest: Player;
        closest_dist_sq: float;
        found_closest := false;

        foreach p: component_iterator(Player) {
            if !is_valid_target_player(p, ignore_beacon_safety) continue;

            dist_sq := length_squared(p.entity.world_position - entity.world_position);
            if !found_closest || dist_sq < closest_dist_sq {
                closest = p;
                closest_dist_sq = dist_sq;
                found_closest = true;
            }
        }

        if closest == null {
            target_player_id = 0;
            return null;
        }

        target_player_id = closest.entity.id;
        return closest;
    }

    is_boss_fully_aggro :: method() -> bool {
        if !Boss return true;
        if boss_is_provoked return true;

        manager := get_game_manager();
        if manager == null return false;
        if !manager->is_night_time() return false;

        current_night := manager->get_nights() + 1;
        return current_night >= NightAggro;
    }

    get_boss_keep_away_distance :: method() -> float {
        return max(MOB_BOSS_MIN_KEEP_AWAY_DISTANCE, max(attack_range * MOB_BOSS_KEEP_AWAY_ATTACK_RANGE_MULTIPLIER, destination_spread_radius + attack_range));
    }

    get_boss_keep_away_destination :: method(target_pos: v2) -> v2 {
        self_pos := entity.world_position;
        keep_away_distance := get_boss_keep_away_distance();
        to_self := self_pos - target_pos;
        radial_dir := normalize_or_zero(to_self);
        if length_squared(radial_dir) <= 0.0001 {
            radial_dir = v2{1.0, 0.0};
        }
        base_destination := target_pos + radial_dir * keep_away_distance;

        separation := get_mob_separation_vector();
        return v2{
            base_destination.x + separation.x,
            base_destination.y + separation.y
        };
    }

    sync_night_stats :: method() {
        manager := get_game_manager();
        is_night := false;
        is_raid_night := false;
        if manager != null {
            is_night = manager->is_night_time();
            is_raid_night = manager->is_raid_event_active();
        }

        if is_night {
            if !night_stats_applied {
                max_health = base_max_health * MOB_NIGHT_HEALTH_MULTIPLIER;
                health *= MOB_NIGHT_HEALTH_MULTIPLIER;
                move_speed = base_move_speed + MOB_NIGHT_MOVE_SPEED_BONUS;
                night_stats_applied = true;
            }

            acquire_range = base_acquire_range;
            if is_raid_night {
                acquire_range += MOB_NIGHT_AGGRO_RADIUS_BONUS;
            }
            return;
        }

        if !night_stats_applied return;

        max_health = base_max_health;
        move_speed = base_move_speed;
        acquire_range = base_acquire_range;
        if health > max_health {
            health = max_health;
        }
        night_stats_applied = false;
    }

    lock_to_game_navmesh :: method() {
        manager := get_game_manager();
        if manager == null return;
        if movement_agent == null return;
        movement_agent->set_navmesh_to_lock_to(manager.player_navmesh);
    }

    face_from_movement_direction :: method(dir: v2) {
        if abs(dir.x) <= 0.01 return;

        scale := entity.local_scale;
        abs_x := abs(base_local_scale.x);
        if abs_x <= 0.0 { abs_x = 1.0; }

        if dir.x > 0.0 {
            scale.x = abs_x;
        } else {
            scale.x = -abs_x;
        }
        scale.y = base_local_scale.y;
        entity->set_local_scale(scale);
    }

    get_spread_destination :: method(target_pos: v2, target_id: u64) -> v2 {
        slot_count := 12.0;
        slot_index := ((entity.id + target_id) % 12).(float);
        angle := (slot_index / slot_count) * 6.2831853;

        ring_jitter := ((entity.id % 5).(float) - 2.0) * 0.12;
        ring_dist := max(0.25, destination_spread_radius + ring_jitter);
        dir := v2{cos(angle), sin(angle)};
        base_destination := v2{target_pos.x + dir.x * ring_dist, target_pos.y + dir.y * ring_dist};

        separation := get_mob_separation_vector();
        return v2{
            base_destination.x + separation.x,
            base_destination.y + separation.y
        };
    }

    get_mob_separation_vector :: method() -> v2 {
        if separation_radius <= 0.0 || separation_strength <= 0.0 {
            return {0.0, 0.0};
        }

        self_pos := entity.world_position;
        nearby_mobs: [..]Mob;
        Scene.get_all_components_in_range(self_pos, separation_radius, ref nearby_mobs);

        push := v2{0.0, 0.0};
        for other: nearby_mobs {
            if other == null continue;
            if other == this continue;
            if !other->is_alive() continue;

            delta := v2{self_pos.x - other.entity.world_position.x, self_pos.y - other.entity.world_position.y};
            dist_sq := length_squared(delta);
            if dist_sq <= 0.0001 continue;

            dist := sqrt(dist_sq);
            if dist >= separation_radius continue;

            strength := (separation_radius - dist) / separation_radius;
            away := normalize_or_zero(delta);
            push.x += away.x * strength;
            push.y += away.y * strength;
        }

        return v2{push.x * separation_strength, push.y * separation_strength};
    }

    setup_animation_state_machine :: method() {
        if spine_animator == null return;

        spine_animator->awaken();
        if spine_animator.instance == null return;

        animation_state_machine = State_Machine.create();

        moving_var := animation_state_machine->create_variable("mob_is_moving", .BOOL);
        attack_var := animation_state_machine->create_variable("mob_attack", .TRIGGER);
        death_var := animation_state_machine->create_variable("mob_death", .TRIGGER);

        layer := animation_state_machine->create_layer("main", 0);
        idle_state := layer->create_state(idle_animation_name, true);
        move_state := layer->create_state(move_animation_name, true);
        attack_state := layer->create_state(attack_animation_name, false);
        death_state := layer->create_state(death_animation_name, false);
        layer->set_initial_state(idle_state);

        idle_to_move := layer->create_transition(idle_state, move_state, false);
        idle_to_move->create_bool_condition(moving_var, true);

        move_to_idle := layer->create_transition(move_state, idle_state, false);
        move_to_idle->create_bool_condition(moving_var, false);

        any_to_attack := layer->create_global_transition(attack_state, true);
        any_to_attack->create_trigger_condition(attack_var);

        attack_to_move := layer->create_transition(attack_state, move_state, true);
        attack_to_move->create_bool_condition(moving_var, true);

        attack_to_idle := layer->create_transition(attack_state, idle_state, true);
        attack_to_idle->create_bool_condition(moving_var, false);

        any_to_death := layer->create_global_transition(death_state, false);
        any_to_death->create_trigger_condition(death_var);

        spine_animator.instance->set_state_machine(animation_state_machine, true);
    }

    update_is_moving_animation_state :: method() {
        if animation_state_machine == null return;
        if is_dead {
            animation_state_machine->set_bool("mob_is_moving", false);
            return;
        }

        if movement_agent == null {
            animation_state_machine->set_bool("mob_is_moving", false);
            return;
        }

        moving := length_squared(movement_agent.velocity) > 0.01;
        animation_state_machine->set_bool("mob_is_moving", moving);
    }

    trigger_attack_animation :: method() {
        if animation_state_machine == null return;
        if is_dead return;
        animation_state_machine->set_trigger("mob_attack");
        play_attack_sfx();
    }

    play_attack_sfx :: method() {
        if attack_sfx_asset != null {
            volume_scale := attack_sfx_volume_scale;
            if volume_scale <= 0.0 {
                volume_scale = 1.0;
            }

            desc := SFX.default_sfx_desc();
            desc.channel = .SFX;
            desc.entity_to_follow = entity.id;
            desc.volume = clamp(game_sfx_default_volume_for_event(.MOB_ATTACK) * volume_scale, 0.0, 1.0);
            SFX.play(attack_sfx_asset, desc);
            return;
        }

        game_sfx_play(.MOB_ATTACK, entity);
    }

    trigger_death_animation :: method() {
        if animation_state_machine == null return;
        animation_state_machine->set_trigger("mob_death");
    }

    resolve_material_player_for_ui :: method() -> Player {
        local_player: Player;
        fallback_player: Player;
        foreach p: component_iterator(Player) {
            if fallback_player == null {
                fallback_player = p;
            }
            if p->is_local() {
                local_player = p;
                break;
            }
        }

        if local_player != null return local_player;
        return fallback_player;
    }

    try_spawn_death_drop :: method() {
        if !Game.is_server() return;
        if death_drop_item_id.count <= 0 return;

        defn := ItemManager.TryFindItem(death_drop_item_id);
        if defn == null return;

        rng := rng_root_seed();
        roll := rng_range_float(ref rng, 0.0, 1.0);
        if roll > MOB_DEATH_DROP_CHANCE return;

        ItemDrops.spawn_from_definition(entity.world_position, defn, 1);
    }

    trigger_damage_feedback :: method(amount: float) {
        damage_pulse_elapsed_seconds = 0.0;

        if !Game.is_server() return;

        manager := get_game_manager();
        if manager == null return;

        damage_text: string;
        whole_damage := amount.(int);
        whole_damage_as_float := whole_damage.(float);
        if abs(amount - whole_damage_as_float) <= 0.01 {
            damage_text = format_string("%", {whole_damage});
        } else {
            damage_text = format_string("%", {format_float(amount, decimals=1)});
        }

        dn := new(DamageNumbers);
        dn.Text = damage_text;
        dn.Position = entity.world_position + v2{0, 1.85};
        dn.LastPosition = dn.Position;
        dn.Color = {1.0, 0.2, 0.2, 1.0};
        dn.T = 0.0;
        dn.SpaceText = false;
        dn.DoingFading = true;

        ts := UI.default_text_settings();
        ts.size = 0.30;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        ts.color = {1, 1, 1, 1};
        dn.TextSettings = ts;

        manager.damage_numbers->append(dn);
    }

    update_damage_pulse :: method(dt: float) {
        if spine_animator == null return;
        if spine_animator.instance == null return;

        if damage_pulse_elapsed_seconds >= MOB_DAMAGE_PULSE_DURATION_SECONDS {
            spine_animator.instance.color_multiplier = {1, 1, 1, 1};
            return;
        }

        damage_pulse_elapsed_seconds += dt;
        if damage_pulse_elapsed_seconds >= MOB_DAMAGE_PULSE_DURATION_SECONDS {
            spine_animator.instance.color_multiplier = {1, 1, 1, 1};
            return;
        }

        t := clamp(damage_pulse_elapsed_seconds / MOB_DAMAGE_PULSE_DURATION_SECONDS, 0.0, 1.0);
        phase := t * MOB_DAMAGE_PULSE_OSCILLATIONS * 6.2831853;
        white_mix := 0.5 + 0.5 * sin(phase - 1.5707963);
        white_mix = clamp(white_mix, 0.0, 1.0);
        spine_animator.instance.color_multiplier = {1.0, white_mix, white_mix, 1.0};
    }
}

mob_apply_damage :: proc(mob: Mob, damage: float) -> bool {
    if mob == null return false;
    return mob->take_damage(damage);
}

mob_apply_damage_from_player :: proc(mob: Mob, damage: float, attacker_player_id: u64) -> bool {
    if mob == null return false;
    mob->set_damage_aggro_target(attacker_player_id);
    return mob->take_damage(damage);
}

mob_damage_all_in_range :: proc(pos: v2, range: float, damage: float) -> s64 {
    if !Game.is_server() return 0;

    nearby: [..]Mob;
    Scene.get_all_components_in_range(pos, range, ref nearby);
    hit_count: s64 = 0;
    for mob: nearby {
        if mob == null continue;
        if !mob->is_alive() continue;
        mob->take_damage(damage);
        hit_count += 1;
    }
    return hit_count;
}

mob_damage_all_in_range_from_player :: proc(pos: v2, range: float, damage: float, attacker_player_id: u64) -> s64 {
    if !Game.is_server() return 0;

    nearby: [..]Mob;
    Scene.get_all_components_in_range(pos, range, ref nearby);
    hit_count: s64 = 0;
    for mob: nearby {
        if mob == null continue;
        if !mob->is_alive() continue;
        mob_apply_damage_from_player(mob, damage, attacker_player_id);
        hit_count += 1;
    }
    return hit_count;
}

mob_damage_closest_in_range :: proc(pos: v2, range: float, damage: float) -> Mob, bool {
    if !Game.is_server() return null, false;

    mob, found := Scene.get_closest_component_in_range(pos, range, Mob);
    if !found || mob == null return null, false;
    if !mob->is_alive() return null, false;

    mob->take_damage(damage);
    return mob, true;
}

mob_damage_closest_in_range_from_player :: proc(pos: v2, range: float, damage: float, attacker_player_id: u64) -> Mob, bool {
    if !Game.is_server() return null, false;

    mob, found := Scene.get_closest_component_in_range(pos, range, Mob);
    if !found || mob == null return null, false;
    if !mob->is_alive() return null, false;

    mob_apply_damage_from_player(mob, damage, attacker_player_id);
    return mob, true;
}
