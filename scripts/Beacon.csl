import "core:ao"

Beacon_Upgrade_Cost :: struct {
    item_id: string;
    count: s64;
}

Beacon_Stockpile_Entry :: struct {
    item_id: string;
    count: s64;
}

Beacon :: class : Interactable {
    fog2: Entity @ao_serialize;
    fog3: Entity @ao_serialize;
    fog4: Entity @ao_serialize;
    fog5: Entity @ao_serialize;
    fog6: Entity @ao_serialize;
    safety_zone_visual: Entity @ao_serialize;
    los_caster: LOS_Caster @ao_serialize;
    spine_animator: Spine_Animator @ao_serialize;
    level: s64;
    fuel: s64 @ao_serialize;
    fuel_burn_interval_seconds: float @ao_serialize;
    stockpile: [..]Beacon_Stockpile_Entry;
    fuel_next_burn_time_seconds: float;
    current_fuel_animation_name: string;
    upgrade_feedback_sequence: s64;
    seen_upgrade_feedback_sequence: s64;

    MAX_LEVEL :: 6;
    FOG4_DISABLE_LEVEL :: 4;
    FOG5_DISABLE_LEVEL :: 5;
    FOG6_DISABLE_LEVEL :: 6;
    DEFAULT_STARTING_FUEL :: 3;
    DEFAULT_FUEL_BURN_INTERVAL_SECONDS :: 15.0;
    MAX_FUEL_ANIMATION_BUCKET :: 5;
    UPGRADE_NOTIFICATION_TEXT :: "Beacon upgraded! The Map has Expanded!";

    ao_start :: method() {
        this->set_listener(this);

        if radius <= 0.0 {
            radius = 2.0;
        }

        if level <= 0 {
            level = 1;
        }
        level = clamp(level, 1, MAX_LEVEL).(s64);

        if fuel_burn_interval_seconds <= 0.0 {
            fuel_burn_interval_seconds = DEFAULT_FUEL_BURN_INTERVAL_SECONDS;
        }
        if fuel < 0 {
            fuel = 0;
        }
        if fuel == 0 {
            fuel = DEFAULT_STARTING_FUEL;
        }
        fuel_next_burn_time_seconds = 0.0;
        if fuel > 0 {
            fuel_next_burn_time_seconds = get_time() + fuel_burn_interval_seconds;
        }

        this->set_hold_text("Accessing...");
        stockpile->clear();
        sync_to_beacon_spawn();
        apply_level_world_state();
        apply_fuel_animation_state();
        apply_dynamic_safety_radius_state();
        seen_upgrade_feedback_sequence = upgrade_feedback_sequence;
        refresh_prompt_text();
    }

    can_use :: method(player: Player) -> bool {
        return player != null;
    }

    on_interact :: method(player: Player) {
        if player == null return;

        player->close_all_non_log_ui_modals();
        player.beacon_ui_open = true;
        player.active_beacon = this;
        game_sfx_play(.UI_CLICK, player.entity);
    }

    ao_update :: method(dt: float) {
        sync_to_beacon_spawn();

        if Game.is_server() {
            tick_fuel_consumption();
            apply_dynamic_safety_radius_state();
        }
        apply_fuel_animation_state();
        flush_upgrade_feedback();
    }

    sync_to_beacon_spawn :: method() {
        manager := get_game_manager();
        if manager != null {
            spawn_pos, found_spawn := manager->get_loaded_island_beacon_spawn_position();
            if found_spawn {
                entity->set_local_position(spawn_pos);
                return;
            }
        }

        foreach beacon_spawn: component_iterator(BeaconSpawn) {
            if beacon_spawn == null continue;
            if beacon_spawn.entity == null continue;

            entity->set_local_position(beacon_spawn.entity.world_position);
            return;
        }
    }

    ao_late_update :: method(dt: float) {
        if Game.is_server() return;
        draw_world_fuel_meter();
    }

    refresh_prompt_text :: method() {
        if level >= MAX_LEVEL {
            this->set_text("Beacon Maxed");
            return;
        }
        this->set_text("Upgrade Beacon");
    }

    apply_level_world_state :: method() {
        if fog2 != null {
            fog2->set_local_enabled(level < 2);
        }
        if fog3 != null {
            fog3->set_local_enabled(level < 3);
        }
        if fog4 != null {
            fog4->set_local_enabled(level < FOG4_DISABLE_LEVEL);
        }
        if fog5 != null {
            fog5->set_local_enabled(level < FOG5_DISABLE_LEVEL);
        }
        if fog6 != null {
            fog6->set_local_enabled(level < FOG6_DISABLE_LEVEL);
        }
        apply_safety_zone_visual_scale();
    }

    get_safety_radius :: method() -> float {
        return BeaconSystem.get_safety_radius_for_level(level);
    }

    get_remaining_fuel_seconds :: method() -> float {
        if fuel <= 0 return 0.0;
        if fuel_burn_interval_seconds <= 0.0 return 0.0;

        remaining := get_seconds_until_next_fuel_burn();
        whole_fuel_after_current := max(fuel - 1, 0);
        return whole_fuel_after_current.(float) * fuel_burn_interval_seconds + remaining;
    }

    get_safety_radius_fuel_t :: method() -> float {
        baseline_total_seconds := DEFAULT_STARTING_FUEL.(float) * fuel_burn_interval_seconds;
        if baseline_total_seconds <= 0.0 return 0.0;

        remaining_seconds := get_remaining_fuel_seconds();
        return clamp(remaining_seconds / baseline_total_seconds, 0.0, 1.0);
    }

    get_current_safety_radius :: method() -> float {
        if !has_active_fuel() return 0.0;
        return get_safety_radius() * get_safety_radius_fuel_t();
    }

    has_active_fuel :: method() -> bool {
        return fuel > 0;
    }

    get_seconds_until_next_fuel_burn :: method() -> float {
        if fuel <= 0 return 0.0;
        if fuel_burn_interval_seconds <= 0.0 return 0.0;
        if fuel_next_burn_time_seconds <= 0.0 return fuel_burn_interval_seconds;

        remaining := fuel_next_burn_time_seconds - get_time();
        return clamp(remaining, 0.0, fuel_burn_interval_seconds);
    }

    get_fuel_progress_t :: method() -> float {
        if fuel <= 0 return 0.0;
        if fuel_burn_interval_seconds <= 0.0 return 0.0;

        remaining := get_seconds_until_next_fuel_burn();
        return clamp(remaining / fuel_burn_interval_seconds, 0.0, 1.0);
    }

    add_fuel :: method(amount: s64) {
        if amount <= 0 return;
        if fuel_burn_interval_seconds <= 0.0 {
            fuel_burn_interval_seconds = DEFAULT_FUEL_BURN_INTERVAL_SECONDS;
        }

        fuel_was_empty := fuel <= 0;
        fuel += amount;
        if fuel < 0 {
            fuel = 0;
        }

        if fuel_was_empty && fuel > 0 {
            fuel_next_burn_time_seconds = get_time() + fuel_burn_interval_seconds;
        }

        apply_fuel_animation_state();
        apply_dynamic_safety_radius_state();
    }

    set_fuel_for_round :: method(amount: s64) {
        if fuel_burn_interval_seconds <= 0.0 {
            fuel_burn_interval_seconds = DEFAULT_FUEL_BURN_INTERVAL_SECONDS;
        }

        fuel = max(amount, 0);
        if fuel > 0 {
            fuel_next_burn_time_seconds = get_time() + fuel_burn_interval_seconds;
        } else {
            fuel_next_burn_time_seconds = 0.0;
        }

        apply_fuel_animation_state();
        apply_dynamic_safety_radius_state();
    }

    set_beacon_level :: method(new_level: s64) {
        next_level := clamp(new_level, 1, MAX_LEVEL).(s64);
        if level == next_level return;

        level = next_level;
        apply_level_world_state();
        apply_dynamic_safety_radius_state();
        refresh_prompt_text();
        rebuild_game_navmesh();
    }

    tick_fuel_consumption :: method() {
        if fuel <= 0 {
            fuel = 0;
            fuel_next_burn_time_seconds = 0.0;
            return;
        }
        if fuel_burn_interval_seconds <= 0.0 {
            fuel_burn_interval_seconds = DEFAULT_FUEL_BURN_INTERVAL_SECONDS;
        }
        if fuel_next_burn_time_seconds <= 0.0 {
            fuel_next_burn_time_seconds = get_time() + fuel_burn_interval_seconds;
            return;
        }

        now := get_time();
        while fuel > 0 && now >= fuel_next_burn_time_seconds {
            fuel -= 1;
            fuel_next_burn_time_seconds += fuel_burn_interval_seconds;
        }

        if fuel <= 0 {
            fuel = 0;
            fuel_next_burn_time_seconds = 0.0;
        }
    }

    get_fuel_animation_name :: method() -> string {
        if fuel <= 0 {
            return "off";
        }
        fuel_bucket := clamp(fuel, 1, MAX_FUEL_ANIMATION_BUCKET).(s64);
        return format_string("%", {fuel_bucket});
    }

    apply_fuel_animation_state :: method() {
        if spine_animator == null {
            spine_animator = entity->get_component(Spine_Animator);
        }
        if spine_animator == null return;

        spine_animator->awaken();
        if spine_animator.instance == null return;

        next_animation := get_fuel_animation_name();
        if current_fuel_animation_name == next_animation return;

        spine_animator.instance->set_animation(next_animation, true, 0);
        current_fuel_animation_name = next_animation;
    }

    draw_world_fuel_meter :: method() {
        if entity == null return;

        meter_center := entity.world_position + v2{0.0, 1.8};
        meter_rect := Rect{meter_center, meter_center}->grow(0.05, 0.8, 0.05, 0.8);

        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        UI.push_z(meter_center.y);
        defer UI.pop_z();

        UI.quad(meter_rect, core_globals.white_sprite, {0.0, 0.0, 0.0, 0.8});

        meter_fill := meter_rect->inset(0.01);
        fill_t := get_fuel_progress_t();
        fill_color := v4{1.0, 0.6, 0.15, 0.95};
        if fuel <= 0 {
            fill_t = 0.0;
            fill_color = {0.3, 0.3, 0.3, 0.9};
        }
        UI.quad(meter_fill->subrect(0, 0, fill_t, 1), core_globals.white_sprite, fill_color);

        text_rect := meter_rect->center_rect()->grow(0.16, 0.52, 0.16, 0.52)->offset(0.0, 0.22);
        text_ts := UI.default_text_settings();
        text_ts.size = 0.24;
        text_ts.halign = .CENTER;
        text_ts.valign = .CENTER;
        text_ts.do_outline = true;
        text_ts.outline_color = {0, 0, 0, 1};
        text_ts.outline_thickness = 2;
        text_ts.color = {1, 0.95, 0.85, 1};
        if fuel <= 0 {
            text_ts.color = {1.0, 0.45, 0.45, 1.0};
        }
        UI.text(text_rect, text_ts, "Fuel: %", {fuel});
    }

    apply_safety_zone_visual_scale :: method() {
        if safety_zone_visual == null return;

        safety_radius := get_current_safety_radius();
        safety_zone_visual->set_local_scale({safety_radius, safety_radius});
    }

    apply_dynamic_safety_radius_state :: method() {
        safety_radius := get_current_safety_radius();
        apply_safety_zone_visual_scale();

        if los_caster != null {
            los_caster.radii = {safety_radius, safety_radius + 2.0};
        }
    }

    rebuild_game_navmesh :: method() {
        manager := ensure_game_manager_exists();
        if manager == null return;
        if manager.player_navmesh == null return;

        ok := manager.player_navmesh->rebuild_immediately();
        if !ok {
            manager.player_navmesh->mark_for_rebuild();
        }
    }

    flush_upgrade_feedback :: method() {
        if seen_upgrade_feedback_sequence == upgrade_feedback_sequence return;

        seen_upgrade_feedback_sequence = upgrade_feedback_sequence;

        manager := get_game_manager();
        if manager != null {
            manager->show_broadcast_notification(UPGRADE_NOTIFICATION_TEXT);
        }

        sent_to_any_player := false;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;

            if p->is_local_or_server() {
                sent_to_any_player = true;
            }
        }

        if sent_to_any_player {
            game_sfx_play(.BEACON_UPGRADE);
        }
    }

    get_upgrade_costs :: method() -> [..]Beacon_Upgrade_Cost {
        #static level2_costs: [..]Beacon_Upgrade_Cost;
        #static level3_costs: [..]Beacon_Upgrade_Cost;
        #static level4_costs: [..]Beacon_Upgrade_Cost;
        #static level5_costs: [..]Beacon_Upgrade_Cost;
        #static level6_costs: [..]Beacon_Upgrade_Cost;
        #static initted: bool;

        if !initted {
            initted = true;
            level2_costs->append(Beacon_Upgrade_Cost{"wood", 30});
            level2_costs->append(Beacon_Upgrade_Cost{"scrap", 15});

            level3_costs->append(Beacon_Upgrade_Cost{"wood", 50});
            level3_costs->append(Beacon_Upgrade_Cost{"scrap", 30});
            level3_costs->append(Beacon_Upgrade_Cost{"fiber", 20});

            level4_costs->append(Beacon_Upgrade_Cost{"scrap", 50});
            level4_costs->append(Beacon_Upgrade_Cost{"fiber", 50});
            level4_costs->append(Beacon_Upgrade_Cost{"sulfur", 15});

            level5_costs->append(Beacon_Upgrade_Cost{"scrap", 75});
            level5_costs->append(Beacon_Upgrade_Cost{"sulfur", 20});
            level5_costs->append(Beacon_Upgrade_Cost{"fish", 25});

            level6_costs->append(Beacon_Upgrade_Cost{"scrap", 100});
            level6_costs->append(Beacon_Upgrade_Cost{"sulfur", 30});
            level6_costs->append(Beacon_Upgrade_Cost{"fish", 40});
        }

        if level == 1 return level2_costs;
        if level == 2 return level3_costs;
        if level == 3 return level4_costs;
        if level == 4 return level5_costs;
        if level == 5 return level6_costs;

        empty: [..]Beacon_Upgrade_Cost;
        return empty;
    }

    get_stockpile_count :: method(item_id: string) -> s64 {
        for entry: stockpile {
            if entry.item_id == item_id {
                return entry.count;
            }
        }
        return 0;
    }

    add_stockpile_item :: method(item_id: string, amount: s64) {
        if amount <= 0 return;

        i: s64 = 0;
        while i < stockpile.count {
            entry := stockpile[i];
            if entry.item_id == item_id {
                entry.count += amount;
                stockpile[i] = entry;
                return;
            }
            i += 1;
        }

        stockpile->append({item_id, amount});
    }

    clear_stockpile :: method() {
        stockpile->clear();
    }
}

BeaconSystem :: struct {
    get_safety_radius_for_level :: proc(level: s64) -> float {
        switch level {
            case 1: return 7.0;
            case 2: return 9.0;
            case 3: return 11.0;
            case 4: return 13.0;
            case 5: return 15.0;
            case 6: return 17.0;
        }
        return 17.0;
    }

    clamp_position_outside_safety_zones :: proc(position: v2, fallback_reference: v2) -> v2 {
        adjusted := position;
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.entity == null continue;
            if !beacon->has_active_fuel() continue;

            safety_radius := beacon->get_current_safety_radius();
            padded_radius := safety_radius + 0.25;
            if padded_radius <= 0.0 continue;

            beacon_pos := beacon.entity.world_position;
            delta := adjusted - beacon_pos;
            dist_sq := length_squared(delta);
            padded_radius_sq := padded_radius * padded_radius;
            if dist_sq >= padded_radius_sq continue;

            if dist_sq <= 0.0001 {
                delta = fallback_reference - beacon_pos;
                if length_squared(delta) <= 0.0001 {
                    delta = {1.0, 0.0};
                }
            }

            dir := normalize(delta);
            adjusted = beacon_pos + dir * padded_radius;
        }
        return adjusted;
    }

    is_position_inside_active_safety_zone :: proc(position: v2) -> bool {
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.entity == null continue;
            if !beacon->has_active_fuel() continue;

            safety_radius := beacon->get_current_safety_radius();
            if safety_radius <= 0.0 continue;

            delta := position - beacon.entity.world_position;
            if length_squared(delta) <= safety_radius * safety_radius {
                return true;
            }
        }
        return false;
    }

    get_item_count_in_inventory :: proc(inventory: Inventory, defn: Item_Definition) -> s64 {
        if inventory == null return 0;
        if defn == null return 0;

        total: s64 = 0;
        i: s64 = 0;
        while i < inventory.capacity {
            item := inventory->get_item(i);
            if item != null && item->get_definition() == defn {
                total += item.quantity;
            }
            i += 1;
        }
        return total;
    }

    has_stockpile_materials_for_upgrade :: proc(beacon: Beacon) -> bool {
        if beacon == null return false;
        if beacon.level >= Beacon.MAX_LEVEL return false;
        costs := beacon->get_upgrade_costs();
        for cost: costs {
            stockpiled := beacon->get_stockpile_count(cost.item_id);
            if stockpiled < cost.count return false;
        }
        return true;
    }

    try_auto_upgrade :: proc(beacon: Beacon) -> bool {
        //if !Game.is_server() return false;
        if beacon == null return false;
        if beacon.level >= Beacon.MAX_LEVEL return false;

        if !BeaconSystem.has_stockpile_materials_for_upgrade(beacon) {
            return false;
        }

        beacon.level += 1;
        beacon->clear_stockpile();
        beacon->apply_level_world_state();
        beacon->refresh_prompt_text();
        beacon.upgrade_feedback_sequence += 1;

        if beacon.level == 2 {
            beacon->rebuild_game_navmesh();
            return true;
        }
        if beacon.level == 3 {
            beacon->rebuild_game_navmesh();
            return true;
        }
        return true;
    }

    try_deposit_item :: proc(player: Player, beacon: Beacon, item_id: string) -> bool {
        //if !Game.is_server() return false;
        if player == null return false;
        if beacon == null return false;
        if beacon.level >= Beacon.MAX_LEVEL {
            //Notifier.notify(player, "Beacon is already max level.");
            return false;
        }
        if player.default_inventory == null || player.default_inventory.self == null || player.default_inventory.capacity <= 0 {
            //Notifier.notify(player, "Inventory is unavailable.");
            return false;
        }

        costs := beacon->get_upgrade_costs();
        found_cost: Beacon_Upgrade_Cost;
        has_cost := false;
        for cost: costs {
            if cost.item_id == item_id {
                found_cost = cost;
                has_cost = true;
                break;
            }
        }

        if !has_cost {
            //Notifier.notify(player, "That resource is not needed right now.");
            return false;
        }

        already := beacon->get_stockpile_count(item_id);
        if already >= found_cost.count {
            //Notifier.notify(player, "That requirement is already filled.");
            return false;
        }

        defn := ItemManager.TryFindItem(item_id);
        if defn == null {
            //Notifier.notify(player, "Unknown item: %", {item_id});
            return false;
        }

        ok := CraftingSystem.consume_item_from_inventory(player.default_inventory, defn, 1);
        if !ok {
           // Notifier.notify(player, "You need 1 % to deposit.", {defn->get_name()});
            return false;
        }

        beacon->add_stockpile_item(item_id, 1);
        now_count := beacon->get_stockpile_count(item_id);
        //Notifier.notify(player, "Deposited 1 % (%/%).", {defn->get_name(), now_count, found_cost.count});
        _ := BeaconSystem.try_auto_upgrade(beacon);
        return true;
    }

    try_add_fuel :: proc(player: Player, beacon: Beacon) -> bool {
        if !Game.is_server() return false;
        if player == null return false;
        if beacon == null return false;
        if player.default_inventory == null || player.default_inventory.self == null || player.default_inventory.capacity <= 0 {
            //Notifier.notify(player, "Inventory is unavailable.");
            return false;
        }

        wood := ItemManager.TryFindItem("wood");
        if wood == null {
            //Notifier.notify(player, "Wood item is unavailable.");
            return false;
        }

        ok := CraftingSystem.consume_item_from_inventory(player.default_inventory, wood, 1);
        if !ok {
            //Notifier.notify(player, "You need 1 Wood to add Beacon fuel.");
            return false;
        }

        beacon->add_fuel(1);
        //Notifier.notify(player, "Added 1 Wood to Beacon fuel. Fuel: %", {beacon.fuel});
        return true;
    }

    close_modal :: proc(player: Player) {
        if player == null return;
        player.beacon_ui_open = false;
        player.active_beacon = null;
    }

    draw_ui :: proc(player: Player) {
        if player == null return;
        if !player.beacon_ui_open return;

        beacon := player.active_beacon;
        if beacon == null {
            BeaconSystem.close_modal(player);
            return;
        }

        ts := UI.default_text_settings();
        ts.do_outline = true;
        ts.outline_color = {0, 0, 0, 1};
        ts.outline_thickness = 2;

        bs := UI.default_button_settings();
        bs.press_scaling = 0.35;

        UI.push_layer(1000);
        defer UI.pop_layer();

        UI.quad(UI.get_screen_rect(), core_globals.white_sprite, {0, 0, 0, 0.6});

        panel_rect := UI.get_safe_screen_rect()->center_rect()->grow(330, 560, 330, 560);
        UI.quad(panel_rect, core_globals.white_sprite, {0.05, 0.06, 0.08, 0.95});
        UI.quad(panel_rect->inset(5), core_globals.white_sprite, {0.12, 0.13, 0.18, 0.95});

        content := panel_rect->inset(20);
        header := content->cut_top(70);
        body := content;

        title_ts := ts;
        title_ts.size = 52;
        title_ts.halign = .LEFT;
        title_ts.valign = .CENTER;
        UI.text(header, title_ts, "Beacon Level %", {beacon.level});

        body_bg := body->inset(4);
        UI.quad(body_bg, core_globals.white_sprite, {0.08, 0.09, 0.12, 0.8});

        section_ts := ts;
        section_ts.size = 34;
        section_ts.halign = .LEFT;
        section_ts.offset.x = 8;

        info_rect := body_bg->cut_top(82)->inset(4, 8, 8, 8);
        info_ts := ts;
        info_ts.size = 28;
        info_ts.halign = .LEFT;
        info_ts.valign = .TOP;
        info_ts.word_wrap = true;
        UI.text(
            info_rect,
            info_ts,
            "Upgrading your beacon clears the island's Dark Fog and increases your safety zone!"
        );

        wood_defn := ItemManager.TryFindItem("wood");
        wood_have: s64 = 0;
        if wood_defn != null {
            wood_have = BeaconSystem.get_item_count_in_inventory(player.default_inventory, wood_defn);
        }

        fuel_button_rect := body_bg->cut_top(44)->inset(2, 8, 2, 8);
        fuel_button_bs := bs;
        fuel_button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png");
        if wood_have <= 0 {
            fuel_button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
        }
        fuel_button_ts := ts;
        fuel_button_ts.size = 26;
        fuel_button_ts.halign = .CENTER;
        fuel_button_ts.valign = .CENTER;
        UI.push_disabled(wood_have <= 0 || wood_defn == null);
        if UI.button(
            fuel_button_rect,
            fuel_button_bs,
            fuel_button_ts,
            format_string("Add Fuel (1 Wood) - You: %", {wood_have})
        ).clicked {
            if BeaconSystem.try_add_fuel(player, beacon) {
                game_sfx_play(.CRAFT_SUCCESS, player.entity);
            } else {
                game_sfx_play(.UI_ERROR, player.entity);
            }
        }
        UI.pop_disabled();

        fuel_line := body_bg->cut_top(44)->inset(2, 8, 2, 8);
        fuel_ts := ts;
        fuel_ts.size = 30;
        fuel_ts.halign = .LEFT;
        fuel_ts.valign = .CENTER;
        fuel_ts.color = {1.0, 0.87, 0.65, 1.0};
        if beacon.fuel <= 0 {
            fuel_ts.color = {1.0, 0.45, 0.45, 1.0};
        }
        UI.text(fuel_line, fuel_ts, "Fuel: %", {beacon.fuel});

        timer_bg := body_bg->cut_top(34)->inset(4, 10, 4, 10);
        UI.quad(timer_bg, core_globals.white_sprite, {0.12, 0.12, 0.12, 0.95});

        timer_fill := timer_bg->inset(3);
        fill_t := beacon->get_fuel_progress_t();
        fill_color := v4{1.0, 0.6, 0.15, 0.95};
        if beacon.fuel <= 0 {
            fill_t = 0.0;
            fill_color = {0.3, 0.3, 0.3, 0.85};
        }
        UI.quad(timer_fill->subrect(0, 0, fill_t, 1), core_globals.white_sprite, fill_color);

        timer_text_ts := ts;
        timer_text_ts.size = 22;
        timer_text_ts.halign = .CENTER;
        timer_text_ts.valign = .CENTER;
        if beacon.fuel > 0 {
            remaining_seconds := beacon->get_seconds_until_next_fuel_burn();
            UI.text(timer_bg, timer_text_ts, "Next fuel burn: %", {format_float(remaining_seconds, decimals=1)});
        } else {
            UI.text(timer_bg, timer_text_ts, "Out of fuel - safety radius inactive");
        }

        req_title := body_bg->cut_top(44);
        if beacon.level >= Beacon.MAX_LEVEL {
            UI.text(req_title, section_ts, "Status");

            status_rect := body_bg->cut_top(64)->inset(2, 2, 2, 8);
            status_ts := ts;
            status_ts.size = 30;
            status_ts.halign = .LEFT;
            status_ts.valign = .CENTER;
            status_ts.color = {0.65, 1, 0.65, 1};
            UI.text(status_rect, status_ts, "Beacon is at max level.");
        }
        else {
            UI.text(req_title, section_ts, "Upgrade Cost");

            costs := beacon->get_upgrade_costs();
            for cost: costs {
                line := body_bg->cut_top(70)->inset(2, 2, 2, 8);
                defn := ItemManager.TryFindItem(cost.item_id);
                stockpiled := beacon->get_stockpile_count(cost.item_id);
                have: s64 = 0;
                display_name := cost.item_id;
                icon: Texture_Asset;

                if defn != null {
                    display_name = defn->get_name();
                    have = BeaconSystem.get_item_count_in_inventory(player.default_inventory, defn);
                    icon = defn->get_icon();
                }

                line_ts := ts;
                line_ts.size = 28;
                line_ts.halign = .LEFT;
                line_ts.valign = .CENTER;
                line_ts.color = {1, 0.5, 0.5, 1};
                if stockpiled >= cost.count {
                    line_ts.color = {0.65, 1, 0.65, 1};
                }

                deposit_button_rect := line->cut_right(270)->inset(4, 4, 4, 12);
                text_rect := line->inset(0, 8, 0, 0);
                if icon != null {
                    icon_rect := text_rect->cut_left(40)->fit_aspect(icon->get_aspect());
                    UI.quad(icon_rect, icon);
                    text_rect->cut_left(8);
                }
                UI.text(text_rect, line_ts, "% Stockpile: %/% (You: %)", {display_name, stockpiled, cost.count, have});

                button_bs := bs;
                button_ts := ts;
                button_ts.size = 25;
                button_ts.halign = .CENTER;
                button_ts.valign = .CENTER;

                requirement_met := stockpiled >= cost.count;
                can_deposit := have > 0 && !requirement_met;
                button_label := format_string("Deposit 1 %", {display_name});
                if requirement_met {
                    button_label = "MAX";
                    button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png");
                }
                else if have <= 0 {
                    button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
                }
                else {
                    button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png");
                }
                UI.push_id("beacon_deposit_%", {cost.item_id});
                UI.push_disabled(!can_deposit);
                if UI.button(deposit_button_rect, button_bs, button_ts, button_label).clicked {
                    if BeaconSystem.try_deposit_item(player, beacon, cost.item_id) {
                        game_sfx_play(.CRAFT_SUCCESS, player.entity);
                    } else {
                        game_sfx_play(.UI_ERROR, player.entity);
                    }
                }
                UI.pop_disabled();
                UI.pop_id();
            }
        }

        action_row := body_bg->bottom_center_rect()->grow(36, 180, 36, 180)->offset(0, 46);
        close_rect := action_row;

        close_ts := ts;
        close_ts.size = 30;
        close_ts.halign = .CENTER;

        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
        if UI.button(close_rect, bs, close_ts, "Close").clicked {
            game_sfx_play(.UI_CLICK, player.entity);
            BeaconSystem.close_modal(player);
            return;
        }
    }
}
