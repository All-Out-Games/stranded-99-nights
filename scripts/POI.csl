POI :: class : Component {
    prefab_paths: [..]string @ao_serialize;
    log_spawn_warnings: bool @ao_serialize;
    clear_previous_spawn_on_round_start: bool @ao_serialize;

    rng: u64;
    spawned_entity: Entity;
    missing_prefab_list_warning_logged: bool;

    ao_start :: method() {
        rng = rng_seed(entity.id);
        missing_prefab_list_warning_logged = false;
    }

    ao_end :: method() {
        if !Game.is_server() return;
        destroy_spawned_entity();
    }

    spawn_for_round :: method() -> bool {
        if !Game.is_server() return false;

        if clear_previous_spawn_on_round_start {
            destroy_spawned_entity();
        }

        prefab_path := get_random_prefab_path();
        if prefab_path == "" {
            if log_spawn_warnings && !missing_prefab_list_warning_logged {
                missing_prefab_list_warning_logged = true;
                log_info("POI % has no prefab paths configured.", {entity.id});
            }
            return false;
        }
        missing_prefab_list_warning_logged = false;

        prefab := get_asset(Prefab_Asset, prefab_path);
        if prefab == null {
            if log_spawn_warnings {
                log_info("POI % failed to load prefab '%'.", {entity.id, prefab_path});
            }
            return false;
        }

        spawned := Scene.instantiate(prefab);
        if spawned == null {
            if log_spawn_warnings {
                log_info("POI % failed to instantiate prefab '%'.", {entity.id, prefab_path});
            }
            return false;
        }

        spawned->set_local_position(entity.world_position);
        spawned_entity = spawned;
        return true;
    }

    get_random_prefab_path :: method() -> string {
        if prefab_paths.count <= 0 {
            return "";
        }

        if prefab_paths.count == 1 {
            return prefab_paths[0];
        }

        max_index := prefab_paths.count - 1;
        random_index := rng_range_int(ref rng, 0, max_index);
        return prefab_paths[random_index];
    }

    destroy_spawned_entity :: method() {
        if spawned_entity == null return;
        if #alive(spawned_entity) {
            spawned_entity->destroy();
        }
        spawned_entity = null;
    }
}
