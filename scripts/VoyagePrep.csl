import "core:ao"

FINAL_VOYAGE_STORMCORE_REQUIRED :: 5;

VoyagePrep_Requirement :: struct {
    item_id: string;
    count: s64;
}

VoyagePrep_Stockpile_Entry :: struct {
    item_id: string;
    count: s64;
}

VoyagePrep_Deposit_Button :: struct {
    item_id: string;
    handle: UIK.Interact_Handle;
    can_deposit: bool;
}

VoyagePrep :: class : Interactable {
    stockpile: [..]VoyagePrep_Stockpile_Entry;
    ready_player_user_ids: [..]string;
    completion_feedback_sent: bool;
    next_ready_player_trim_time_seconds: float;

    COMPLETION_NOTIFICATION_TEXT :: "Voyage Preperation Complete! Queue up to take a Voyage!";
    READY_PLAYER_TRIM_INTERVAL_SECONDS :: 0.5;

    ao_start :: method() {
        this.set_listener(this);

        if radius <= 0.0 {
            radius = 2.0;
        }

        this.set_hold_text("Preparing...");
        next_ready_player_trim_time_seconds = 0.0;
        reset_for_round();
    }

    ao_update :: method(dt: float) {
        if get_time() < next_ready_player_trim_time_seconds return;
        next_ready_player_trim_time_seconds = get_time() + READY_PLAYER_TRIM_INTERVAL_SECONDS;
        trim_ready_player_user_ids();
    }

    can_use :: method(player: Player) -> bool {
        if player == null return false;
        return !player.crafting_ui_open && !player.beacon_ui_open && !player.voyage_prep_ui_open;
    }

    on_interact :: method(player: Player) {
        if player == null return;

        player.close_all_non_log_ui_modals();
        player.voyage_prep_ui_open = true;
        player.active_voyage_prep = this;
        game_sfx_play(.UI_CLICK, player.entity);
    }

    reset_for_round :: method() {
        stockpile.clear();
        ready_player_user_ids.clear();
        completion_feedback_sent = false;
        next_ready_player_trim_time_seconds = 0.0;
        refresh_prompt_text();
    }

    refresh_prompt_text :: method() {
        if is_complete() {
            this.set_text("Queue Voyage");
            return;
        }
        this.set_text("Prepare Voyage");
    }

    get_requirements :: method() -> [..]VoyagePrep_Requirement {
        #static island1_requirements: [..]VoyagePrep_Requirement;
        #static island2_requirements: [..]VoyagePrep_Requirement;
        #static island3_requirements: [..]VoyagePrep_Requirement;
        #static island4_requirements: [..]VoyagePrep_Requirement;
        #static initted: bool;

        if !initted {
            initted = true;
            island1_requirements.append({"scrap", 10});
            island1_requirements.append({"root.resin", 3});
            island1_requirements.append({"fish", 10});

            island2_requirements.append({"scrap", 15});
            island2_requirements.append({"ice.shard", 5});
            island2_requirements.append({"bandage", 5});

            island3_requirements.append({"sulfur", 20});
            island3_requirements.append({"medkit", 5});
            island3_requirements.append({"obsidian.shard", 5});

            island4_requirements.append({"scrap", 30});
            island4_requirements.append({"fish", 15});
            island4_requirements.append({"stormcore", FINAL_VOYAGE_STORMCORE_REQUIRED});
        }

        manager := get_game_manager();
        if manager != null && manager.Island == 1 {
            return island1_requirements;
        }
        if manager != null && manager.Island == 2 {
            return island2_requirements;
        }
        if manager != null && manager.Island == 3 {
            return island3_requirements;
        }
        if manager != null && manager.Island == 4 {
            return island4_requirements;
        }

        empty: [..]VoyagePrep_Requirement;
        return empty;
    }

    get_stockpile_count :: method(item_id: string) -> s64 {
        for entry: stockpile {
            if entry.item_id == item_id {
                return entry.count;
            }
        }
        return 0;
    }

    add_stockpile_item :: method(item_id: string, amount: s64) {
        if amount <= 0 return;

        i: s64 = 0;
        while i < stockpile.count {
            entry := stockpile[i];
            if entry.item_id == item_id {
                entry.count += amount;
                stockpile[i] = entry;
                return;
            }
            i += 1;
        }

        stockpile.append({item_id, amount});
    }

    is_complete :: method() -> bool {
        requirements := get_requirements();
        if requirements.count <= 0 return false;

        for requirement: requirements {
            if get_stockpile_count(requirement.item_id) < requirement.count {
                return false;
            }
        }
        return true;
    }

    handle_completion_if_needed :: method() {
        if completion_feedback_sent return;
        if !is_complete() return;

        completion_feedback_sent = true;
        refresh_prompt_text();

        manager := get_game_manager();
        if manager != null && Game.is_server() {
            manager.show_broadcast_notification(COMPLETION_NOTIFICATION_TEXT);
        }
    }

    has_ready_player_user_id :: method(user_id: string) -> bool {
        if user_id.count <= 0 return false;

        for ready_user_id: ready_player_user_ids {
            if ready_user_id == user_id {
                return true;
            }
        }
        return false;
    }

    is_player_ready :: method(player: Player) -> bool {
        if player == null return false;
        return has_ready_player_user_id(player.get_user_id());
    }

    set_player_ready :: method(player: Player) {
        if player == null return;

        user_id := player.get_user_id();
        if user_id.count <= 0 return;
        if has_ready_player_user_id(user_id) return;

        ready_player_user_ids.append(user_id);
    }

    unset_player_ready :: method(player: Player) {
        if player == null return;

        user_id := player.get_user_id();
        if user_id.count <= 0 return;

        i: s64 = 0;
        while i < ready_player_user_ids.count {
            if ready_player_user_ids[i] == user_id {
                ready_player_user_ids.ordered_remove_by_index(i);
                return;
            }
            i += 1;
        }
    }

    clear_ready_players :: method() {
        ready_player_user_ids.clear();
    }

    has_current_player_user_id :: method(user_id: string) -> bool {
        if user_id.count <= 0 return false;

        for player: component_iterator(Player) {
            if player == null continue;
            if player.get_user_id() == user_id {
                return true;
            }
        }
        return false;
    }

    trim_ready_player_user_ids :: method() {
        i: s64 = 0;
        while i < ready_player_user_ids.count {
            user_id := ready_player_user_ids[i];
            if has_current_player_user_id(user_id) {
                i += 1;
                continue;
            }

            ready_player_user_ids.ordered_remove_by_index(i);
        }
    }

    get_current_player_count :: method() -> s64 {
        count: s64 = 0;
        for player: component_iterator(Player) {
            if player == null continue;
            count += 1;
        }
        return count;
    }

    get_ready_player_count :: method() -> s64 {
        ready_count: s64 = 0;
        for player: component_iterator(Player) {
            if player == null continue;
            if is_player_ready(player) {
                ready_count += 1;
            }
        }
        return ready_count;
    }

    are_all_players_ready :: method() -> bool {
        if !is_complete() return false;

        player_count := get_current_player_count();
        if player_count <= 0 return false;

        return get_ready_player_count() >= player_count;
    }
}

VoyagePrepSystem :: struct {
    try_deposit_item :: proc(player: Player, prep: VoyagePrep, item_id: string) -> bool {
        if player == null return false;
        if prep == null return false;
        if prep.is_complete() return false;
        if !#alive(player.default_inventory) || player.default_inventory.capacity <= 0 {
            return false;
        }

        requirements := prep.get_requirements();
        found_requirement: VoyagePrep_Requirement;
        has_requirement := false;
        for requirement: requirements {
            if requirement.item_id == item_id {
                found_requirement = requirement;
                has_requirement = true;
                break;
            }
        }

        if !has_requirement {
            return false;
        }

        already_stockpiled := prep.get_stockpile_count(item_id);
        if already_stockpiled >= found_requirement.count {
            return false;
        }

        defn := ItemManager.TryFindItem(item_id);
        if defn == null {
            return false;
        }

        ok := CraftingSystem.consume_item_from_inventory(player.default_inventory, defn, 1);
        if !ok {
            return false;
        }

        prep.add_stockpile_item(item_id, 1);
        prep.handle_completion_if_needed();
        return true;
    }

    try_ready_player :: proc(player: Player, prep: VoyagePrep) -> bool {
        if player == null return false;
        if prep == null return false;
        if !prep.is_complete() return false;

        prep.set_player_ready(player);
        if prep.are_all_players_ready() {
            if VoyagePrepSystem.try_start_voyage(prep) {
                return true;
            }
            prep.unset_player_ready(player);
            return false;
        }
        return true;
    }

    try_start_voyage :: proc(prep: VoyagePrep) -> bool {
        if prep == null return false;

        manager := get_game_manager();
        if manager == null return false;
        if !prep.are_all_players_ready() return false;
        if !manager.try_start_next_island_voyage() return false;

        prep.clear_ready_players();
        VoyagePrepSystem.close_modal_for_component(prep);
        return true;
    }

    close_modal :: proc(player: Player) {
        if player == null return;
        player.voyage_prep_ui_open = false;
        player.active_voyage_prep = null;
    }

    close_modal_for_component :: proc(prep: VoyagePrep) {
        for player: component_iterator(Player) {
            if player == null continue;
            if player.active_voyage_prep != prep continue;
            VoyagePrepSystem.close_modal(player);
        }
    }

    draw_ui :: proc(player: Player) {
        if player == null return;
        if !player.voyage_prep_ui_open return;

        prep := player.active_voyage_prep;
        if prep == null || prep.entity == null || !prep.entity.get_local_enabled() {
            VoyagePrepSystem.close_modal(player);
            return;
        }

        requirements := prep.get_requirements();
        ready_count := prep.get_ready_player_count();
        player_count := prep.get_current_player_count();

        ready_text := format_string("Crew Ready: %/%", {ready_count, player_count});
        status_text := "Fill every supply category before the crew can ready up.";
        status_tint := v4{1.0, 0.88, 0.7, 1.0};
        if prep.is_complete() {
            status_text = "Voyage prep complete. Queue up with the crew to launch.";
            status_tint = v4{0.65, 1.0, 0.65, 1.0};
        }

        modal_rect := UI.get_safe_screen_rect().center_rect().grow(414, 690, 414, 690);
        close_header_handle: UIK.Interact_Handle;
        close_button_handle: UIK.Interact_Handle;
        ready_button_handle: UIK.Interact_Handle;
        deposit_buttons: [..]VoyagePrep_Deposit_Button;
        deposit_buttons.reserve(requirements.count);

        UIK.begin(UIK.modal(modal_rect, 1000, v4{0, 0, 0, 0.65}));

        shell := UIK.panel_modal(.BLACK);
        shell.padding = v4{0, 0, 0, 0};
        shell.gap = 0;
        UIK.panel_begin(shell);

        close_header_handle = UIK.title_area(UIK.title_area_desc("Voyage Prep"));

        content := UIK.layout_column();
        content.width = UIK.flex(1);
        content.height = UIK.flex(1);
        content.padding = v4{12, 16, 12, 16};
        content.gap = 16;
        UIK.list_begin(format_string("voyage_prep_scroll_%", {player.get_user_id()}), content);

        info_panel := UIK.panel_styled(.MODAL_TRANSP_BLACK);
        info_panel.width = UIK.flex(1);
        info_panel.height = UIK.fit();
        info_panel.padding = v4{10, 14, 10, 14};
        UIK.panel_begin(info_panel);
        info_text := UIK.text_body();
        UIK.text_set_halign(&info_text, .LEFT);
        UIK.text("Bring together the resources needed to launch the next voyage.", info_text);
        UIK.panel_end();

        UIK.spacer(UIK.pixels(1), UIK.pixels(20));

        crew_panel := UIK.panel_interior(.INSET);
        crew_panel.width = UIK.flex(1);
        crew_panel.height = UIK.fit();
        crew_panel.padding = v4{12, 12, 12, 12};
        crew_panel.gap = 8;
        UIK.panel_begin(crew_panel);

        crew_title := UIK.text_title();
        UIK.text_set_halign(&crew_title, .LEFT);
        UIK.text("Crew Status", crew_title);

        crew_body := UIK.text_body();
        UIK.text_set_halign(&crew_body, .LEFT);
        UIK.text_set_color(&crew_body, v4{0.82, 0.9, 1.0, 1.0});
        UIK.text(ready_text, crew_body);
        UIK.panel_end();

        UIK.spacer(UIK.pixels(1), UIK.pixels(20));

        supplies_panel := UIK.panel_interior(.INSET);
        supplies_panel.width = UIK.flex(1);
        supplies_panel.height = UIK.fit();
        supplies_panel.padding = v4{12, 12, 12, 12};
        supplies_panel.gap = 8;
        UIK.panel_begin(supplies_panel);

        supplies_title := UIK.text_title();
        UIK.text_set_halign(&supplies_title, .LEFT);
        UIK.text("Required Supplies", supplies_title);

        supplies_body := UIK.text_body();
        UIK.text_set_halign(&supplies_body, .LEFT);
        UIK.text("Deposit the listed resources to finish voyage prep.", supplies_body);

        if requirements.count <= 0 {
            unavailable_text := UIK.text_body();
            UIK.text_set_halign(&unavailable_text, .LEFT);
            UIK.text_set_color(&unavailable_text, v4{1.0, 0.55, 0.55, 1.0});
            UIK.text("No voyage prep requirements are configured here yet.", unavailable_text);
        }

        for requirement: requirements {
            defn := ItemManager.TryFindItem(requirement.item_id);
            stockpiled := prep.get_stockpile_count(requirement.item_id);
            have: s64 = 0;
            display_name := requirement.item_id;
            icon: Texture_Asset;

            if defn != null {
                display_name = defn.get_name();
                have = BeaconSystem.get_item_count_in_inventory(player.default_inventory, defn);
                icon = defn.get_icon();
            }

            requirement_met := stockpiled >= requirement.count;
            can_deposit := have > 0 && !requirement_met;

            entry := UIK.panel_styled(.MODAL_TRANSP_BLACK);
            entry.width = UIK.flex(1);
            entry.height = UIK.fit();
            entry.gap = 10;
            entry.padding = v4{10, 10, 10, 20};
            entry.cross_align = .CENTER;
            UIK.panel_begin(entry);

            if icon != null {
                icon_box := UIK.layout_column();
                icon_box.width = UIK.pixels(48);
                icon_box.height = UIK.pixels(48);
                icon_box.cross_align = .CENTER;
                icon_box.main_align = .CENTER;
                icon_box.show_background = false;
                UIK.panel_begin(icon_box);
                UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
                UIK.panel_end();
            }

            text_panel := UIK.layout_column();
            text_panel.width = UIK.flex(1);
            text_panel.height = UIK.fit();
            text_panel.gap = 2;
            text_panel.show_background = false;
            UIK.panel_begin(text_panel);

            item_name := UIK.text_button();
            UIK.text_set_halign(&item_name, .LEFT);
            UIK.text(display_name, item_name);

            item_status := UIK.text_body();
            UIK.text_set_halign(&item_status, .LEFT);
            if requirement_met {
                UIK.text_set_color(&item_status, v4{0.65, 1.0, 0.65, 1.0});
            } else {
                UIK.text_set_color(&item_status, v4{1.0, 0.7, 0.55, 1.0});
            }
            UIK.text(
                format_string("Stockpile %/%  |  You: %", {stockpiled, requirement.count, have}),
                item_status
            );
            UIK.panel_end();

            deposit_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_BLUE);
            deposit_desc.panel.width = UIK.pixels(220);
            deposit_desc.panel.height = UIK.pixels(68);
            button_label := format_string("Deposit 1 %", {display_name});
            if requirement_met {
                deposit_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
                deposit_desc.panel.width = UIK.pixels(220);
                deposit_desc.panel.height = UIK.pixels(68);
                deposit_desc.disabled = true;
                button_label = "Filled";
            } else if !can_deposit {
                deposit_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
                deposit_desc.panel.width = UIK.pixels(220);
                deposit_desc.panel.height = UIK.pixels(68);
                deposit_desc.disabled = true;
            }

            deposit_handle := UIK.button(format_string("voyage_prep_deposit_%", {requirement.item_id}), button_label, deposit_desc);
            deposit_buttons.append(VoyagePrep_Deposit_Button{requirement.item_id, deposit_handle, can_deposit});
            UIK.panel_end();
        }
        UIK.panel_end();

        UIK.spacer(UIK.pixels(1), UIK.pixels(20));

        status_panel := UIK.panel_interior(.INSET);
        status_panel.width = UIK.flex(1);
        status_panel.height = UIK.fit();
        status_panel.padding = v4{12, 12, 12, 12};
        status_panel.gap = 8;
        UIK.panel_begin(status_panel);

        status_title := UIK.text_title();
        UIK.text_set_halign(&status_title, .LEFT);
        UIK.text("Voyage Status", status_title);

        status_body := UIK.text_body();
        UIK.text_set_halign(&status_body, .LEFT);
        UIK.text_set_color(&status_body, status_tint);
        UIK.text(status_text, status_body);
        UIK.panel_end();

        UIK.list_end();

        action_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 10);
        action_row.padding = v4{12, 0, 12, 12};
        action_row.show_background = false;
        UIK.panel_begin(action_row);

        close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
        close_desc.panel.width = UIK.flex(1);
        close_desc.panel.height = UIK.pixels(82);
        close_button_handle = UIK.button("voyage_prep_close", "Close", close_desc);

        ready_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
        ready_desc.panel.width = UIK.flex(1);
        ready_desc.panel.height = UIK.pixels(82);
        button_label := "Ready?";
        already_ready := prep.is_player_ready(player);
        can_ready := prep.is_complete() && !already_ready;
        if already_ready {
            ready_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_BLUE);
            ready_desc.panel.width = UIK.flex(1);
            ready_desc.panel.height = UIK.pixels(82);
            ready_desc.disabled = true;
            button_label = "Ready!";
        } else if !prep.is_complete() {
            ready_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
            ready_desc.panel.width = UIK.flex(1);
            ready_desc.panel.height = UIK.pixels(82);
            ready_desc.disabled = true;
        }
        ready_button_handle = UIK.button("voyage_prep_ready", button_label, ready_desc);

        UIK.panel_end();
        UIK.panel_end();
        UIK.end();

        if UIK.clicked(close_header_handle) || UIK.clicked(close_button_handle) {
            game_sfx_play(.UI_CLICK, player.entity);
            VoyagePrepSystem.close_modal(player);
            return;
        }

        for deposit_button: deposit_buttons {
            if !deposit_button.can_deposit continue;
            if !UIK.clicked(deposit_button.handle) continue;

            if VoyagePrepSystem.try_deposit_item(player, prep, deposit_button.item_id) {
                game_sfx_play(.CRAFT_SUCCESS, player.entity);
            } else {
                game_sfx_play(.UI_ERROR, player.entity);
            }
        }

        if can_ready && UIK.clicked(ready_button_handle) {
            if VoyagePrepSystem.try_ready_player(player, prep) {
                game_sfx_play(.CRAFT_SUCCESS, player.entity);
            } else {
                game_sfx_play(.UI_ERROR, player.entity);
            }
        }
    }
}
