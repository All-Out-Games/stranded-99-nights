Merchant_Shop_Offer :: struct {
    item_id: string;
    moon_cost: s64;
    stack_count: s64;
}

Merchant :: class : Interactable {
    prompt_text: string @ao_serialize;

    ao_start :: method() {
        this->set_listener(this);

        if radius <= 0.0 {
            radius = 2.0;
        }

        if prompt_text.count <= 0 {
            prompt_text = "Moon Merchant";
        }

        this->set_text(prompt_text);
        this->set_hold_text("Browsing wares...");
    }

    can_use :: method(player: Player) -> bool {
        return player != null;
    }

    on_interact :: method(player: Player) {
        if player == null return;

        player->close_all_ui_modals();
        player.merchant_ui_open = true;
        player.active_merchant = this;
        game_sfx_play(.UI_CLICK, player.entity);
    }
}

MerchantSystem :: struct {
    resolve_item_def :: proc(item_id: string) -> Item_Definition {
        defn := ItemManager.TryFindItem(item_id);
        if defn != null return defn;

        return try_find_reusable_weapon_item_def_by_id(item_id);
    }

    get_shop_offers :: proc() -> [..]Merchant_Shop_Offer {
        #static initted: bool;
        #static offers: [..]Merchant_Shop_Offer;

        if !initted {
            initted = true;
            // Starter stock. Tweak these entries freely as the merchant balance evolves.
            offers->append({"bandage", 1, 3});
            offers->append({"medkit", 2, 1});
            offers->append({"smg", 3, 1});
            offers->append({"energy_ammo", 3, 50});
            offers->append({"obsidian_sword", 15, 1});
            offers->append({"scythe", 25, 1});
        }

        return offers;
    }

    close_modal :: proc(player: Player) {
        if player == null return;
        player.merchant_ui_open = false;
        player.active_merchant = null;
    }

    has_inventory_room_for_offer :: proc(player: Player, offer: Merchant_Shop_Offer) -> bool {
        if player == null return false;
        if player.default_inventory == null return false;
        if player.default_inventory.self == null return false;
        if player.default_inventory.capacity <= 0 return false;
        if offer.stack_count <= 0 return false;

        defn := MerchantSystem.resolve_item_def(offer.item_id);
        if defn == null return false;

        room := Items.calculate_room_in_inventory_for_item(defn, player.default_inventory);
        return room >= offer.stack_count;
    }

    can_buy_offer :: proc(player: Player, offer: Merchant_Shop_Offer) -> bool {
        if player == null return false;
        if offer.moon_cost < 0 return false;

        if !MerchantSystem.has_inventory_room_for_offer(player, offer) return false;

        balance := Economy.get_balance(player, MOON_CURRENCY);
        return balance >= offer.moon_cost;
    }

    try_buy_offer :: proc(player: Player, offer: Merchant_Shop_Offer) -> bool {
        if player == null return false;
        if !Game.is_server() return false;

        defn := MerchantSystem.resolve_item_def(offer.item_id);
        if defn == null {
            Notifier.notify(player, "That item is not configured correctly.");
            return false;
        }

        if offer.stack_count <= 0 {
            Notifier.notify(player, "That offer has no items configured.");
            return false;
        }

        if !MerchantSystem.has_inventory_room_for_offer(player, offer) {
            Notifier.notify(player, "You do not have enough room for that purchase.");
            return false;
        }

        if !Economy.can_withdraw_currency(player, MOON_CURRENCY, offer.moon_cost) {
            Notifier.notify(player, "You need more Moons.");
            return false;
        }

        purchased_item := Items.create_item_instance(defn, offer.stack_count);
        if purchased_item == null {
            Notifier.notify(player, "That purchase failed.");
            return false;
        }

        Economy.withdraw_currency(player, MOON_CURRENCY, offer.moon_cost);
        Items.move_item_to_inventory(purchased_item, player.default_inventory);
        return true;
    }

    draw_ui :: proc(player: Player) {
        if player == null return;
        if !player.merchant_ui_open return;

        merchant := player.active_merchant;
        if merchant == null || merchant.entity == null {
            MerchantSystem.close_modal(player);
            return;
        }
        if !#alive(merchant.entity) {
            MerchantSystem.close_modal(player);
            return;
        }

        offers := MerchantSystem.get_shop_offers();

        ts := UI.default_text_settings();
        ts.do_outline = true;
        ts.outline_color = {0, 0, 0, 1};
        ts.outline_thickness = 2;

        bs := UI.default_button_settings();
        bs.press_scaling = 0.35;

        UI.push_layer(1000);
        defer UI.pop_layer();

        UI.quad(UI.get_screen_rect(), core_globals.white_sprite, {0, 0, 0, 0.6});

        panel_rect := UI.get_safe_screen_rect()->center_rect()->grow(360, 620, 360, 620);
        UI.quad(panel_rect, core_globals.white_sprite, {0.07, 0.08, 0.12, 0.97});
        UI.quad(panel_rect->inset(5), core_globals.white_sprite, {0.13, 0.14, 0.19, 0.97});

        content := panel_rect->inset(20);
        header := content->cut_top(70);
        balance_bar := content->cut_top(54)->inset(0, 0, 10, 0);
        info_rect := content->cut_top(70)->inset(0, 0, 8, 0);
        body_bg := content;

        title_ts := ts;
        title_ts.size = 52;
        title_ts.halign = .LEFT;
        title_ts.valign = .CENTER;
        UI.text(header, title_ts, "Moon Merchant");

        UI.quad(balance_bar, core_globals.white_sprite, {0.1, 0.11, 0.15, 0.9});
        balance_ts := ts;
        balance_ts.size = 30;
        balance_ts.halign = .LEFT;
        balance_ts.valign = .CENTER;
        balance_ts.offset.x = 12;
        balance_ts.color = {1.0, 0.92, 0.62, 1.0};
        UI.text(balance_bar, balance_ts, "Moons: %", {Economy.get_balance(player, MOON_CURRENCY)});

        info_ts := ts;
        info_ts.size = 26;
        info_ts.halign = .LEFT;
        info_ts.valign = .TOP;
        info_ts.word_wrap = true;
        UI.text(info_rect, info_ts, "Spend Moons on supply bundles!");

        UI.quad(body_bg, core_globals.white_sprite, {0.08, 0.09, 0.12, 0.8});
        section_title_rect := body_bg->cut_top(42)->inset(2, 8, 2, 8);
        section_ts := ts;
        section_ts.size = 30;
        section_ts.halign = .LEFT;
        section_ts.valign = .CENTER;
        section_ts.offset.x = 0;
        UI.text(section_title_rect, section_ts, "Shop Inventory");

        offers_rect := body_bg->inset(4, 8, 84, 8);

        if offers.count <= 0 {
            empty_rect := offers_rect->center_rect()->grow(40, 220, 40, 220);
            empty_ts := ts;
            empty_ts.size = 28;
            empty_ts.halign = .CENTER;
            empty_ts.valign = .CENTER;
            empty_ts.color = {1.0, 0.55, 0.55, 1.0};
            UI.text(empty_rect, empty_ts, "No merchant offers are configured.");
        }
        else {
            scroll_bar_area := offers_rect->cut_left(20)->inset(1);

            scroll_settings: Scroll_View_Settings;
            scroll_settings.vertical = true;
            scroll_settings.horizontal = false;
            scroll_settings.clip_padding = {2, 2, 2, 2};

            scroll_id := format_string("merchant_offer_scroll_%", {player->get_user_id()});
            sv := UI.push_scroll_view(offers_rect, scroll_id, scroll_settings); {
                defer UI.pop_scroll_view();

                row_base := sv.content_rect;
                offer_index: s64 = 0;
                while offer_index < offers.count {
                    offer := offers[offer_index];

                    row := row_base->cut_top(92)->inset(4, 8, 4, 8);
                    UI.quad(row, core_globals.white_sprite, {0.12, 0.13, 0.17, 0.95});

                    defn := MerchantSystem.resolve_item_def(offer.item_id);
                    display_name := offer.item_id;
                    icon: Texture_Asset;
                    if defn != null {
                        display_name = defn->get_name();
                        icon = defn->get_icon();
                    }

                    can_buy := MerchantSystem.can_buy_offer(player, offer);
                    room_ok := MerchantSystem.has_inventory_room_for_offer(player, offer);
                    balance_ok := Economy.get_balance(player, MOON_CURRENCY) >= offer.moon_cost;

                    button_rect := row->cut_right(220)->inset(8, 8, 8, 16);
                    text_rect := row->inset(8, 8, 8, 8);
                    if icon != null {
                        icon_rect := text_rect->cut_left(54)->fit_aspect(icon->get_aspect());
                        UI.quad(icon_rect, icon);
                        text_rect->cut_left(12);
                    }

                    name_rect := text_rect->cut_top(34);
                    detail_rect := text_rect;

                    name_ts := ts;
                    name_ts.size = 30;
                    name_ts.halign = .LEFT;
                    name_ts.valign = .CENTER;
                    name_ts.color = {0.95, 0.97, 1.0, 1.0};
                    UI.text(name_rect, name_ts, "% x%", {display_name, offer.stack_count});

                    detail_ts := ts;
                    detail_ts.size = 22;
                    detail_ts.halign = .LEFT;
                    detail_ts.valign = .CENTER;
                    detail_ts.color = {0.76, 0.82, 0.9, 1.0};
                    if defn == null {
                        detail_ts.color = {1.0, 0.55, 0.55, 1.0};
                        UI.text(detail_rect, detail_ts, "Missing item definition: %", {offer.item_id});
                    } else if !room_ok {
                        detail_ts.color = {1.0, 0.55, 0.55, 1.0};
                        UI.text(detail_rect, detail_ts, "Need inventory room. Cost: % Moons", {offer.moon_cost});
                    } else if !balance_ok {
                        detail_ts.color = {1.0, 0.78, 0.52, 1.0};
                        UI.text(detail_rect, detail_ts, "Not enough Moons. Cost: %", {offer.moon_cost});
                    } else {
                        UI.text(detail_rect, detail_ts, "Cost: % Moons", {offer.moon_cost});
                    }

                    button_bs := bs;
                    button_ts := ts;
                    button_ts.size = 26;
                    button_ts.halign = .CENTER;
                    button_ts.valign = .CENTER;

                    if !can_buy {
                        button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
                    } else {
                        button_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png");
                    }

                    UI.push_id("merchant_offer_%", {offer_index});
                    UI.push_disabled(!can_buy);
                    if UI.button(button_rect, button_bs, button_ts, "Buy").clicked {
                        if MerchantSystem.try_buy_offer(player, offer) {
                            game_sfx_play(.CRAFT_SUCCESS, player.entity);
                        } else {
                            game_sfx_play(.UI_ERROR, player.entity);
                        }
                    }
                    UI.pop_disabled();
                    UI.pop_id();

                    offer_index += 1;
                }
            }

            scroll_bar_rect := sv->compute_scroll_bar_rect(scroll_bar_area);
            UI.quad(scroll_bar_area, core_globals.white_sprite, {0.02, 0.02, 0.03, 1});
            UI.quad(scroll_bar_rect, core_globals.white_sprite, {0.15, 0.15, 0.2, 1});
        }

        action_row := body_bg->bottom_center_rect()->grow(36, 180, 36, 180)->offset(0, 46);
        close_ts := ts;
        close_ts.size = 30;
        close_ts.halign = .CENTER;

        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
        if UI.button(action_row, bs, close_ts, "Close").clicked {
            game_sfx_play(.UI_CLICK, player.entity);
            MerchantSystem.close_modal(player);
            return;
        }
    }
}
