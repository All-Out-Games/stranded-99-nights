Merchant_Shop_Offer :: struct {
    item_id: string;
    moon_cost: s64;
    stack_count: s64;
}

Merchant_Shop_Button :: struct {
    offer_index: s64;
    handle: Interact_Result;
    can_buy: bool;
}

Merchant :: class : Interactable {
    prompt_text: string @ao_serialize;

    ao_start :: method() {
        this.set_listener(this);

        if radius <= 0.0 {
            radius = 2.0;
        }

        if prompt_text.count <= 0 {
            prompt_text = MOON_MERCHANT_DISPLAY_NAME;
        }

        this.set_text(prompt_text);
        this.set_hold_text("Browsing wares...");
    }

    can_use :: method(player: Player) -> bool {
        return player != null;
    }

    on_interact :: method(player: Player) {
        if player == null return;

        player.close_all_ui_modals();
        player.merchant_ui_open = true;
        player.active_merchant = this;
        game_sfx_play(.UI_CLICK, player.entity);
    }
}

MerchantSystem :: struct {
    resolve_item_def :: proc(item_id: string) -> Item_Definition {
        defn := ItemManager.TryFindItem(item_id);
        if defn != null return defn;

        return try_find_reusable_weapon_item_def_by_id(item_id);
    }

    get_shop_offers :: proc() -> [..]Merchant_Shop_Offer {
        #static initted: bool;
        #static offers: [..]Merchant_Shop_Offer;

        if !initted {
            initted = true;
            // Starter stock. Tweak these entries freely as the merchant balance evolves.
            offers.append({"bandage", 1, 3});
            offers.append({"medkit", 2, 1});
            offers.append({"smg", 3, 1});
            offers.append({"energy_ammo", 3, 50});
            offers.append({"obsidian_sword", 15, 1});
            offers.append({"scythe", 25, 1});
        }

        return offers;
    }

    close_modal :: proc(player: Player) {
        if player == null return;
        player.merchant_ui_open = false;
        player.active_merchant = null;
    }

    has_inventory_room_for_offer :: proc(player: Player, offer: Merchant_Shop_Offer) -> bool {
        if player == null return false;
        if !#alive(player.default_inventory) return false;
        if player.default_inventory.capacity <= 0 return false;
        if offer.stack_count <= 0 return false;

        defn := MerchantSystem.resolve_item_def(offer.item_id);
        if defn == null return false;

        room := Items.calculate_room_in_inventory_for_item(defn, player.default_inventory);
        stack_count := ItemManager.ClampSpawnCountToMaxStack(defn, offer.stack_count);
        return room >= stack_count;
    }

    can_buy_offer :: proc(player: Player, offer: Merchant_Shop_Offer) -> bool {
        if player == null return false;
        if offer.moon_cost < 0 return false;

        if !MerchantSystem.has_inventory_room_for_offer(player, offer) return false;

        return Economy.can_withdraw_currency(player, MOON_CURRENCY, offer.moon_cost);
    }

    try_buy_offer :: proc(player: Player, offer: Merchant_Shop_Offer) -> bool {
        if player == null return false;

        defn := MerchantSystem.resolve_item_def(offer.item_id);
        if defn == null {
            Notifier.notify(player, "That item is not configured correctly.");
            return false;
        }

        if offer.moon_cost < 0 {
            Notifier.notify(player, "That offer is not configured correctly.");
            return false;
        }

        if offer.stack_count <= 0 {
            Notifier.notify(player, "That offer has no items configured.");
            return false;
        }

        if !MerchantSystem.has_inventory_room_for_offer(player, offer) {
            Notifier.notify(player, "You do not have enough room for that purchase.");
            return false;
        }

        if !Economy.can_withdraw_currency(player, MOON_CURRENCY, offer.moon_cost) {
            Notifier.notify(player, "You need more %.", {MOON_CURRENCY_DISPLAY});
            return false;
        }

        purchased_item := ItemManager.CreateItemFromDefinition(defn, offer.stack_count);
        if purchased_item == null {
            Notifier.notify(player, "That purchase failed.");
            return false;
        }

        Economy.withdraw_currency(player, MOON_CURRENCY, offer.moon_cost);
        Items.move_item_to_inventory(purchased_item, player.default_inventory);
        return true;
    }

    draw_ui :: proc(player: Player) {
        if player == null return;
        if !player.merchant_ui_open return;

        merchant := player.active_merchant;
        if merchant == null {
            MerchantSystem.close_modal(player);
            return;
        }
        if !#alive(merchant) {
            MerchantSystem.close_modal(player);
            return;
        }
        merchant_entity := merchant.entity;
        if merchant_entity == null {
            MerchantSystem.close_modal(player);
            return;
        }
        if !#alive(merchant_entity) {
            MerchantSystem.close_modal(player);
            return;
        }

        offers := MerchantSystem.get_shop_offers();
        balance := Economy.get_balance(player, MOON_CURRENCY);
        modal_rect := UI.get_safe_screen_rect().center_rect().grow(430, 730, 430, 730);
        close_header_handle: Interact_Result;
        close_button_handle: Interact_Result;
        buy_buttons: [..]Merchant_Shop_Button;
        buy_buttons.reserve(offers.count);

        fossil_icon := get_asset(Texture_Asset, MOON_CURRENCY_ICON_PATH);
        if fossil_icon == null {
            fossil_icon = get_asset(Texture_Asset, "Items/Moon.png");
        }

        UIK.begin(UIK.modal(modal_rect, 1000, v4{0, 0, 0, 0.65}));

        shell := UIK.panel_modal(.BLACK);
        shell.padding = v4{0, 0, 0, 0};
        shell.gap = 0;
        UIK.panel_begin(shell);

        title_desc := UIK.title_area_desc(MOON_MERCHANT_DISPLAY_NAME);
        title_desc.icon = fossil_icon;
        close_header_handle = UIK.title_area(title_desc);

        content := UIK.layout_column();
        content.width = UIK.flex(1);
        content.height = UIK.flex(1);
        content.padding = v4{12, 16, 12, 16};
        content.gap = 0;
        UIK.list_begin(format_string("merchant_offer_scroll_%", {player.get_user_id()}), content);

        info_panel := UIK.panel_styled(.MODAL_TRANSP_BLACK);
        info_panel.width = UIK.flex(1);
        info_panel.height = UIK.fit();
        info_panel.padding = v4{10, 14, 10, 14};
        UIK.panel_begin(info_panel);
        info_text := UIK.text_body();
        UIK.text_set_halign(&info_text, .LEFT);
        UIK.text("Spend Fossils on supply bundles and rare gear before the event ends.", info_text);
        UIK.panel_end();
        UIK.spacer(UIK.pixels(1), UIK.pixels(20));

        balance_panel := UIK.panel_interior(.INSET);
        balance_panel.width = UIK.flex(1);
        balance_panel.height = UIK.fit();
        balance_panel.padding = v4{12, 12, 12, 12};
        balance_panel.gap = 8;
        UIK.panel_begin(balance_panel);

        balance_title := UIK.text_title();
        UIK.text_set_halign(&balance_title, .LEFT);
        UIK.text("Current Balance", balance_title);

        balance_row := UIK.layout_row();
        balance_row.width = UIK.fit();
        balance_row.height = UIK.fit();
        balance_row.gap = 10;
        balance_row.cross_align = .CENTER;
        balance_row.show_background = false;
        UIK.panel_begin(balance_row);

        if fossil_icon != null {
            icon_box := UIK.layout_column();
            icon_box.width = UIK.pixels(40);
            icon_box.height = UIK.pixels(40);
            icon_box.cross_align = .CENTER;
            icon_box.main_align = .CENTER;
            icon_box.show_background = false;
            UIK.panel_begin(icon_box);
            UIK.image_fitted(fossil_icon, UIK.image_desc(.CONTAIN));
            UIK.panel_end();
        }

        balance_text := UIK.text_button();
        UIK.text_set_halign(&balance_text, .LEFT);
        UIK.text_set_color(&balance_text, v4{1.0, 0.92, 0.62, 1.0});
        UIK.text(format_string("%: %", {MOON_CURRENCY_DISPLAY, balance}), balance_text);
        UIK.panel_end();
        UIK.panel_end();
        UIK.spacer(UIK.pixels(1), UIK.pixels(20));

        stock_panel := UIK.panel_interior(.INSET);
        stock_panel.width = UIK.flex(1);
        stock_panel.height = UIK.fit();
        stock_panel.padding = v4{12, 12, 12, 12};
        stock_panel.gap = 6;
        UIK.panel_begin(stock_panel);

        stock_title := UIK.text_title();
        UIK.text_set_halign(&stock_title, .LEFT);
        UIK.text("Shop Inventory", stock_title);

        stock_body := UIK.text_body();
        UIK.text_set_halign(&stock_body, .LEFT);
        UIK.text("Each purchase goes straight into your inventory if you have room.", stock_body);
        UIK.panel_end();
        UIK.spacer(UIK.pixels(1), UIK.pixels(20));

        if offers.count <= 0 {
            empty_panel := UIK.panel_styled(.MODAL_TRANSP_BLACK);
            empty_panel.width = UIK.flex(1);
            empty_panel.height = UIK.fit();
            empty_panel.padding = v4{18, 18, 18, 18};
            empty_panel.main_align = .CENTER;
            empty_panel.cross_align = .CENTER;
            UIK.panel_begin(empty_panel);
            empty_text := UIK.text_body();
            UIK.text_set_color(&empty_text, v4{1.0, 0.55, 0.55, 1.0});
            UIK.text("No merchant offers are configured.", empty_text);
            UIK.panel_end();
        } else {
            for offer_index: 0..offers.count - 1 {
                if offer_index > 0 {
                    UIK.spacer(UIK.pixels(1), UIK.pixels(20));
                }

                offer := offers[offer_index];
                defn := MerchantSystem.resolve_item_def(offer.item_id);
                display_name := offer.item_id;
                icon: Texture_Asset;
                stack_count := offer.stack_count;
                if defn != null {
                    display_name = defn.get_name();
                    icon = defn.get_icon();
                    stack_count = ItemManager.ClampSpawnCountToMaxStack(defn, offer.stack_count);
                }

                room_ok := MerchantSystem.has_inventory_room_for_offer(player, offer);
                balance_ok := Economy.can_withdraw_currency(player, MOON_CURRENCY, offer.moon_cost);
                can_buy := MerchantSystem.can_buy_offer(player, offer);
                offer_valid := offer.moon_cost >= 0 && offer.stack_count > 0;

                entry := UIK.panel_styled(.MODAL_TRANSP_BLACK);
                entry.width = UIK.flex(1);
                entry.height = UIK.fit();
                entry.padding = v4{12, 12, 12, 12};
                entry.gap = 12;
                UIK.panel_begin(entry);

                row := UIK.layout_row();
                row.width = UIK.flex(1);
                row.height = UIK.fit();
                row.gap = 12;
                row.cross_align = .CENTER;
                row.show_background = false;
                UIK.panel_begin(row);

                if icon != null {
                    icon_box := UIK.layout_column();
                    icon_box.width = UIK.pixels(62);
                    icon_box.height = UIK.pixels(62);
                    icon_box.cross_align = .CENTER;
                    icon_box.main_align = .CENTER;
                    icon_box.show_background = false;
                    UIK.panel_begin(icon_box);
                    UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
                    UIK.panel_end();
                }

                text_panel := UIK.layout_column();
                text_panel.width = UIK.flex(1);
                text_panel.height = UIK.fit();
                text_panel.gap = 4;
                text_panel.show_background = false;
                UIK.panel_begin(text_panel);

                item_name := UIK.text_button();
                UIK.text_set_halign(&item_name, .LEFT);
                UIK.text(format_string("% x%", {display_name, stack_count}), item_name);

                item_status := UIK.text_body();
                UIK.text_set_halign(&item_status, .LEFT);
                if defn == null {
                    UIK.text_set_color(&item_status, v4{1.0, 0.55, 0.55, 1.0});
                    UIK.text(format_string("Missing item definition: %", {offer.item_id}), item_status);
                } else if !offer_valid {
                    UIK.text_set_color(&item_status, v4{1.0, 0.55, 0.55, 1.0});
                    UIK.text("This offer is not configured correctly.", item_status);
                } else if !room_ok {
                    UIK.text_set_color(&item_status, v4{1.0, 0.55, 0.55, 1.0});
                    UIK.text("Need more inventory room for this purchase.", item_status);
                } else if !balance_ok {
                    UIK.text_set_color(&item_status, v4{1.0, 0.78, 0.52, 1.0});
                    UIK.text("You do not have enough Fossils yet.", item_status);
                } else {
                    UIK.text_set_color(&item_status, v4{0.76, 0.82, 0.9, 1.0});
                    UIK.text("Ready to buy.", item_status);
                }
                UIK.panel_end();

                buy_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
                buy_desc.panel.width = UIK.pixels(220);
                buy_desc.panel.height = UIK.pixels(72);
                button_label := "Buy";
                if defn == null {
                    buy_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
                    buy_desc.panel.width = UIK.pixels(220);
                    buy_desc.panel.height = UIK.pixels(72);
                    buy_desc.disabled = true;
                    button_label = "Unavailable";
                } else if !offer_valid {
                    buy_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
                    buy_desc.panel.width = UIK.pixels(220);
                    buy_desc.panel.height = UIK.pixels(72);
                    buy_desc.disabled = true;
                    button_label = "Invalid";
                } else if !room_ok {
                    buy_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
                    buy_desc.panel.width = UIK.pixels(220);
                    buy_desc.panel.height = UIK.pixels(72);
                    buy_desc.disabled = true;
                    button_label = "No Room";
                } else if !balance_ok {
                    buy_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
                    buy_desc.panel.width = UIK.pixels(220);
                    buy_desc.panel.height = UIK.pixels(72);
                    buy_desc.disabled = true;
                    button_label = "Need Fossils";
                }
                buy_handle := UIK.button(format_string("merchant_buy_%", {offer_index}), button_label, buy_desc);
                buy_buttons.append(Merchant_Shop_Button{offer_index, buy_handle, can_buy});
                UIK.panel_end();

                cost_row := UIK.layout_row();
                cost_row.width = UIK.fit();
                cost_row.height = UIK.fit();
                cost_row.gap = 8;
                cost_row.cross_align = .CENTER;
                cost_row.show_background = false;
                UIK.panel_begin(cost_row);
                if fossil_icon != null {
                    UIK.currency(fossil_icon, offer.moon_cost, UIK.text_body());
                } else {
                    cost_text := UIK.text_body();
                    UIK.text_set_halign(&cost_text, .LEFT);
                    UIK.text(format_string("Cost: % %", {offer.moon_cost, MOON_CURRENCY_DISPLAY}), cost_text);
                }
                UIK.panel_end();
                UIK.panel_end();
            }
        }

        UIK.list_end();

        action_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 0);
        action_row.padding = v4{12, 0, 12, 12};
        action_row.show_background = false;
        UIK.panel_begin(action_row);

        close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
        close_desc.panel.width = UIK.flex(1);
        close_desc.panel.height = UIK.pixels(82);
        close_button_handle = UIK.button("merchant_close", "Close", close_desc);

        UIK.panel_end();
        UIK.panel_end();
        UIK.end();

        if UIK.clicked(close_header_handle) || UIK.clicked(close_button_handle) {
            game_sfx_play(.UI_CLICK, player.entity);
            MerchantSystem.close_modal(player);
            return;
        }

        for buy_button: buy_buttons {
            if !buy_button.can_buy continue;
            if !UIK.clicked(buy_button.handle) continue;

            offer := offers[buy_button.offer_index];
            if MerchantSystem.try_buy_offer(player, offer) {
                game_sfx_play(.CRAFT_SUCCESS, player.entity);
            } else {
                game_sfx_play(.UI_ERROR, player.entity);
            }
            return;
        }
    }
}
