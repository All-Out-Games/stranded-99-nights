Crafting_Stack :: struct {
    item_id: string;
    count: s64;
}

Crafting_Recipe :: class {
    id: string;
    name: string;
    description: string;
    inputs: [..]Crafting_Stack;
    outputs: [..]Crafting_Stack;
}

Crafting_Recipe_Button :: struct {
    recipe_index: s64;
    handle: Interact_Result;
}

CraftingSystem :: struct {
    resolve_item_def :: proc(item_id: string) -> Item_Definition {
        defn := ItemManager.TryFindItem(item_id);
        if defn != null return defn;

        // Reusable weapons register their own weapon/ammo item defs.
        reusable_def := try_find_reusable_weapon_item_def_by_id(item_id);
        if reusable_def != null return reusable_def;

        // Weapon item definitions come from reusable_weapons.
        if item_id == "spear" {
            return get_weapon_item_def(.SPEAR);
        }
        if item_id == "sword" {
            return get_weapon_item_def(.SWORD);
        }
        if item_id == "crossbow" {
            return get_weapon_item_def(.CROSSBOW);
        }

        return null;
    }

    get_primary_recipe_icon :: proc(recipe: Crafting_Recipe) -> Texture_Asset {
        if recipe == null return null;

        if recipe.outputs.count > 0 {
            out_def := CraftingSystem.resolve_item_def(recipe.outputs[0].item_id);
            if out_def != null {
                return out_def.get_icon();
            }
        }

        if recipe.inputs.count > 0 {
            in_def := CraftingSystem.resolve_item_def(recipe.inputs[0].item_id);
            if in_def != null {
                return in_def.get_icon();
            }
        }

        return null;
    }

    make_stack :: proc(item_id: string, count: s64) -> Crafting_Stack {
        stack: Crafting_Stack;
        stack.item_id = item_id;
        stack.count = count;
        return stack;
    }

    make_recipe :: proc(id: string, name: string, description: string) -> Crafting_Recipe {
        recipe := new(Crafting_Recipe);
        recipe.id = id;
        recipe.name = name;
        recipe.description = description;
        return recipe;
    }

    add_input :: proc(recipe: Crafting_Recipe, item_id: string, count: s64) {
        if recipe == null return;
        if item_id.count <= 0 return;
        if count <= 0 return;
        recipe.inputs.append(CraftingSystem.make_stack(item_id, count));
    }

    add_output :: proc(recipe: Crafting_Recipe, item_id: string, count: s64) {
        if recipe == null return;
        if item_id.count <= 0 return;
        if count <= 0 return;
        recipe.outputs.append(CraftingSystem.make_stack(item_id, count));
    }

    get_recipes :: proc() -> [..]Crafting_Recipe {
        #static initted: bool;
        #static recipes: [..]Crafting_Recipe;

        if !initted {
            initted = true;
            recipes.clear();

            

            r4 := CraftingSystem.make_recipe(
                "craft_spear",
                "Spear",
                "A simple melee weapon with stronger close-range damage."
            );
            CraftingSystem.add_input(r4, "wood", 7);
            CraftingSystem.add_input(r4, "scrap", 3);
            CraftingSystem.add_output(r4, "spear", 1);
            recipes.append(r4);

            r5 := CraftingSystem.make_recipe(
                "craft_sword",
                "Sword",
                "A heavier melee weapon with stronger strikes."
            );
            CraftingSystem.add_input(r5, "wood", 10);
            CraftingSystem.add_input(r5, "scrap", 10);
            CraftingSystem.add_output(r5, "sword", 1);
            recipes.append(r5);

            r6 := CraftingSystem.make_recipe(
                "craft_crossbow",
                "Crossbow",
                "A ranged weapon that fires arrows."
            );
            CraftingSystem.add_input(r6, "wood", 10);
            CraftingSystem.add_input(r6, "fiber", 4);
            CraftingSystem.add_input(r6, "scrap", 6);
            CraftingSystem.add_output(r6, "crossbow", 1);
            recipes.append(r6);

            r9 := CraftingSystem.make_recipe(
                "craft_bandage",
                "Bandage",
                "A simple healing item that restores 30 HP."
            );
            CraftingSystem.add_input(r9, "fiber", 2);
            CraftingSystem.add_output(r9, "bandage", 1);
            recipes.append(r9);

            r10 := CraftingSystem.make_recipe(
                "craft_medkit",
                "Medkit",
                "A powerful healing item that restores 80 HP."
            );
            CraftingSystem.add_input(r10, "fish", 2);
            CraftingSystem.add_input(r10, "fiber", 2);
            CraftingSystem.add_output(r10, "medkit", 1);
            recipes.append(r10);

            r7 := CraftingSystem.make_recipe(
                "craft_arrow_bundle",
                "Arrow x10",
                "Craft 10 arrows for crossbow ammo."
            );
            CraftingSystem.add_input(r7, "wood", 2);
            CraftingSystem.add_input(r7, "scrap", 1);
            CraftingSystem.add_input(r7, "fiber", 1);
            CraftingSystem.add_output(r7, "arrow", 10);
            recipes.append(r7);

            r8 := CraftingSystem.make_recipe(
                "craft_ar_ammo_bundle",
                "AR Ammo x30",
                "Craft 30 AR rounds."
            );
            CraftingSystem.add_input(r8, "sulfur", 6);
            CraftingSystem.add_input(r8, "scrap", 10);
            CraftingSystem.add_output(r8, "ar_ammo", 30);
            recipes.append(r8);

            r8b := CraftingSystem.make_recipe(
                "craft_heavy_ammo_bundle",
                "Heavy Ammo x30",
                "Craft 30 heavy ammo rounds."
            );
            CraftingSystem.add_input(r8b, "sulfur", 10);
            CraftingSystem.add_input(r8b, "scrap", 15);
            CraftingSystem.add_output(r8b, "heavy_ammo", 30);
            recipes.append(r8b);

            r8c := CraftingSystem.make_recipe(
                "craft_tornado_ammo_bundle",
                "Tornado Ammo x5",
                "Craft 5 tornado ammo shots."
            );
            CraftingSystem.add_input(r8c, "scrap", 10);
            CraftingSystem.add_input(r8c, "wood", 10);
            CraftingSystem.add_output(r8c, "tornado_ammo", 5);
            recipes.append(r8c);

            
        }

        return recipes;
    }

    clamp_recipe_index :: proc(index: s64) -> s64 {
        recipes := CraftingSystem.get_recipes();
        if recipes.count <= 0 return -1;
        if index < 0 return 0;
        if index >= recipes.count return recipes.count - 1;
        return index;
    }

    get_recipe :: proc(index: s64) -> Crafting_Recipe {
        recipes := CraftingSystem.get_recipes();
        if index < 0 || index >= recipes.count return null;
        return recipes[index];
    }

    get_item_count_in_inventory :: proc(inventory: Inventory, defn: Item_Definition) -> s64 {
        if inventory == null return 0;
        if defn == null return 0;

        total: s64 = 0;
        i := 0;
        while i < inventory.capacity {
            item := inventory.get_item(i);
            if item != null {
                if item.get_definition() == defn {
                    total += item.quantity;
                }
            }
            i += 1;
        }
        return total;
    }

    consume_item_from_inventory :: proc(inventory: Inventory, defn: Item_Definition, count: s64) -> bool {
        if inventory == null return false;
        if defn == null return false;
        if count <= 0 return true;

        remaining := count;
        i := 0;
        while i < inventory.capacity && remaining > 0 {
            item := inventory.get_item(i);
            if item != null {
                if item.get_definition() == defn {
                    if item.quantity <= remaining {
                        remaining -= item.quantity;
                        Items.destroy_item_instance(item);
                    }
                    else {
                        Items.destroy_item_instance(item, remaining);
                        remaining = 0;
                    }
                }
            }
            i += 1;
        }

        return remaining <= 0;
    }

    can_craft_recipe :: proc(player: Player, recipe: Crafting_Recipe) -> bool {
        if player == null return false;
        if recipe == null return false;
        if !#alive(player.default_inventory) return false;
        if player.default_inventory.capacity <= 0 return false;

        inv := player.default_inventory;

        for input: recipe.inputs {
            input_def := CraftingSystem.resolve_item_def(input.item_id);
            if input_def == null return false;

            have := CraftingSystem.get_item_count_in_inventory(inv, input_def);
            if have < input.count {
                return false;
            }
        }

        for output: recipe.outputs {
            output_def := CraftingSystem.resolve_item_def(output.item_id);
            if output_def == null return false;

            room := Items.calculate_room_in_inventory_for_item(output_def, inv);
            output_count := ItemManager.ClampSpawnCountToMaxStack(output_def, output.count);
            if room < output_count {
                return false;
            }
        }

        return true;
    }

    try_craft_recipe :: proc(player: Player, recipe: Crafting_Recipe) -> bool {
        if player == null return false;
        if recipe == null return false;
        if !#alive(player.default_inventory) return false;
        if player.default_inventory.capacity <= 0 return false;

        inv := player.default_inventory;

        for input: recipe.inputs {
            input_def := CraftingSystem.resolve_item_def(input.item_id);
            if input_def == null {
                //Notifier.notify(player, "Recipe item is missing: %", {input.item_id});
                return false;
            }

            have := CraftingSystem.get_item_count_in_inventory(inv, input_def);
            if have < input.count {
                Notifier.notify(player, "Need % x% (have %)", {input_def.get_name(), input.count, have});
                return false;
            }
        }

        for output: recipe.outputs {
            output_def := CraftingSystem.resolve_item_def(output.item_id);
            if output_def == null {
                //Notifier.notify(player, "Recipe output is missing: %", {output.item_id});
                return false;
            }

            room := Items.calculate_room_in_inventory_for_item(output_def, inv);
            output_count := ItemManager.ClampSpawnCountToMaxStack(output_def, output.count);
            if room < output_count {
                Notifier.notify(player, "Not enough room for %", {output_def.get_name()});
                return false;
            }
        }

        for input: recipe.inputs {
            input_def := CraftingSystem.resolve_item_def(input.item_id);
            ok := CraftingSystem.consume_item_from_inventory(inv, input_def, input.count);
            if !ok {
               // Notifier.notify(player, "Craft failed while consuming materials.", {});
                return false;
            }
        }

        for output: recipe.outputs {
            output_def := CraftingSystem.resolve_item_def(output.item_id);
            output_count := ItemManager.ClampSpawnCountToMaxStack(output_def, output.count);
            new_item := ItemManager.CreateItemFromDefinition(output_def, output_count);
            if new_item == null {
                Notifier.notify(player, "Craft failed while creating output item.", {});
                return false;
            }
            Items.move_item_to_inventory(new_item, inv);
        }

        if recipe.id == "craft_spear" {
            TutorialSystem.mark_craft_spear_complete(player);
        }

        //Notifier.notify(player, "Crafted: %", {recipe.name});
        return true;
    }

    draw_ui :: proc(player: Player) {
        if player == null return;

        if !player.crafting_ui_open return;

        recipes := CraftingSystem.get_recipes();
        modal_rect := UI.get_safe_screen_rect().center_rect().grow(420, 720, 420, 720);
        close_header_handle: Interact_Result;
        close_button_handle: Interact_Result;
        craft_button_handle: Interact_Result;
        recipe_buttons: [..]Crafting_Recipe_Button;
        recipe_buttons.reserve(recipes.count);

        UIK.begin(UIK.modal(modal_rect, 1000, v4{0, 0, 0, 0.65}));

        shell := UIK.panel_modal(.BLACK);
        shell.padding = v4{0, 0, 0, 0};
        shell.gap = 0;
        UIK.panel_begin(shell);

        close_header_handle = UIK.title_area(UIK.title_area_desc("Crafting"));

        if recipes.count <= 0 {
            empty_content := UIK.layout_column();
            empty_content.width = UIK.flex(1);
            empty_content.height = UIK.flex(1);
            empty_content.padding = v4{18, 18, 18, 18};
            empty_content.gap = 16;
            UIK.panel_begin(empty_content);

            empty_panel := UIK.panel_interior(.INSET);
            empty_panel.width = UIK.flex(1);
            empty_panel.height = UIK.flex(1);
            empty_panel.padding = v4{20, 20, 20, 20};
            empty_panel.main_align = .CENTER;
            empty_panel.cross_align = .CENTER;
            UIK.panel_begin(empty_panel);
            empty_text := UIK.text_title();
            UIK.text("No recipes found.", empty_text);
            UIK.panel_end();

            close_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 0);
            close_row.show_background = false;
            UIK.panel_begin(close_row);
            close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
            close_desc.panel.width = UIK.flex(1);
            close_desc.panel.height = UIK.pixels(84);
            close_button_handle = UIK.button("crafting_close_empty", "Close", close_desc);
            UIK.panel_end();

            UIK.panel_end();
            UIK.panel_end();
            UIK.end();

            if UIK.clicked(close_header_handle) || UIK.clicked(close_button_handle) {
                player.crafting_ui_open = false;
                game_sfx_play(.UI_CLICK, player.entity);
            }
            return;
        }

        player.selected_crafting_recipe_index = CraftingSystem.clamp_recipe_index(player.selected_crafting_recipe_index);
        selected_recipe := CraftingSystem.get_recipe(player.selected_crafting_recipe_index);
        if selected_recipe == null {
            for i: 0..recipes.count - 1 {
                if recipes[i] == null continue;
                player.selected_crafting_recipe_index = i;
                selected_recipe = recipes[i];
                break;
            }
        }
        if selected_recipe == null {
            player.crafting_ui_open = false;
            UIK.panel_end();
            UIK.end();
            return;
        }

        body := UIK.layout_row();
        body.width = UIK.flex(1);
        body.height = UIK.flex(1);
        body.gap = 12;
        body.padding = v4{16, 16, 16, 16};
        body.show_background = false;
        UIK.panel_begin(body);

        left := UIK.panel_interior(.INSET);
        left.width = UIK.pixels(360);
        left.height = UIK.flex(1);
        left.padding = v4{10, 10, 10, 10};
        left.gap = 8;
        UIK.panel_begin(left);

        list_title := UIK.text_title();
        UIK.text_set_halign(&list_title, .LEFT);
        UIK.text("Recipes", list_title);

        recipe_list := UIK.layout_column();
        recipe_list.width = UIK.flex(1);
        recipe_list.height = UIK.flex(1);
        recipe_list.gap = 8;
        recipe_list.padding = v4{2, 2, 2, 2};
        UIK.list_begin(format_string("craft_recipe_scroll_%", {player.get_user_id()}), recipe_list);
        for i: 0..recipes.count - 1 {
            recipe := recipes[i];
            if recipe == null continue;

            is_selected := i == player.selected_crafting_recipe_index;

            row := UIK.layout_row(UIK.flex(1), UIK.pixels(88), 0);
            row.cross_align = .STRETCH;
            row.show_background = false;
            UIK.panel_begin(row);

            recipe_desc := UIK.panel_styled(.BUTTON_BASIC_GREY);
            if is_selected {
                recipe_desc = UIK.panel_styled(.BUTTON_BASIC_GREEN);
            }
            recipe_desc.width = UIK.flex(1);
            recipe_desc.height = UIK.flex(1);
            recipe_desc.padding = v4{10, 16, 10, 16};
            recipe_desc.gap = 0;
            recipe_desc.cross_align = .STRETCH;

            recipe_handle := UIK.panel_begin_interactive(format_string("craft_recipe_%", {i}), recipe_desc);
            recipe_buttons.append(Crafting_Recipe_Button{i, recipe_handle});

            recipe_content := UIK.layout_row();
            recipe_content.width = UIK.flex(1);
            recipe_content.height = UIK.flex(1);
            recipe_content.gap = 12;
            recipe_content.cross_align = .CENTER;
            recipe_content.show_background = false;
            UIK.panel_begin(recipe_content);

            icon := CraftingSystem.get_primary_recipe_icon(recipe);
            if icon != null {
                icon_box := UIK.layout_column();
                icon_box.width = UIK.pixels(52);
                icon_box.height = UIK.pixels(52);
                icon_box.cross_align = .CENTER;
                icon_box.main_align = .CENTER;
                icon_box.show_background = false;
                UIK.panel_begin(icon_box);
                UIK.image_fitted(icon, UIK.image_desc(.CONTAIN));
                UIK.panel_end();
            }

            label_panel := UIK.layout_column();
            label_panel.width = UIK.flex(1);
            label_panel.height = UIK.flex(1);
            label_panel.main_align = .CENTER;
            label_panel.cross_align = .START;
            label_panel.show_background = false;
            UIK.panel_begin(label_panel);
            recipe_name := UIK.text_body();
            UIK.text_set_halign(&recipe_name, .LEFT);
            UIK.text_set_size_mult(&recipe_name, 1.05);
            UIK.text(recipe.name, recipe_name);
            UIK.panel_end();

            UIK.panel_end();

            UIK.panel_end();

            UIK.panel_end();
        }
        UIK.list_end();
        UIK.panel_end();

        right := UIK.panel_interior(.INSET);
        right.width = UIK.flex(1);
        right.height = UIK.flex(1);
        right.padding = v4{12, 12, 12, 12};
        right.gap = 10;
        UIK.panel_begin(right);

        details_content := UIK.layout_column();
        details_content.width = UIK.flex(1);
        details_content.height = UIK.flex(1);
        details_content.padding = v4{2, 4, 2, 4};
        details_content.gap = 8;
        UIK.list_begin(format_string("craft_detail_scroll_%", {player.get_user_id()}), details_content);

        details_title := UIK.text_title();
        UIK.text_set_halign(&details_title, .LEFT);
        UIK.text(selected_recipe.name, details_title);

        desc_panel := UIK.panel_styled(.MODAL_TRANSP_BLACK);
        desc_panel.width = UIK.flex(1);
        desc_panel.height = UIK.fit();
        desc_panel.padding = v4{10, 14, 10, 14};
        UIK.panel_begin(desc_panel);
        desc_text := UIK.text_body();
        UIK.text_set_halign(&desc_text, .LEFT);
        UIK.text(selected_recipe.description, desc_text);
        UIK.panel_end();

        section_title := UIK.text_button();
        UIK.text_set_halign(&section_title, .LEFT);
        UIK.text("Required", section_title);

        for input: selected_recipe.inputs {
            input_def := CraftingSystem.resolve_item_def(input.item_id);
            have: s64 = 0;
            display_name := input.item_id;
            input_icon: Texture_Asset;
            if input_def != null {
                display_name = input_def.get_name();
                have = CraftingSystem.get_item_count_in_inventory(player.default_inventory, input_def);
                input_icon = input_def.get_icon();
            }

            line := UIK.panel_styled(.MODAL_TRANSP_BLACK);
            line.width = UIK.flex(1);
            line.height = UIK.fit();
            line.gap = 10;
            line.padding = v4{8, 10, 8, 10};
            line.cross_align = .CENTER;
            UIK.panel_begin(line);

            if input_icon != null {
                icon_box := UIK.layout_column();
                icon_box.width = UIK.pixels(42);
                icon_box.height = UIK.pixels(42);
                icon_box.cross_align = .CENTER;
                icon_box.main_align = .CENTER;
                icon_box.show_background = false;
                UIK.panel_begin(icon_box);
                UIK.image_fitted(input_icon, UIK.image_desc(.CONTAIN));
                UIK.panel_end();
            }

            line_text := UIK.text_body();
            UIK.text_set_halign(&line_text, .LEFT);
            if have >= input.count {
                UIK.text_set_color(&line_text, v4{0.65, 1.0, 0.65, 1.0});
            } else {
                UIK.text_set_color(&line_text, v4{1.0, 0.5, 0.5, 1.0});
            }
            UIK.text(format_string("%: %/%", {display_name, have, input.count}), line_text);
            UIK.panel_end();
        }

        UIK.spacer(UIK.pixels(1), UIK.pixels(8));
        UIK.text("Result", section_title);

        for output: selected_recipe.outputs {
            output_def := CraftingSystem.resolve_item_def(output.item_id);
            output_name := output.item_id;
            output_icon: Texture_Asset;
            if output_def != null {
                output_name = output_def.get_name();
                output_icon = output_def.get_icon();
            }

            line := UIK.panel_styled(.MODAL_TRANSP_BLACK);
            line.width = UIK.flex(1);
            line.height = UIK.fit();
            line.gap = 10;
            line.padding = v4{8, 10, 8, 10};
            line.cross_align = .CENTER;
            UIK.panel_begin(line);

            if output_icon != null {
                icon_box := UIK.layout_column();
                icon_box.width = UIK.pixels(42);
                icon_box.height = UIK.pixels(42);
                icon_box.cross_align = .CENTER;
                icon_box.main_align = .CENTER;
                icon_box.show_background = false;
                UIK.panel_begin(icon_box);
                UIK.image_fitted(output_icon, UIK.image_desc(.CONTAIN));
                UIK.panel_end();
            }

            line_text := UIK.text_body();
            UIK.text_set_halign(&line_text, .LEFT);
            UIK.text_set_color(&line_text, v4{0.9, 0.95, 1.0, 1.0});
            output_count := ItemManager.ClampSpawnCountToMaxStack(output_def, output.count);
            UIK.text(format_string("% x%", {output_name, output_count}), line_text);
            UIK.panel_end();
        }

        UIK.list_end();

        can_craft := CraftingSystem.can_craft_recipe(player, selected_recipe);
        action_row := UIK.layout_row(UIK.flex(1), UIK.fit(), 10);
        action_row.show_background = false;
        UIK.panel_begin(action_row);

        close_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_RED);
        close_desc.panel.width = UIK.flex(1);
        close_desc.panel.height = UIK.pixels(84);
        close_button_handle = UIK.button("crafting_close", "Close", close_desc);

        craft_desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREEN);
        craft_desc.panel.width = UIK.flex(1);
        craft_desc.panel.height = UIK.pixels(84);
        craft_desc.disabled = !can_craft;
        if !can_craft {
            craft_desc = UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
            craft_desc.panel.width = UIK.flex(1);
            craft_desc.panel.height = UIK.pixels(84);
            craft_desc.disabled = true;
        }
        craft_button_handle = UIK.button("crafting_craft", "Craft", craft_desc);

        UIK.panel_end();
        UIK.panel_end();
        UIK.panel_end();
        UIK.panel_end();
        UIK.end();

        if UIK.clicked(close_header_handle) || UIK.clicked(close_button_handle) {
            player.crafting_ui_open = false;
            game_sfx_play(.UI_CLICK, player.entity);
            return;
        }

        for recipe_button: recipe_buttons {
            if !UIK.clicked(recipe_button.handle) continue;

            player.selected_crafting_recipe_index = recipe_button.recipe_index;
            game_sfx_play(.UI_CLICK, player.entity);
            return;
        }

        if UIK.clicked(craft_button_handle) {
            crafted := CraftingSystem.try_craft_recipe(player, selected_recipe);
            if crafted {
                game_sfx_play(.CRAFT_SUCCESS, player.entity);
            } else {
                game_sfx_play(.UI_ERROR, player.entity);
            }
        }
    }
}
