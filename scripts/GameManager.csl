    lobby_spawn: Entity @ao_serialize;
    island1_spawn: Entity @ao_serialize;
    Islands: [..]Entity @ao_serialize;
    VoyageScene: Entity @ao_serialize;
    damage_number_lifetime_seconds: float @ao_serialize;
    damage_number_rise_speed: float @ao_serialize;
    
    current_phase: Game_Phase;
    game_time_seconds: float;
    phase_time_seconds: float;
    Island: int;
    loaded_island: int;
    day_night_phase: Day_Night_Phase;
    day_night_phase_time_seconds: float;
    day_night_blend: float;
    day_night_blend_from: float;
    day_night_blend_to: float;
    day_night_blend_transition_time_seconds: float;
    nights: s64;
    current_night_event: Night_Event_Type;
    forced_next_night_event: Night_Event_Type;
    raid_spawn_cap_multiplier: s64 @ao_serialize;
    night_event_min_completed_nights_before_roll: s64 @ao_serialize;
    night_event_none_weight: float @ao_serialize;
    night_event_raid_weight: float @ao_serialize;
    night_event_supply_drop_weight: float @ao_serialize;
    night_event_moon_merchant_weight: float @ao_serialize;
    night_event_weight_scale_start: float @ao_serialize;
    night_event_weight_scale_gain_per_completed_night: float @ao_serialize;
    night_event_weight_scale_cap: float @ao_serialize;
    SupplyDropPrefab: string @ao_serialize;
    ReaperPrefab: string @ao_serialize;
    MoonMerchantPrefab: string @ao_serialize;
    SurvivorPrefab: string @ao_serialize;
    Island1BossMob: string @ao_serialize;
    Island2BossMob: string @ao_serialize;
    Island3BossMob: string @ao_serialize;
    Island4BossMob: string @ao_serialize;
    Island5BossMob: string @ao_serialize;
    moon_merchant_spawn_radius: float @ao_serialize;
    moon_merchant_spawn_sample_attempts: s64 @ao_serialize;
    island1_boss_spawn_point: Entity @ao_serialize;
    island2_boss_spawn_point: Entity @ao_serialize;
    island3_boss_spawn_point: Entity @ao_serialize;
    island4_boss_spawn_point: Entity @ao_serialize;
    island5_boss_spawn_point: Entity @ao_serialize;
    SupplyDrops: [..]Entity @ao_serialize;
    Island1SurvivorSpawnPositions: [..]Entity @ao_serialize;
    Island2SurvivorSpawnPositions: [..]Entity @ao_serialize;
    Island3SurvivorSpawnPositions: [..]Entity @ao_serialize;
    Island4SurvivorSpawnPositions: [..]Entity @ao_serialize;
    active_supply_drop_entity: Entity;
    active_reaper_entity: Entity;
    active_nightly_boss_entity: Entity;
    active_moon_merchant_entity: Entity;
    active_survivor_entities: [..]Entity;
    active_moon_merchant_spawn_position: v2;
    moon_merchant_spawn_position_ready: bool;
    active_reaper_target_player_id: u64;
    active_reaper_island_number: int;
    last_spawned_nightly_boss_night_number: s64;
    reaper_boss_defeated_for_run: [5]bool;
    next_raid_allowed_night_number: s64;
    last_notified_night_event: Night_Event_Type;
    current_run_seed: u64;
    run_seed_generation_count: s64;

    DAY_DURATION_SECONDS :: 60.0;
    NIGHT_DURATION_SECONDS :: 45.0;
    DAY_NIGHT_BLEND_TRANSITION_SECONDS :: 5.0;
    NIGHT_WARNING_LEAD_TIME_SECONDS :: 10.0;
