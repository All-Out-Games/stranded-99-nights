    ao_start :: method() {
        if g_game_manager != null && g_game_manager != this {
            log_info("Duplicate GameManager detected; destroying duplicate.", {});
            entity.destroy();
            return;
        }

        g_game_manager = this;
        if damage_number_lifetime_seconds <= 0.0 { damage_number_lifetime_seconds = 0.65; }
        if damage_number_rise_speed <= 0.0 { damage_number_rise_speed = 1.4; }
        if raid_spawn_cap_multiplier <= 1 { raid_spawn_cap_multiplier = 2; }
        if night_event_min_completed_nights_before_roll <= 0 { night_event_min_completed_nights_before_roll = 2; }
        if night_event_none_weight <= 0.0 { night_event_none_weight = 65.0; }
        if night_event_raid_weight <= 0.0 { night_event_raid_weight = 25.0; }
        if night_event_supply_drop_weight <= 0.0 { night_event_supply_drop_weight = 10.0; }
        if night_event_moon_merchant_weight <= 0.0 { night_event_moon_merchant_weight = 10.0; }
        if night_event_weight_scale_start <= 0.0 { night_event_weight_scale_start = 0.1; }
        if night_event_weight_scale_gain_per_completed_night <= 0.0 { night_event_weight_scale_gain_per_completed_night = 0.1; }
        if night_event_weight_scale_cap <= 0.0 { night_event_weight_scale_cap = 1.0; }
        if moon_merchant_spawn_radius <= 0.0 { moon_merchant_spawn_radius = MOON_MERCHANT_DEFAULT_SPAWN_RADIUS; }
        if moon_merchant_spawn_sample_attempts <= 0 { moon_merchant_spawn_sample_attempts = MOON_MERCHANT_DEFAULT_SPAWN_SAMPLE_ATTEMPTS; }
        last_notified_night_event = .NONE;
        reset_game_state();
        if Game.is_server() {
            assign_new_run_seed();
        }
        loaded_island = Island;
        island_transition_target_island = Island;
        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_freeze_applied = false;
        active_moon_merchant_spawn_position = {0.0, 0.0};
        moon_merchant_spawn_position_ready = false;
        island_transition_start_time = 0.0;
        voyage_state = .NONE;
        voyage_timer_start_time = 0.0;
        voyage_returning_after_destruction = false;
        last_enabled_island_number = -1;
        apply_navmesh_lock_to_all_players();
        sync_active_island_entity();
        play_music_track(.DAY);
    }

    ao_update :: method(dt: float) {
        //if Game.is_server() {
            update_damage_numbers(dt);
       // }

        // Keep core game state authoritative on the server.
        // Music playback runs on both server and client.

        sync_active_island_entity();
        sync_moon_merchant_event_entity();
        try_start_island_transition_if_needed();
        update_island_transition();
        sync_island_transition_freeze_state();
        sync_run_complete_freeze_state();
        sync_music_track_for_game_state();
        if island_transition_active return;
        if current_phase == .IN_ROUND {
            record_island_reached_for_run(Island);
        }
        if run_complete_sequence_active {
            update_run_complete_sequence();
            return;
        }
        update_voyage_timer();

        game_time_seconds += dt;
        phase_time_seconds += dt;
        update_reaper_boss_state();
        update_island5_story_boss_state();

        switch current_phase {
            case .LOBBY: {
                // Lobby state: waiting for players/game start conditions.
                try_auto_start_from_lobby();
            }
            case .IN_ROUND: {
                // Round state: active gameplay should run here.
                update_round_start_sequence();
                update_day_night_cycle(dt);
                update_night_event_notifications();
                update_day_night_blend(dt);
                sync_nightly_boss_for_current_state();
            }
            case .POST_ROUND: {
                // Post round state: cleanup, score display, and reset hooks.
            }
        }

        update_game_over_sequence();

    }

    ao_late_update :: method(dt: float) {
        if has_local_player_for_visuals() {
            apply_day_night_post_processing();
        }
        if Game.is_server() return;
        if this.is_local_merchant_ui_open() return;
        draw_damage_numbers();
    }

    has_local_player_for_visuals :: method() -> bool {
        foreach player: component_iterator(Player) {
            if player != null && player.is_local() {
                return true;
            }
        }

        return false;
    }

    is_local_merchant_ui_open :: method() -> bool {
        foreach player: component_iterator(Player) {
            if player != null && player.is_local() && player.merchant_ui_open {
                return true;
            }
        }

        return false;
    }

    ao_end :: method() {
        stop_current_music_track();
        if g_game_manager == this {
            g_game_manager = null;
        }
    }

    start_game :: method() {
        transition_to_phase(.IN_ROUND);
        game_time_seconds = 0.0;
    }

    stop_game :: method() {
        transition_to_phase(.POST_ROUND);
    }

    reset_game_state :: method() {
        clear_active_night_event();
        forced_next_night_event = .NONE;
        game_time_seconds = 0.0;
        phase_time_seconds = 0.0;
        reset_day_night_cycle();
        Island = 1;
        record_island_reached_for_run(Island);
        loaded_island = Island;
        island_transition_target_island = Island;
        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_freeze_applied = false;
        island_transition_start_time = 0.0;
        voyage_state = .NONE;
        voyage_timer_start_time = 0.0;
        voyage_returning_after_destruction = false;
        VoyageHealth = VOYAGE_STARTING_HEALTH;
        last_enabled_island_number = -1;
        nights = 0;
        next_raid_allowed_night_number = 0;
        current_run_seed = 0;
        active_reaper_target_player_id = 0;
        active_reaper_island_number = 0;
        active_nightly_boss_entity = null;
        active_island5_story_boss_entity = null;
        last_spawned_nightly_boss_night_number = 0;
        clear_reaper_boss_defeat_flags();
        island5_story_boss_spawn_triggered = false;
        island5_story_boss_spawn_time_seconds = 0.0;
        island5_story_boss_defeat_handled = false;
        highest_island_reached_this_run = max(Island, 1);
        run_complete_sequence_active = false;
        run_complete_sequence_reward_done = false;
        run_complete_sequence_start_time = 0.0;
        run_complete_sequence_highest_island = 0;
        run_complete_sequence_moon_reward = 0;
        run_complete_sequence_island_line_sfx_played = false;
        run_complete_sequence_rex_line_sfx_played = false;
        run_complete_sequence_reward_line_sfx_played = false;
        run_complete_freeze_applied = false;
        run_complete_reward_user_ids.clear();
        foreach player: component_iterator(Player) {
            if player == null continue;
            player.remove_freeze_reason(RUN_COMPLETE_FREEZE_REASON);
        }
        sync_active_island_entity();
        current_phase = .LOBBY;
        on_enter_phase(current_phase);
    }

    transition_to_phase :: method(next_phase: Game_Phase) {
        if current_phase == next_phase return;

        on_exit_phase(current_phase);
        current_phase = next_phase;
        phase_time_seconds = 0.0;
        on_enter_phase(current_phase);
    }

    on_enter_phase :: method(phase: Game_Phase) {
        switch phase {
            case .LOBBY: {
                log_info("GameManager phase -> LOBBY", {});
                update_matchmaking_priority();
            }
            case .IN_ROUND: {
                log_info("GameManager phase -> IN_ROUND", {});
                update_matchmaking_priority();
                if !Game.is_server() {
                    game_sfx_play(.ROUND_START);
                }
                assign_new_run_seed();
                run_round_start_poi_setup();
                nights = 0;
                next_raid_allowed_night_number = 0;
                reset_day_night_cycle();
                current_night_event = .NONE;
                clear_nightly_boss();
                clear_island5_story_boss();
                last_spawned_nightly_boss_night_number = 0;
                reset_beacons_for_round();
                reset_voyage_preps_for_round();
                round_start_teleport_done = false;
                game_over_sequence_active = false;
                game_over_sequence_restart_done = false;
                game_over_sequence_start_time = 0.0;
                run_complete_sequence_active = false;
                run_complete_sequence_reward_done = false;
                run_complete_sequence_start_time = 0.0;
                run_complete_sequence_highest_island = 0;
                run_complete_sequence_moon_reward = 0;
                run_complete_sequence_island_line_sfx_played = false;
                run_complete_sequence_rex_line_sfx_played = false;
                run_complete_sequence_reward_line_sfx_played = false;
                run_complete_freeze_applied = false;
                run_complete_reward_user_ids.clear();
                highest_island_reached_this_run = max(Island, 1);
                foreach player: component_iterator(Player) {
                    if player == null continue;
                    player.remove_freeze_reason(RUN_COMPLETE_FREEZE_REASON);
                }
            }
            case .POST_ROUND: {
                log_info("GameManager phase -> POST_ROUND", {});
                update_matchmaking_priority();
            }
        }
    }

    should_use_active_matchmaking_priority :: method() -> bool {
        if current_phase == .LOBBY return false;
        if game_over_sequence_active return false;
        if run_complete_sequence_active return false;
        return true;
    }

    update_matchmaking_priority :: method() {
        if !Game.is_server() return;

        if should_use_active_matchmaking_priority() {
            Server.set_matchmaking_priority(MATCHMAKING_PRIORITY_ACTIVE);
            return;
        }

        Server.set_matchmaking_priority(MATCHMAKING_PRIORITY_INACTIVE);
    }

    on_exit_phase :: method(phase: Game_Phase) {
        switch phase {
            case .LOBBY: {
                // Exit lobby hooks go here.
            }
            case .IN_ROUND: {
                // Exit round hooks go here.
                clear_active_night_event();
                clear_nightly_boss();
                day_night_phase = .DAY;
                day_night_phase_time_seconds = 0.0;
                day_night_blend = 0.0;
                day_night_blend_from = 0.0;
                day_night_blend_to = 0.0;
                day_night_blend_transition_time_seconds = 0.0;
                play_music_track(.DAY);
            }
            case .POST_ROUND: {
                // Exit post-round hooks go here.
            }
        }
    }

    start_round :: method() {
        transition_to_phase(.IN_ROUND);
    }

    end_round :: method() {
        transition_to_phase(.POST_ROUND);
    }

    go_to_lobby :: method() {
        transition_to_phase(.LOBBY);
    }

    is_round_active :: method() -> bool {
        return current_phase == .IN_ROUND;
    }

    get_phase :: method() -> Game_Phase {
        return current_phase;
    }

    get_phase_time_seconds :: method() -> float {
        return phase_time_seconds;
    }

    assign_new_run_seed :: method() {
        next_generation := run_seed_generation_count + 1;
        seed_source := rng_root_seed() + (next_generation * 104729).(u64);
        seed_rng := rng_seed(seed_source);
        current_run_seed = rng_range_int(ref seed_rng, 1, 2147483647).(u64);
        if current_run_seed == 0 {
            current_run_seed = 1;
        }

        run_seed_generation_count = next_generation;
        log_info("Assigned new run seed % (generation %).", {
            current_run_seed,
            run_seed_generation_count
        });
    }

    get_run_rng :: method(stream_id: s64, stream_index: s64 = 0) -> u64 {
        seed_base := current_run_seed;
        if seed_base == 0 {
            seed_base = 1;
        }

        seed_value := seed_base +
            (stream_id * 7919).(u64) +
            (max(stream_index, 0) * 104729).(u64);
        if seed_value == 0 {
            seed_value = seed_base + 1;
        }
        return rng_seed(seed_value);
    }

    show_broadcast_notification :: method(message: string) {
        if message.count <= 0 return;
        if !Game.is_server() return;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;

            Notifier.notify(p, message);
        }
    }

    get_game_time_seconds :: method() -> float {
        return game_time_seconds;
    }

    get_nights :: method() -> s64 {
        return nights;
    }

    get_night_survival_credit_amount :: method() -> s64 {
        if Island == 4 return 6;
        if Island == 3 return 4;
        if Island == 2 return 2;
        return 1;
    }

    get_night_survival_reward_amount :: method() -> s64 {
        return this.get_night_survival_credit_amount();
    }

    get_survivor_moon_reward_amount :: method() -> s64 {
        return max((Island * 3).(s64), 0);
    }

    record_island_reached_for_run :: method(island_number: int) {
        if island_number <= 0 return;
        highest_island_reached_this_run = max(highest_island_reached_this_run, island_number);
    }

    apply_night_survival_progress :: method() {
        credit_amount := this.get_night_survival_credit_amount();
        if credit_amount <= 0 return;

        previous_nights := nights;
        nights += credit_amount;

        survived_night := previous_nights + 1;
        while survived_night <= nights {
            this.increment_global_night_survival_count(survived_night);
            survived_night += 1;
        }
    }

    has_reached_night_win_goal :: method() -> bool {
        return nights >= MAX_TRACKED_SURVIVAL_NIGHT;
    }

    is_voyage_damage_redirect_active :: method() -> bool {
        return current_phase == .IN_ROUND && voyage_state == .VOYAGING;
    }

    apply_voyage_damage :: method(amount: float) -> float {
        if amount <= 0.0 return 0.0;
        if !is_voyage_damage_redirect_active() return 0.0;

        absorbed := min(amount, VoyageHealth);
        if absorbed > 0.0 {
            foreach voyage_boat: component_iterator(VoyageBoat) {
                voyage_boat.trigger_damage_feedback();
            }
        }
        VoyageHealth = max(VoyageHealth - amount, 0.0);
        if VoyageHealth <= 0.0 {
            if Game.is_server() {
                show_broadcast_notification(VOYAGE_FAILED_NOTIFICATION_TEXT);
            }
            start_voyage_return_transition(loaded_island, true);
        }
        return absorbed;
    }

    should_draw_voyage_health_bar :: method() -> bool {
        return is_voyage_damage_redirect_active();
    }

    get_voyage_health_fill_t :: method() -> float {
        return clamp(VoyageHealth / VOYAGE_STARTING_HEALTH, 0.0, 1.0);
    }

    get_voyage_mob_damage :: method() -> float {
        return max((Island * 5 - 5).(float), 0.0);
    }

    should_mobs_path_to_closest_reachable_target_point :: method() -> bool {
        return current_phase == .IN_ROUND && voyage_state == .VOYAGING;
    }

    get_non_night_only_spawner_spawn_scale :: method() -> float {
        completed_nights := max(nights, 0);
        if completed_nights <= 0 return 1.0;

        return pow(2.0, completed_nights.(float) / NON_NIGHT_ONLY_SPAWNER_DOUBLING_NIGHTS);
    }

    is_tracked_survival_night :: method(night_number: s64) -> bool {
        return night_number >= 1 && night_number <= MAX_TRACKED_SURVIVAL_NIGHT;
    }

    get_night_survival_save_key :: method(night_number: s64) -> string {
        return format_string(NIGHT_SURVIVAL_SAVE_KEY_FORMAT, {night_number});
    }

    increment_global_night_survival_count :: method(night_number: s64) {
        // Only the server should write global save state.
        if !Game.is_server() return;
        if !this.is_tracked_survival_night(night_number) return;

        key := this.get_night_survival_save_key(night_number);
        Save.increment_game_int(key, 1);
    }

    get_global_night_survival_count :: method(night_number: s64) -> s64 {
        if !this.is_tracked_survival_night(night_number) return 0;

        key := this.get_night_survival_save_key(night_number);
        return Save.get_game_int(key, 0);
    }

    get_player_count :: method() -> s64 {
        player_count: s64 = 0;
        foreach p: component_iterator(Player) {
            player_count += 1;
        }
        return player_count;
    }

    get_required_players_to_start :: method() -> s64 {
        return PLAYERS_REQUIRED_TO_START;
    }

    is_private_server :: method() -> bool {
        _, is_private := Server.get_private_server_host_id();
        return is_private;
    }

    can_player_force_start_from_lobby :: method(player: Player) -> bool {
        if player == null return false;
        if current_phase != .LOBBY return false;
        if game_over_sequence_active return false;
        return true;
    }

    on_player_joined :: method(player: Player) {
        lock_player_to_navmesh(player);
        if island_transition_active && player != null {
            player.add_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
        }
        if run_complete_sequence_active && run_complete_freeze_applied && player != null {
            player.add_freeze_reason(RUN_COMPLETE_FREEZE_REASON);
        }
        teleport_player_to_phase_spawn(player);
    }

    has_log_page_for_run :: method(log_index: int) -> bool {
        if log_index <= 0 return false;

        for acquired_index: picked_up_log_page_indices {
            if acquired_index == log_index {
                return true;
            }
        }
        return false;
    }

    acquire_log_page_for_run :: method(log_index: int) -> bool {
        if log_index <= 0 return false;
        if this.has_log_page_for_run(log_index) return false;

        picked_up_log_page_indices.append(log_index);
        i := picked_up_log_page_indices.count - 1;
        while i > 0 {
            prev_index := i - 1;
            if picked_up_log_page_indices[prev_index] <= picked_up_log_page_indices[i] {
                break;
            }

            swap := picked_up_log_page_indices[prev_index];
            picked_up_log_page_indices[prev_index] = picked_up_log_page_indices[i];
            picked_up_log_page_indices[i] = swap;
            i = prev_index;
        }

        if log_index == ISLAND5_BOSS_LOG_PAGE_INDEX {
            try_begin_island5_story_boss_spawn();
        }
        return true;
    }

    get_picked_up_log_page_count :: method() -> int {
        return picked_up_log_page_indices.count;
    }

    get_picked_up_log_page_at :: method(display_index: int) -> int, bool {
        if display_index < 0 return 0, false;
        if display_index >= picked_up_log_page_indices.count return 0, false;
        return picked_up_log_page_indices[display_index], true;
    }

    reset_log_pages_for_full_restart :: method() {
        picked_up_log_page_indices.clear();

        foreach log_page: component_iterator(LogPage) {
            if log_page == null continue;
            log_page.reset_for_run_restart();
        }
    }

    teleport_player_to_phase_spawn :: method(player: Player) {
        if player == null return;
        if player.entity == null return;

        if current_phase == .IN_ROUND {
            if should_player_spawn_in_voyage_scene() {
                teleport_player_to_voyage_scene(player);
                return;
            }
            teleport_player_near_beacon_for_round(player);
            return;
        }

        teleport_player_to_lobby_spawn(player);
    }

    get_respawn_position_for_player :: method(player: Player) -> v2 {
        if current_phase == .IN_ROUND {
            if should_player_spawn_in_voyage_scene() {
                return get_voyage_scene_position();
            }
            if player != null && player.entity != null {
                return sample_player_position_near_beacon(player);
            }
        }

        if lobby_spawn != null {
            return lobby_spawn.world_position;
        }
        if island1_spawn != null {
            return island1_spawn.world_position;
        }
        return entity.world_position;
    }

    teleport_player_to_lobby_spawn :: method(player: Player) {
        if player == null || player.entity == null return;
        if lobby_spawn == null return;

        player.entity.set_local_position(lobby_spawn.world_position);
    }

    teleport_player_to_island1_spawn :: method(player: Player) {
        if player == null || player.entity == null return;
        if island1_spawn == null return;

        player.entity.set_local_position(island1_spawn.world_position);
    }

    teleport_all_players_to_island1_spawn :: method() {
        if island1_spawn == null return;

        foreach player: component_iterator(Player) {
            teleport_player_to_island1_spawn(player);
        }
    }

    teleport_player_near_beacon_for_round :: method(player: Player) {
        if player == null || player.entity == null return;
        player.entity.set_local_position(sample_player_position_near_beacon(player));
    }

    get_voyage_scene_position :: method() -> v2 {
        voyage_pos := v2{0.0, 0.0};
        if VoyageScene != null {
            voyage_pos = VoyageScene.world_position;
        }
        return voyage_pos;
    }

    teleport_player_to_voyage_scene :: method(player: Player) {
        if player == null || player.entity == null return;
        player.entity.set_local_position(get_voyage_scene_position());
    }

    reset_beacons_for_round :: method() {
        if !Game.is_server() return;

        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            beacon.set_fuel_for_round(Beacon.DEFAULT_STARTING_FUEL);
        }
    }

    get_auto_beacon_level_for_island :: method(island_number: int) -> s64, bool {
        switch island_number {
            case 2: return 3, true;
            case 3: return 4, true;
            case 4: return 5, true;
        }

        return 0, false;
    }

    apply_auto_beacon_level_for_island :: method(island_number: int) {
        if !Game.is_server() return;

        target_level, should_apply := this.get_auto_beacon_level_for_island(island_number);
        if !should_apply return;

        updated_count: s64 = 0;
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.level >= target_level continue;

            beacon.set_beacon_level(target_level);
            updated_count += 1;
        }

        if updated_count > 0 {
            log_info("Auto-upgraded beacon to level % for island %.", {target_level, island_number});
        }
    }

    reset_voyage_preps_for_round :: method() {
        foreach prep: component_iterator(VoyagePrep) {
            if prep == null continue;
            prep.reset_for_round();
        }
    }

    run_round_start_poi_setup :: method() {
        poi_rng := get_run_rng(RUN_RNG_STREAM_POI);
        spawned_count: s64 = 0;
        total_count: s64 = 0;
        foreach poi: component_iterator(POI) {
            if poi == null continue;
            total_count += 1;
            if poi.spawn_for_round(ref poi_rng) {
                spawned_count += 1;
            }
        }

        if total_count > 0 {
            log_info("POI round start complete: %/% spawned.", {spawned_count, total_count});
        }

        spawn_survivors_for_run();
        rebuild_player_navmesh_for_round_start();
    }

    rebuild_player_navmesh_for_round_start :: method() {
        if player_navmesh == null return;

        ok := player_navmesh.rebuild_immediately();
        if !ok {
            player_navmesh.mark_for_rebuild();
            log_info("Player navmesh immediate rebuild failed; scheduled deferred rebuild.", {});
        }
    }

    rebuild_player_navmesh_for_scene_transition :: method() {
        if player_navmesh == null return;

        // Schedule a follow-up rebuild after visibility/collider changes settle.
        player_navmesh.mark_for_rebuild();

        ok := player_navmesh.rebuild_immediately();
        if !ok {
            log_info("Scene transition navmesh immediate rebuild failed; deferred rebuild scheduled.", {});
        }

        player_navmesh.mark_for_rebuild();
    }

    lock_player_to_navmesh :: method(player: Player) {
        if player == null return;

        agent := player.entity.get_component(Movement_Agent);
        if agent == null return;

        // Null clears navmesh lock, so editor assignment controls behavior.
        agent.set_navmesh_to_lock_to(player_navmesh);
    }

    apply_navmesh_lock_to_all_players :: method() {
        foreach player: component_iterator(Player) {
            lock_player_to_navmesh(player);
        }
    }

    get_island_entity :: method(island_number: int) -> Entity {
        island_index := island_number - 1;
        if island_index < 0 return null;
        if island_index >= Islands.count return null;
        return Islands[island_index];
    }

    get_supply_drop_spawn_entity :: method(island_number: int) -> Entity {
        supply_drop_index := island_number - 1;
        if supply_drop_index < 0 return null;
        if supply_drop_index >= SupplyDrops.count return null;
        return SupplyDrops[supply_drop_index];
    }

    get_boss_prefab_path_for_island :: method(island_number: int) -> string {
        switch island_number {
            case 1: if Island1BossMob.count > 0 return Island1BossMob;
            case 2: if Island2BossMob.count > 0 return Island2BossMob;
            case 3: if Island3BossMob.count > 0 return Island3BossMob;
            case 4: if Island4BossMob.count > 0 return Island4BossMob;
            case 5: if Island5BossMob.count > 0 return Island5BossMob;
        }

        return ReaperPrefab;
    }

    get_boss_spawn_point_for_island :: method(island_number: int) -> Entity {
        switch island_number {
            case 1: return island1_boss_spawn_point;
            case 2: return island2_boss_spawn_point;
            case 3: return island3_boss_spawn_point;
            case 4: return island4_boss_spawn_point;
            case 5: return island5_boss_spawn_point;
        }

        return null;
    }

    get_nightly_boss_prefab_path_for_island :: method(island_number: int) -> string {
        switch island_number {
            case 1: return Island1BossMob;
            case 2: return Island2BossMob;
            case 3: return Island3BossMob;
            case 4: return Island4BossMob;
        }

        return "";
    }

    get_survivor_spawn_positions_for_island :: method(island_number: int) -> []Entity {
        switch island_number {
            case 1: return Island1SurvivorSpawnPositions;
            case 2: return Island2SurvivorSpawnPositions;
            case 3: return Island3SurvivorSpawnPositions;
            case 4: return Island4SurvivorSpawnPositions;
        }
        return Island1SurvivorSpawnPositions;
    }

    get_current_player_island_number :: method() -> int {
        if loaded_island > 0 {
            return loaded_island;
        }
        if Island > 0 {
            return Island;
        }
        return 1;
    }

    spawn_survivors_for_run :: method() {
        if !Game.is_server() return;

        despawn_all_survivors_for_restart();

        if SurvivorPrefab.count <= 0 {
            log_info("Survivor round start skipped: SurvivorPrefab is empty.", {});
            return;
        }

        prefab := get_asset(Prefab_Asset, SurvivorPrefab);
        if prefab == null {
            log_info("Survivor round start skipped: prefab missing at '%'.", {SurvivorPrefab});
            return;
        }

        survivor_rng := get_run_rng(RUN_RNG_STREAM_SURVIVOR);
        total_spawned: s64 = 0;
        total_spawned += spawn_survivors_for_island(ref survivor_rng, 1, Island1SurvivorSpawnPositions, prefab);
        total_spawned += spawn_survivors_for_island(ref survivor_rng, 2, Island2SurvivorSpawnPositions, prefab);
        total_spawned += spawn_survivors_for_island(ref survivor_rng, 3, Island3SurvivorSpawnPositions, prefab);
        total_spawned += spawn_survivors_for_island(ref survivor_rng, 4, Island4SurvivorSpawnPositions, prefab);

        if total_spawned > 0 {
            log_info("Survivor round start complete: spawned % survivor(s).", {total_spawned});
        }
    }

    spawn_survivors_for_island :: method(rng: ref u64, island_number: int, spawn_slots: []Entity, prefab: Prefab_Asset) -> s64 {
        if prefab == null return 0;
        if spawn_slots.count <= 0 return 0;

        available_slots: [..]Entity;
        for slot: spawn_slots {
            if slot == null continue;
            available_slots.append(slot);
        }

        if available_slots.count <= 0 return 0;

        spawn_count := min(SURVIVORS_PER_ISLAND, available_slots.count);
        spawned_count: s64 = 0;
        while spawned_count < spawn_count {
            slot_index := rng_range_int(ref rng, 0, available_slots.count - 1).(s64);
            slot := available_slots[slot_index];
            available_slots.unordered_remove_by_index(slot_index);

            survivor_entity := Scene.instantiate(prefab);
            if survivor_entity == null {
                continue;
            }

            survivor_entity.set_parent(slot, false);
            survivor_entity.set_local_position({0.0, 0.0});
            active_survivor_entities.append(survivor_entity);
            spawned_count += 1;
        }

        if spawned_count > 0 {
            log_info("Spawned % survivor(s) for island %.", {spawned_count, island_number});
        }
        return spawned_count;
    }

    despawn_all_survivors_for_restart :: method() {
        if !Game.is_server() return;

        removed_count: s64 = 0;
        for survivor_entity: active_survivor_entities {
            if survivor_entity == null continue;
            if !#alive(survivor_entity) continue;
            survivor_entity.destroy();
            removed_count += 1;
        }
        active_survivor_entities.clear();

        if removed_count > 0 {
            log_info("Game cleanup despawned % survivor(s).", {removed_count});
        }
    }

    get_beacon_spawn_position_for_island :: method(island_number: int) -> v2, bool {
        island_entity := get_island_entity(island_number);
        island_pos: v2 = {0.0, 0.0};
        if island_entity != null {
            island_pos = island_entity.world_position;
        }

        closest_spawn_pos: v2 = {0.0, 0.0};
        closest_dist_sq: float = 0.0;
        found_spawn := false;

        foreach beacon_spawn: component_iterator(BeaconSpawn) {
            if beacon_spawn == null continue;
            if beacon_spawn.entity == null continue;

            spawn_pos := beacon_spawn.entity.world_position;
            if island_entity == null {
                return spawn_pos, true;
            }

            dist_sq := length_squared(spawn_pos - island_pos);
            if !found_spawn || dist_sq < closest_dist_sq {
                closest_spawn_pos = spawn_pos;
                closest_dist_sq = dist_sq;
                found_spawn = true;
            }
        }

        return closest_spawn_pos, found_spawn;
    }

    get_loaded_island_beacon_spawn_position :: method() -> v2, bool {
        pos, found := this.get_beacon_spawn_position_for_island(loaded_island);
        return pos, found;
    }

    get_transition_target_beacon_spawn_position :: method() -> v2, bool {
        pos, found := this.get_beacon_spawn_position_for_island(island_transition_target_island);
        return pos, found;
    }

    try_start_next_island_voyage :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if island_transition_active return false;
        if voyage_state != .NONE return false;

        next_island := Island + 1;
        if get_island_entity(next_island) == null {
            start_run_complete_sequence();
            return run_complete_sequence_active;
        }

        Island = next_island;
        record_island_reached_for_run(Island);
        return true;
    }

    sync_active_island_entity :: method() {
        if last_enabled_island_number == Island return;

        island_index: int = 0;
        while island_index < Islands.count {
            island_entity := Islands[island_index];
            if island_entity != null {
                island_entity.set_local_enabled(island_index == Island - 1);
            }
            island_index += 1;
        }

        last_enabled_island_number = Island;
    }

    should_show_voyage_scene :: method() -> bool {
        switch voyage_state {
            case .NONE: {
                return false;
            }
            case .TO_VOYAGE: {
                return island_transition_applied;
            }
            case .VOYAGING: {
                return true;
            }
            case .TO_ISLAND: {
                return !island_transition_disable_done;
            }
        }
        return false;
    }

    should_player_spawn_in_voyage_scene :: method() -> bool {
        return should_show_voyage_scene();
    }

    try_start_island_transition_if_needed :: method() {
        if Island == loaded_island return;
        if island_transition_active return;
        if voyage_state != .NONE return;

        target_island_entity := get_island_entity(Island);
        if target_island_entity == null {
            log_info("Island transition skipped: island % is not assigned in Islands.", {Island});
            Island = loaded_island;
            return;
        }

        island_transition_active = true;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_start_time = get_time();
        island_transition_target_island = Island;
        voyage_state = .TO_VOYAGE;
        log_info("Island transition started: % -> %.", {loaded_island, island_transition_target_island});
    }

    update_island_transition :: method() {
        if !island_transition_active return;

        elapsed := get_time() - island_transition_start_time;
        if !island_transition_disable_done && elapsed >= ISLAND_TRANSITION_FADE_OUT_SECONDS {
            switch voyage_state {
                case .TO_VOYAGE: {
                    if Game.is_server() {
                        destroy_all_mobs_for_game_over();
                        despawn_all_dropped_items_for_game_over();
                    }
                }
                case .TO_ISLAND: {
                    if Game.is_server() && voyage_returning_after_destruction {
                        destroy_all_mobs_for_game_over();
                    }
                }
                case .VOYAGING: {
                }
                case .NONE: {
                }
            }
            island_transition_disable_done = true;
            return;
        }

        if island_transition_disable_done && !island_transition_applied {
            switch voyage_state {
                case .TO_VOYAGE: {
                    island_transition_applied = true;
                    rebuild_player_navmesh_for_scene_transition();
                    teleport_all_players_to_voyage_scene();
                }
                case .TO_ISLAND: {
                    reached_next_island := !voyage_returning_after_destruction && island_transition_target_island > loaded_island;
                    loaded_island = island_transition_target_island;
                    island_transition_applied = true;
                    rebuild_player_navmesh_for_scene_transition();
                    teleport_all_players_near_beacon_for_island_transition();
                    if reached_next_island {
                        apply_auto_beacon_level_for_island(loaded_island);
                        GameProgressTracking.increment_all_players_island_reached(loaded_island);
                    }
                }
                case .VOYAGING: {
                    island_transition_applied = true;
                }
                case .NONE: {
                    island_transition_applied = true;
                }
            }
        }

        total_time := ISLAND_TRANSITION_FADE_OUT_SECONDS +
            ISLAND_TRANSITION_BLACK_HOLD_SECONDS +
            ISLAND_TRANSITION_FADE_IN_SECONDS;
        if elapsed < total_time return;

        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_start_time = 0.0;
        switch voyage_state {
            case .TO_VOYAGE: {
                voyage_state = .VOYAGING;
                voyage_timer_start_time = get_time();
                VoyageHealth = VOYAGE_STARTING_HEALTH;
            }
            case .TO_ISLAND: {
                voyage_state = .NONE;
                island_transition_target_island = loaded_island;
                voyage_returning_after_destruction = false;
            }
            case .VOYAGING: {
            }
            case .NONE: {
            }
        }
        log_info("Island transition finished on island %.", {loaded_island});
    }

    sync_island_transition_freeze_state :: method() {
        if island_transition_freeze_applied == island_transition_active return;

        island_transition_freeze_applied = island_transition_active;
        foreach player: component_iterator(Player) {
            if player == null continue;
            if island_transition_active {
                player.add_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
            } else {
                player.remove_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
            }
        }
    }

    get_current_beacon_position :: method() -> v2 {
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.entity == null continue;
            return beacon.entity.world_position;
        }

        beacon_spawn_pos, found_beacon_spawn := this.get_loaded_island_beacon_spawn_position();
        if found_beacon_spawn {
            return beacon_spawn_pos;
        }

        island_entity := get_island_entity(loaded_island);
        if island_entity != null {
            return island_entity.world_position;
        }
        return entity.world_position;
    }

    get_island_transition_beacon_position :: method() -> v2 {
        beacon_spawn_pos, found_beacon_spawn := this.get_transition_target_beacon_spawn_position();
        if found_beacon_spawn {
            return beacon_spawn_pos;
        }

        island_entity := get_island_entity(island_transition_target_island);
        if island_entity != null {
            return island_entity.world_position;
        }
        return entity.world_position;
    }

    sample_player_position_near_beacon :: method(player: Player) -> v2 {
        center := get_current_beacon_position();
        rng: u64 = rng_seed(player.entity.id);
        advance_count := max(loaded_island, 1);
        angle: float = 0.0;
        radius_t: float = 0.0;
        advance_step: int = 0;
        while advance_step < advance_count {
            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            advance_step += 1;
        }

        desired_pos := v2{
            center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
            center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
        };

        navmesh := player_navmesh;
        if navmesh == null {
            return desired_pos;
        }

        hint_as_int: int = 0;
        attempt: int = 0;
        while attempt < ISLAND_TRANSITION_PLAYER_SPAWN_SAMPLE_ATTEMPTS {
            spawn_pos: v2;
            if navmesh.try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                return spawn_pos;
            }

            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            desired_pos = v2{
                center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
                center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
            };
            attempt += 1;
        }

        snapped_center: v2;
        if navmesh.try_find_closest_point_on_navmesh(center, ref snapped_center, ref hint_as_int) {
            return snapped_center;
        }
        return center;
    }

    sample_island_transition_player_position :: method(player: Player) -> v2 {
        center := get_island_transition_beacon_position();
        rng: u64 = rng_seed(player.entity.id);
        advance_count := max(island_transition_target_island, 1);
        angle: float = 0.0;
        radius_t: float = 0.0;
        advance_step: int = 0;
        while advance_step < advance_count {
            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            advance_step += 1;
        }

        desired_pos := v2{
            center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
            center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
        };

        navmesh := player_navmesh;
        if navmesh == null {
            return desired_pos;
        }

        hint_as_int: int = 0;
        attempt: int = 0;
        while attempt < ISLAND_TRANSITION_PLAYER_SPAWN_SAMPLE_ATTEMPTS {
            spawn_pos: v2;
            if navmesh.try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                return spawn_pos;
            }

            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            desired_pos = v2{
                center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
                center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
            };
            attempt += 1;
        }

        snapped_center: v2;
        if navmesh.try_find_closest_point_on_navmesh(center, ref snapped_center, ref hint_as_int) {
            return snapped_center;
        }
        return center;
    }

    teleport_all_players_near_beacon_for_island_transition :: method() {
        foreach player: component_iterator(Player) {
            if player == null continue;
            if player.entity == null continue;
            player.entity.set_local_position(sample_island_transition_player_position(player));
        }
    }

    teleport_all_players_to_voyage_scene :: method() {
        foreach player: component_iterator(Player) {
            if player == null continue;
            if player.entity == null continue;
            teleport_player_to_voyage_scene(player);
        }
    }

    start_voyage_return_transition :: method(target_island: int, caused_by_destruction: bool) {
        if current_phase != .IN_ROUND return;
        if voyage_state != .VOYAGING return;
        if island_transition_active return;

        if caused_by_destruction {
            reset_voyage_preps_for_round();
        }

        Island = target_island;
        record_island_reached_for_run(Island);
        island_transition_target_island = target_island;
        island_transition_active = true;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_start_time = get_time();
        voyage_state = .TO_ISLAND;
        voyage_returning_after_destruction = caused_by_destruction;
    }

    update_voyage_timer :: method() {
        if voyage_state != .VOYAGING return;
        if get_time() - voyage_timer_start_time < VOYAGE_DURATION_SECONDS return;

        start_voyage_return_transition(island_transition_target_island, false);
    }

    should_draw_voyage_timer :: method() -> bool {
        return current_phase == .IN_ROUND && voyage_state == .VOYAGING;
    }

    should_use_voyage_camera_zoom :: method() -> bool {
        return current_phase == .IN_ROUND && should_show_voyage_scene();
    }

    should_pause_day_night_for_voyage :: method() -> bool {
        return current_phase == .IN_ROUND && should_show_voyage_scene();
    }

    should_lock_day_night_for_final_island :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if should_pause_day_night_for_voyage() return false;
        return loaded_island >= 5;
    }

    force_day_start_for_voyage :: method() {
        clear_nightly_boss();
        if day_night_phase == .DAY &&
            day_night_phase_time_seconds == 0.0 &&
            day_night_blend == 0.0 &&
            day_night_blend_from == 0.0 &&
            day_night_blend_to == 0.0 &&
            day_night_blend_transition_time_seconds == 0.0 {
            return;
        }

        day_night_phase = .DAY;
        day_night_phase_time_seconds = 0.0;
        day_night_blend = 0.0;
        day_night_blend_from = 0.0;
        day_night_blend_to = 0.0;
        day_night_blend_transition_time_seconds = 0.0;
        play_music_track(.DAY);
    }

    force_midnight_for_final_island :: method() {
        locked_night_time_seconds := NIGHT_DURATION_SECONDS * 0.5;
        clear_nightly_boss();
        already_locked :=
            day_night_phase == .NIGHT &&
            abs(day_night_phase_time_seconds - locked_night_time_seconds) <= 0.001 &&
            day_night_blend == 1.0 &&
            day_night_blend_from == 1.0 &&
            day_night_blend_to == 1.0 &&
            day_night_blend_transition_time_seconds >= DAY_NIGHT_BLEND_TRANSITION_SECONDS &&
            current_night_event == .NONE &&
            forced_next_night_event == .NONE;
        if already_locked {
            return;
        }

        clear_active_night_event();
        forced_next_night_event = .NONE;
        last_notified_night_event = .NONE;
        day_night_phase = .NIGHT;
        day_night_phase_time_seconds = locked_night_time_seconds;
        day_night_blend = 1.0;
        day_night_blend_from = 1.0;
        day_night_blend_to = 1.0;
        day_night_blend_transition_time_seconds = DAY_NIGHT_BLEND_TRANSITION_SECONDS;
        warned_player_user_ids_for_current_day.clear();
        warned_player_entities_for_current_day.clear();
        night_warning_sfx_played_for_current_day = false;
        play_music_track(.NIGHT);
        log_info("Day/Night locked to mid-night on island %.", {loaded_island});
    }

    get_voyage_progress_t :: method() -> float {
        if voyage_state != .VOYAGING return 0.0;
        elapsed := get_time() - voyage_timer_start_time;
        return clamp(elapsed / VOYAGE_DURATION_SECONDS, 0.0, 1.0);
    }


    reset_day_night_cycle :: method() {
        day_night_phase = .DAY;
        day_night_phase_time_seconds = 0.0;
        day_night_blend = 0.0;
        day_night_blend_from = 0.0;
        day_night_blend_to = 0.0;
        day_night_blend_transition_time_seconds = 0.0;
        warned_player_user_ids_for_current_day.clear();
        warned_player_entities_for_current_day.clear();
        night_warning_sfx_played_for_current_day = false;
        play_music_track(.DAY);
        log_info("Day/Night -> DAY", {});
    }

    update_day_night_cycle :: method(dt: float) {
        if should_pause_day_night_for_voyage() {
            force_day_start_for_voyage();
            return;
        }
        if should_lock_day_night_for_final_island() {
            force_midnight_for_final_island();
            return;
        }

        day_night_phase_time_seconds += dt;

        if day_night_phase == .DAY {
            if is_night_warning_window_active() {
                if !night_warning_sfx_played_for_current_day {
                    night_warning_sfx_played_for_current_day = true;
                    if !Game.is_server() {
                        game_sfx_play(.NIGHT_WARNING);
                    }
                }
                send_night_warning();
            }

            if day_night_phase_time_seconds >= DAY_DURATION_SECONDS {
                day_night_phase = .NIGHT;
                day_night_phase_time_seconds = 0.0;
                begin_day_night_blend_transition();
                roll_and_apply_night_event();
                play_music_track(.NIGHT);
                if !Game.is_server() {
                    game_sfx_play(.NIGHT_START);
                }
                log_info("Day/Night -> NIGHT", {});
            }
            return;
        }

        if day_night_phase_time_seconds >= NIGHT_DURATION_SECONDS {
            clear_active_night_event();
            day_night_phase = .DAY;
            day_night_phase_time_seconds = 0.0;
            warned_player_user_ids_for_current_day.clear();
            warned_player_entities_for_current_day.clear();
            night_warning_sfx_played_for_current_day = false;
            apply_night_survival_progress();
            begin_day_night_blend_transition();
            grant_night_survival_currency_rewards();
            revive_dead_players_for_day_start();
            if has_reached_night_win_goal() {
                start_run_complete_sequence();
                log_info("Night goal reached (%/%). Triggering run complete.", {nights, MAX_TRACKED_SURVIVAL_NIGHT});
                return;
            }
            notify_all_players_survived_night();
            play_music_track(.DAY);
            if !Game.is_server() {
                game_sfx_play(.DAY_START);
            }
            log_info("Day/Night -> DAY (Nights: %)", {nights});
        }
    }

    sync_music_track_for_game_state :: method() {
        desired_track: Music_Track = .DAY;
        if current_phase == .IN_ROUND && day_night_phase == .NIGHT {
            desired_track = .NIGHT;
        }

        play_music_track(desired_track);
    }

    grant_night_survival_currency_rewards :: method() {
        // Currency transactions should only execute on the server.
        if !Game.is_server() return;

        reward_amount := this.get_night_survival_reward_amount();
        if reward_amount <= 0 return;

        rewarded_count: s64 = 0;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;
            if p.is_dead_for_night_state() continue;

            Economy.deposit_currency(p, SURVIVED_NIGHT_REWARD_CURRENCY, reward_amount);
            GameProgressTracking.increment_player_nights_survived(p);
            //Notifier.notify(p, SURVIVED_NIGHT_REWARD_NOTIFICATION_TEXT, {
              //  reward_amount,
              //  SURVIVED_NIGHT_REWARD_CURRENCY
            //});
            rewarded_count += 1;
        }

        log_info("Granted % % currency to % night survivor(s).", {
            reward_amount,
            SURVIVED_NIGHT_REWARD_CURRENCY,
            rewarded_count
        });
    }

    revive_dead_players_for_day_start :: method() {
        foreach p: component_iterator(Player) {
            if p == null continue;
            if !p.is_dead_for_night_state() continue;
            p.revive_for_day_start();
        }
    }

    are_all_players_dead_for_night :: method() -> bool {
        player_count: s64 = 0;
        dead_count: s64 = 0;
        foreach p: component_iterator(Player) {
            if p == null continue;
            player_count += 1;
            if p.is_dead_for_night_state() {
                dead_count += 1;
            }
        }
        if player_count <= 0 return false;
        return dead_count >= player_count;
    }

    start_game_over_sequence :: method() {
        if game_over_sequence_active return;
        if run_complete_sequence_active return;
        GameProgressTracking.increment_all_players_game_overs();
        game_over_sequence_active = true;
        game_over_sequence_restart_done = false;
        game_over_sequence_start_time = get_time();
        game_over_nights_lasted = nights;
        update_matchmaking_priority();
        if !Game.is_server() {
            game_sfx_play(.GAME_OVER);
        }
        log_info("Game Over sequence started.", {});
    }

    get_run_complete_total_duration_seconds :: method() -> float {
        return RUN_COMPLETE_REWARD_TEXT_DELAY_SECONDS + RUN_COMPLETE_POST_REWARD_WAIT_SECONDS;
    }

    start_run_complete_sequence :: method() {
        if run_complete_sequence_active return;
        if game_over_sequence_active return;
        GameProgressTracking.increment_all_players_game_wins();

        if Game.is_server() {
            prepare_lobby_for_run_complete_sequence();
            game_sfx_play(.RUN_COMPLETE);
        }
        run_complete_sequence_active = true;
        run_complete_sequence_reward_done = false;
        run_complete_sequence_start_time = get_time();
        run_complete_sequence_highest_island = max(highest_island_reached_this_run, max(Island, 1));
        run_complete_sequence_moon_reward = max((run_complete_sequence_highest_island * RUN_COMPLETE_MOON_REWARD_MULTIPLIER).(s64), 0);
        run_complete_sequence_island_line_sfx_played = false;
        run_complete_sequence_rex_line_sfx_played = false;
        run_complete_sequence_reward_line_sfx_played = false;
        run_complete_reward_user_ids.clear();
        foreach p: component_iterator(Player) {
            if p == null continue;
            user_id := p.get_user_id();
            if user_id.count <= 0 continue;
            run_complete_reward_user_ids.append(user_id);
        }
        update_matchmaking_priority();
        log_info("Run Complete sequence started on island %.", {run_complete_sequence_highest_island});
    }

    sync_run_complete_reveal_sfx :: method(elapsed: float) {
        if !Game.is_server() return;

        if !run_complete_sequence_island_line_sfx_played && elapsed >= RUN_COMPLETE_ISLAND_TEXT_DELAY_SECONDS {
            run_complete_sequence_island_line_sfx_played = true;
            game_sfx_play(.RUN_COMPLETE_STEP);
        }
        if !run_complete_sequence_rex_line_sfx_played && elapsed >= RUN_COMPLETE_REX_TEXT_DELAY_SECONDS {
            run_complete_sequence_rex_line_sfx_played = true;
            game_sfx_play(.RUN_COMPLETE_STEP);
        }
        if !run_complete_sequence_reward_line_sfx_played && elapsed >= RUN_COMPLETE_REWARD_TEXT_DELAY_SECONDS {
            run_complete_sequence_reward_line_sfx_played = true;
            game_sfx_play(.BEACON_UPGRADE);
        }
    }

    should_reward_player_for_run_complete :: method(player: Player) -> bool {
        if player == null return false;

        user_id := player.get_user_id();
        if user_id.count <= 0 return false;

        for rewarded_user_id: run_complete_reward_user_ids {
            if rewarded_user_id == user_id {
                return true;
            }
        }
        return false;
    }

    grant_run_complete_moon_rewards :: method() {
        if !Game.is_server() return;
        if run_complete_sequence_moon_reward <= 0 return;

        rewarded_count: s64 = 0;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if !should_reward_player_for_run_complete(p) continue;
            Economy.deposit_currency(p, MOON_CURRENCY, run_complete_sequence_moon_reward);
            rewarded_count += 1;
        }

        log_info("Granted % Moons to % player(s) for run completion.", {
            run_complete_sequence_moon_reward,
            rewarded_count
        });
    }

    stop_run_complete_sequence :: method() {
        run_complete_sequence_active = false;
        run_complete_sequence_reward_done = false;
        run_complete_sequence_start_time = 0.0;
        run_complete_sequence_highest_island = 0;
        run_complete_sequence_moon_reward = 0;
        run_complete_sequence_island_line_sfx_played = false;
        run_complete_sequence_rex_line_sfx_played = false;
        run_complete_sequence_reward_line_sfx_played = false;
        run_complete_reward_user_ids.clear();
        reset_local_run_complete_sfx_state();
        run_complete_freeze_applied = false;
        foreach player: component_iterator(Player) {
            if player == null continue;
            player.remove_freeze_reason(RUN_COMPLETE_FREEZE_REASON);
        }
    }

    update_run_complete_sequence :: method() {
        if !run_complete_sequence_active return;

        elapsed := get_time() - run_complete_sequence_start_time;
        sync_run_complete_reveal_sfx(elapsed);

        if !run_complete_sequence_reward_done && elapsed >= RUN_COMPLETE_REWARD_TEXT_DELAY_SECONDS {
            if Game.is_server() {
                grant_run_complete_moon_rewards();
            }
            run_complete_sequence_reward_done = true;
        }

        if elapsed < this.get_run_complete_total_duration_seconds() return;

        stop_run_complete_sequence();
        if Game.is_server() {
            run_game_over_restart();
        }
    }

    prepare_lobby_for_run_complete_sequence :: method() {
        if !Game.is_server() return;

        cleanup_world_for_game_restart();

        foreach p: component_iterator(Player) {
            if p == null continue;
            p.reset_for_game_restart();
        }

        reset_log_pages_for_full_restart();
        reset_beacons_for_full_restart();
        reset_voyage_preps_for_full_restart();
        transition_to_phase(.LOBBY);

        clear_active_night_event();
        forced_next_night_event = .NONE;
        game_time_seconds = 0.0;
        phase_time_seconds = 0.0;
        Island = 1;
        loaded_island = Island;
        island_transition_target_island = Island;
        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_freeze_applied = false;
        island_transition_start_time = 0.0;
        voyage_state = .NONE;
        voyage_timer_start_time = 0.0;
        voyage_returning_after_destruction = false;
        VoyageHealth = VOYAGE_STARTING_HEALTH;
        last_enabled_island_number = -1;
        nights = 0;
        next_raid_allowed_night_number = 0;
        active_reaper_target_player_id = 0;
        active_reaper_island_number = 0;
        clear_reaper_boss_defeat_flags();
        clear_island5_story_boss();
        sync_active_island_entity();

        foreach p: component_iterator(Player) {
            if p == null continue;
            p.remove_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
            teleport_player_to_lobby_spawn(p);
        }
    }

    update_game_over_sequence :: method() {
        if !game_over_sequence_active {
            if current_phase == .IN_ROUND && day_night_phase == .NIGHT {
                if are_all_players_dead_for_night() {
                    start_game_over_sequence();
                }
            }
            return;
        }

        elapsed := get_time() - game_over_sequence_start_time;
        if !game_over_sequence_restart_done && elapsed >= GAME_OVER_FADE_OUT_SECONDS {
            run_game_over_restart();
            game_over_sequence_restart_done = true;
        }

        fade_total_time := GAME_OVER_FADE_OUT_SECONDS + GAME_OVER_BLACK_HOLD_SECONDS + GAME_OVER_FADE_IN_SECONDS;
        total_time := max(fade_total_time, GAME_OVER_TEXT_DURATION_SECONDS);
        if elapsed >= total_time {
            game_over_sequence_active = false;
            game_over_sequence_restart_done = false;
            game_over_sequence_start_time = 0.0;
        }
    }

    run_game_over_restart :: method() {
        if !Game.is_server() return;

        cleanup_world_for_game_restart();

        foreach p: component_iterator(Player) {
            if p == null continue;
            p.reset_for_game_restart();
        }

        reset_log_pages_for_full_restart();
        reset_beacons_for_full_restart();
        reset_voyage_preps_for_full_restart();
        reset_game_state();

        foreach p: component_iterator(Player) {
            if p == null continue;
            teleport_player_to_lobby_spawn(p);
        }
    }

    cleanup_world_for_game_restart :: method() {
        if !Game.is_server() return;

        clear_reaper_event();
        clear_nightly_boss();
        despawn_all_survivors_for_restart();
        despawn_all_pois_for_transition();
        destroy_all_mobs_for_game_over();
        despawn_all_dropped_items_for_game_over();
    }

    despawn_all_pois_for_transition :: method() {
        removed_count: s64 = 0;

        foreach poi: component_iterator(POI) {
            if poi == null continue;
            if poi.spawned_entity == null continue;

            poi.destroy_spawned_entity();
            removed_count += 1;
        }

        if removed_count > 0 {
            log_info("Transition cleanup despawned % POI spawn(s).", {removed_count});
        }
    }

    destroy_all_mobs_for_game_over :: method() {
        removed_count: s64 = 0;

        foreach spawner: component_iterator(MobSpawner) {
            if spawner == null continue;
            removed_count += spawner.spawned_mobs.count;
            spawner.destroy_all_spawned_mobs();
            spawner.clear_temporary_spawn_cap_bonus();
        }

        foreach mob: component_iterator(Mob) {
            if mob == null continue;
            if mob.entity == null continue;
            if !#alive(mob.entity) continue;
            mob.entity.destroy();
            removed_count += 1;
        }

        if removed_count > 0 {
            log_info("Game Over cleanup removed % mob(s).", {removed_count});
        }
    }

    despawn_all_dropped_items_for_game_over :: method() {
        removed_count: s64 = 0;

        foreach dropped: component_iterator(Dropped_Item) {
            if dropped == null continue;
            if dropped.item != null {
                Items.destroy_item_instance(dropped.item);
                dropped.item = null;
            }
            if dropped.entity != null && #alive(dropped.entity) {
                dropped.entity.destroy();
                removed_count += 1;
            }
        }

        foreach dropped: component_iterator(Item_Drop_Magnet) {
            if dropped == null continue;
            if dropped.entity != null && #alive(dropped.entity) {
                dropped.entity.destroy();
                removed_count += 1;
            }
        }

        if removed_count > 0 {
            log_info("Game Over cleanup despawned % dropped item(s).", {removed_count});
        }
    }

    reset_beacons_for_full_restart :: method() {
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            beacon.level = 1;
            beacon.clear_stockpile();
            beacon.set_fuel_for_round(Beacon.DEFAULT_STARTING_FUEL);
            beacon.apply_level_world_state();
            beacon.refresh_prompt_text();
        }
    }

    reset_voyage_preps_for_full_restart :: method() {
        foreach prep: component_iterator(VoyagePrep) {
            if prep == null continue;
            prep.reset_for_round();
        }
    }

    send_night_warning :: method() {
        if !Game.is_server() return;
        notify_all_players_night_warning();
    }

    notify_all_players_night_warning :: method() {
        sent_to_any_player := false;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;
            if was_player_warned_this_day(p.get_user_id()) continue;
            if was_player_entity_warned_this_day(p.entity) continue;

            Notifier.notify(p, NIGHT_WARNING_NOTIFICATION_TEXT);
            warned_player_user_ids_for_current_day.append(p.get_user_id());
            warned_player_entities_for_current_day.append(p.entity);
            sent_to_any_player = true;
            log_info("Sent night warning to %", {p.get_username()});
        }
    }

    was_player_warned_this_day :: method(user_id: string) -> bool {
        for warned_id: warned_player_user_ids_for_current_day {
            if warned_id == user_id {
                return true;
            }
        }
        return false;
    }

    was_player_entity_warned_this_day :: method(player_entity: Entity) -> bool {
        for warned_entity: warned_player_entities_for_current_day {
            if warned_entity == player_entity {
                return true;
            }
        }
        return false;
    }

    notify_all_players_survived_night :: method() {
        remaining_nights := max(MAX_TRACKED_SURVIVAL_NIGHT - nights, 0);
        message := format_string(SURVIVED_NIGHT_NOTIFICATION_TEXT, {remaining_nights});
        show_broadcast_notification(message);
        log_info("Broadcasted survived-night notification (remaining: %).", {remaining_nights});
    }

    sync_run_complete_freeze_state :: method() {
        if run_complete_sequence_active {
            if run_complete_freeze_applied return;

            run_complete_freeze_applied = true;
            foreach player: component_iterator(Player) {
                if player == null continue;
                player.add_freeze_reason(RUN_COMPLETE_FREEZE_REASON);
            }
            return;
        }

        if !run_complete_freeze_applied return;

        run_complete_freeze_applied = false;
        foreach player: component_iterator(Player) {
            if player == null continue;
            player.remove_freeze_reason(RUN_COMPLETE_FREEZE_REASON);
        }
    }

    set_forced_next_night_event :: method(event_type: Night_Event_Type) {
        forced_next_night_event = event_type;
    }

    get_upcoming_night_number :: method() -> s64 {
        return nights + 1;
    }

    get_supply_drop_night_chance_percent :: method() -> float {
        return SUPPLY_DROP_NIGHTLY_CHANCE_PERCENT;
    }

    get_moon_merchant_night_chance_percent :: method() -> float {
        return MOON_MERCHANT_NIGHTLY_CHANCE_PERCENT;
    }

    get_reaper_night_chance_percent :: method(upcoming_night_number: s64) -> float {
        if upcoming_night_number < REAPER_MIN_NIGHT_NUMBER return 0.0;
        return REAPER_NIGHTLY_CHANCE_PERCENT;
    }

    mark_raid_night_triggered :: method(raid_night_number: s64) {
        next_raid_allowed_night_number = raid_night_number + RAID_COOLDOWN_NIGHTS_AFTER_TRIGGER + 1;
    }

    get_raid_night_chance_percent :: method(upcoming_night_number: s64) -> float {
        if upcoming_night_number < RAID_MIN_NIGHT_NUMBER return 0.0;
        if upcoming_night_number < next_raid_allowed_night_number return 0.0;
        if upcoming_night_number >= RAID_CHANCE_MAX_NIGHT_NUMBER return RAID_CHANCE_MAX_PERCENT;

        night_span := (RAID_CHANCE_MAX_NIGHT_NUMBER - RAID_MIN_NIGHT_NUMBER).(float);
        if night_span <= 0.0 return RAID_CHANCE_MAX_PERCENT;

        progress := (upcoming_night_number - RAID_MIN_NIGHT_NUMBER).(float) / night_span;
        return lerp(RAID_CHANCE_START_PERCENT, RAID_CHANCE_MAX_PERCENT, clamp(progress, 0.0, 1.0));
    }

    roll_and_apply_night_event :: method() {
        //if !Game.is_server() return;
        clear_active_night_event();
        current_night_event = .NONE;

        if forced_next_night_event != .NONE {
            current_night_event = forced_next_night_event;
            forced_next_night_event = .NONE;
            apply_active_night_event();
            notify_all_players_night_event_started();
            log_info("Night event forced for next night: %.", {night_event_type_to_text(current_night_event)});
            return;
        }

        upcoming_night_number := this.get_upcoming_night_number();
        raid_chance_percent := this.get_raid_night_chance_percent(upcoming_night_number);
        supply_chance_percent := this.get_supply_drop_night_chance_percent();
        reaper_chance_percent := this.get_reaper_night_chance_percent(upcoming_night_number);
        moon_merchant_chance_percent := this.get_moon_merchant_night_chance_percent();
        none_chance_percent := max(100.0 - raid_chance_percent - supply_chance_percent - reaper_chance_percent - moon_merchant_chance_percent, 0.0);
        total_chance_percent := none_chance_percent + raid_chance_percent + supply_chance_percent + reaper_chance_percent + moon_merchant_chance_percent;
        if total_chance_percent <= 0.0 return;

        roll_rng := get_run_rng(RUN_RNG_STREAM_NIGHT_EVENT, upcoming_night_number);
        roll := rng_range_float(ref roll_rng, 0.0, total_chance_percent);
        if roll < none_chance_percent {
            current_night_event = .NONE;
        } else if roll < none_chance_percent + raid_chance_percent {
            current_night_event = .RAID;
        } else if roll < none_chance_percent + raid_chance_percent + supply_chance_percent {
            current_night_event = .SUPPLY_DROP;
        } else if roll < none_chance_percent + raid_chance_percent + supply_chance_percent + reaper_chance_percent {
            current_night_event = .REAPER;
        } else {
            current_night_event = .MOON_MERCHANT;
        }

        if current_night_event == .NONE return;

        apply_active_night_event();
        notify_all_players_night_event_started();
        log_info("Night event roll applied for night %0 (raid %1%%, supply %2%%, reaper %3%%, merchant %4%%, none %5%%).", {
            upcoming_night_number,
            format_float(raid_chance_percent, decimals=2),
            format_float(supply_chance_percent, decimals=2),
            format_float(reaper_chance_percent, decimals=2),
            format_float(moon_merchant_chance_percent, decimals=2),
            format_float(none_chance_percent, decimals=2)
        });
    }

    apply_active_night_event :: method() {
        if current_night_event == .MOON_MERCHANT {
            apply_moon_merchant_event();
            return;
        }
        if !Game.is_server() return;

        switch current_night_event {
            case .RAID: {
                apply_raid_event();
            }
            case .SUPPLY_DROP: {
                apply_supply_drop_event();
            }
            case .REAPER: {
                apply_reaper_event();
            }
            case .NONE: {
            }
        }
    }

    clear_active_night_event :: method() {
        if Game.is_server() {
            clear_raid_event();
            clear_supply_drop_event();
            clear_reaper_event();
        }
        clear_moon_merchant_event();
        current_night_event = .NONE;
    }

    apply_raid_event :: method() {
        raid_night_number := this.get_upcoming_night_number();
        this.mark_raid_night_triggered(raid_night_number);

        raid_target_players: [..]Player;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;
            if p.is_dead_for_night_state() continue;
            raid_target_players.append(p);
        }

        if raid_target_players.count <= 0 {
            log_info("Night event started: RAID (no valid player targets found).", {});
            return;
        }

        raid_rng := get_run_rng(RUN_RNG_STREAM_RAID_TARGET, raid_night_number);
        retargeted_mob_count: s64 = 0;
        foreach mob: component_iterator(Mob) {
            if mob == null continue;
            if !mob.is_alive() continue;

            mob_in_range_of_any_player := false;
            for p: raid_target_players {
                if p == null continue;
                if p.entity == null continue;

                if length_squared(mob.entity.world_position - p.entity.world_position) <= RAID_RETARGET_DISTANCE * RAID_RETARGET_DISTANCE {
                    mob_in_range_of_any_player = true;
                    break;
                }
            }
            if !mob_in_range_of_any_player continue;

            target_index := rng_range_int(ref raid_rng, 0, raid_target_players.count - 1);
            target_player := raid_target_players[target_index];
            if target_player == null continue;
            if target_player.entity == null continue;

            mob.set_damage_aggro_target(target_player.entity.id);
            retargeted_mob_count += 1;
        }
        log_info("Night event started: RAID (retargeted % mobs across % players).", {
            retargeted_mob_count,
            raid_target_players.count
        });
        log_info("Next raid cannot occur before night %.", {next_raid_allowed_night_number});
    }

    clear_raid_event :: method() {
        // Raid no longer mutates persistent mob spawner state.
    }

    apply_supply_drop_event :: method() {
        if SupplyDropPrefab.count <= 0 {
            log_info("Night event Supply Drop skipped: SupplyDropPrefab is empty.", {});
            return;
        }

        prefab := get_asset(Prefab_Asset, SupplyDropPrefab);
        if prefab == null {
            log_info("Night event Supply Drop skipped: prefab missing at '%'.", {SupplyDropPrefab});
            return;
        }

        supply_drop_spawn_entity := get_supply_drop_spawn_entity(Island);
        if supply_drop_spawn_entity == null {
            log_info("Night event Supply Drop skipped: island % has no assigned SupplyDrops entry.", {Island});
            return;
        }
        spawn_pos := supply_drop_spawn_entity.world_position;

        active_supply_drop_entity = Scene.instantiate(prefab);
        if active_supply_drop_entity == null {
            log_info("Night event Supply Drop failed to instantiate prefab '%'.", {SupplyDropPrefab});
            return;
        }

        active_supply_drop_entity.set_local_position(spawn_pos);
        log_info("Night event started: SUPPLY DROP at (%, %).", {spawn_pos.x, spawn_pos.y});
    }

    clear_supply_drop_event :: method() {
        if active_supply_drop_entity != null && #alive(active_supply_drop_entity) {
            active_supply_drop_entity.destroy();
        }
        active_supply_drop_entity = null;
    }

    clear_nightly_boss :: method() {
        if active_nightly_boss_entity != null && #alive(active_nightly_boss_entity) {
            active_nightly_boss_entity.destroy();
        }
        active_nightly_boss_entity = null;
    }

    spawn_nightly_boss_for_current_state :: method() {
        island_number := Island;
        if island_number <= 0 {
            island_number = 1;
        }
        if island_number >= 5 {
            return;
        }

        prefab_path := get_nightly_boss_prefab_path_for_island(island_number);
        if prefab_path.count <= 0 {
            log_info("Nightly boss skipped: island % has no boss prefab configured.", {island_number});
            return;
        }

        prefab := get_asset(Prefab_Asset, prefab_path);
        if prefab == null {
            log_info("Nightly boss skipped: prefab missing at '%'.", {prefab_path});
            return;
        }

        spawn_point := get_boss_spawn_point_for_island(island_number);
        if spawn_point == null {
            log_info("Nightly boss skipped: island % has no boss spawn point assigned.", {island_number});
            return;
        }

        active_nightly_boss_entity = Scene.instantiate(prefab);
        if active_nightly_boss_entity == null {
            log_info("Nightly boss failed to instantiate prefab '%'.", {prefab_path});
            return;
        }

        spawn_pos := spawn_point.world_position;
        active_nightly_boss_entity.set_local_position(spawn_pos);
        log_info("Nightly boss spawned on island % at (%, %).", {
            island_number,
            spawn_pos.x,
            spawn_pos.y
        });
    }

    sync_nightly_boss_for_current_state :: method() {
        if current_phase != .IN_ROUND {
            clear_nightly_boss();
            return;
        }

        if should_pause_day_night_for_voyage() || should_lock_day_night_for_final_island() || !is_night_time() {
            clear_nightly_boss();
            return;
        }

        island_number := Island;
        if island_number >= 5 {
            clear_nightly_boss();
            return;
        }

        if active_nightly_boss_entity != null && #alive(active_nightly_boss_entity) {
            return;
        }

        current_night_number := get_upcoming_night_number();
        if last_spawned_nightly_boss_night_number == current_night_number {
            return;
        }

        last_spawned_nightly_boss_night_number = current_night_number;
        spawn_nightly_boss_for_current_state();
    }

    apply_reaper_event :: method() {
        island_number := this.get_current_player_island_number();
        if island_number <= 0 {
            island_number = max(Island, 1);
        }

        if is_reaper_boss_defeated_for_run(island_number) {
            log_info("Night event Monster skipped: island % boss already defeated this run.", {island_number});
            return;
        }

        prefab_path := get_boss_prefab_path_for_island(island_number);
        if prefab_path.count <= 0 {
            log_info("Night event Monster skipped: no boss prefab configured for island %.", {island_number});
            return;
        }

        prefab := get_asset(Prefab_Asset, prefab_path);
        if prefab == null {
            log_info("Night event Monster skipped: prefab missing at '%'.", {prefab_path});
            return;
        }

        if active_reaper_entity != null && #alive(active_reaper_entity) {
            return;
        }

        target_player := choose_reaper_boss_target_player();
        if target_player == null || target_player.entity == null {
            log_info("Night event Monster skipped: no valid player target found.", {});
            return;
        }

        spawn_pos, found_spawn_pos := sample_reaper_boss_spawn_position(island_number);
        if !found_spawn_pos {
            log_info("Night event Monster skipped: island % has no valid boss spawn position.", {island_number});
            return;
        }

        active_reaper_entity = Scene.instantiate(prefab);
        if active_reaper_entity == null {
            log_info("Night event Monster failed to instantiate prefab '%'.", {prefab_path});
            return;
        }

        active_reaper_entity.set_local_position(spawn_pos);
        active_reaper_island_number = island_number;
        assign_active_reaper_target_player(target_player);
        log_info("Night event started: MONSTER on island % targeting % at (%, %).", {
            island_number,
            target_player.get_username(),
            spawn_pos.x,
            spawn_pos.y
        });
    }

    clear_reaper_event :: method() {
        if active_reaper_entity != null && #alive(active_reaper_entity) {
            active_reaper_entity.destroy();
        }
        active_reaper_entity = null;
        active_reaper_target_player_id = 0;
        active_reaper_island_number = 0;
    }

    sync_moon_merchant_event_entity :: method() {
        if current_night_event == .MOON_MERCHANT {
            apply_moon_merchant_event();
            return;
        }
        clear_moon_merchant_event();
    }

    get_moon_merchant_spawn_center :: method() -> v2, bool {
        island_entity := get_island_entity(Island);
        if island_entity != null {
            return island_entity.world_position, true;
        }
        return {0.0, 0.0}, false;
    }

    sample_moon_merchant_spawn_position :: method() -> v2, bool {
        center, found_center := get_moon_merchant_spawn_center();
        if !found_center {
            return {0.0, 0.0}, false;
        }

        min_radius: float = 2.0;
        radius: float = 3.0;
        if radius <= 0.0 || radius <= min_radius {
            return center, true;
        }

        navmesh := player_navmesh;
        rng := get_run_rng(RUN_RNG_STREAM_MOON_MERCHANT_SPAWN, get_upcoming_night_number());

        if navmesh != null {
            radius_sq := radius * radius;
            hint_as_int: int = 0;

            for attempt: 0..moon_merchant_spawn_sample_attempts-1 {
                angle := rng_range_float(ref rng, 0.0, 6.2831853);
                radius_lerp_t := rng_range_float(ref rng, 0.0, 1.0);
                dist := lerp(min_radius, radius, radius_lerp_t);
                desired_pos := v2{
                    center.x + cos(angle) * dist,
                    center.y + sin(angle) * dist
                };

                spawn_pos: v2;
                if !navmesh.try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                    continue;
                }
                if length_squared(spawn_pos - center) <= radius_sq {
                    return spawn_pos, true;
                }
            }

            fallback_pos: v2;
            if navmesh.try_find_closest_point_on_navmesh(center, ref fallback_pos, ref hint_as_int) {
                return fallback_pos, true;
            }
        }

        angle := rng_range_float(ref rng, 0.0, 6.2831853);
        dist := lerp(min_radius, radius, rng_range_float(ref rng, 0.0, 1.0));
        return v2{
            center.x + cos(angle) * dist,
            center.y + sin(angle) * dist
        }, true;
    }

    apply_moon_merchant_event :: method() {
        if MoonMerchantPrefab.count <= 0 {
            log_info("Night event Moon Merchant skipped: MoonMerchantPrefab is empty.", {});
            return;
        }

        prefab := get_asset(Prefab_Asset, MoonMerchantPrefab);
        if prefab == null {
            log_info("Night event Moon Merchant skipped: prefab missing at '%'.", {MoonMerchantPrefab});
            return;
        }

        if Game.is_server() {
            if !moon_merchant_spawn_position_ready {
                spawn_pos, found_spawn_pos := sample_moon_merchant_spawn_position();
                if !found_spawn_pos {
                    log_info("Night event Moon Merchant skipped: no valid spawn position near the Beacon.", {});
                    return;
                }
                active_moon_merchant_spawn_position = spawn_pos;
                moon_merchant_spawn_position_ready = true;
            }
        }
        if !moon_merchant_spawn_position_ready return;

        spawn_pos := active_moon_merchant_spawn_position;

        if active_moon_merchant_entity == null || !#alive(active_moon_merchant_entity) {
            active_moon_merchant_entity = Scene.instantiate(prefab);
        }

        active_moon_merchant_entity.set_local_position(spawn_pos);
    }

    clear_moon_merchant_event :: method() {
        if active_moon_merchant_entity != null && #alive(active_moon_merchant_entity) {
            active_moon_merchant_entity.destroy();
        }
        active_moon_merchant_entity = null;
        if Game.is_server() {
            active_moon_merchant_spawn_position = {0.0, 0.0};
            moon_merchant_spawn_position_ready = false;
        }
    }

    get_reaper_boss_spawn_center :: method(island_number: int) -> v2 {
        spawn_point := get_boss_spawn_point_for_island(island_number);
        if spawn_point != null {
            return spawn_point.world_position;
        }
        if island1_spawn != null {
            return island1_spawn.world_position;
        }
        island_entity := get_island_entity(island_number);
        if island_entity != null {
            return island_entity.world_position;
        }
        return entity.world_position;
    }

    sample_reaper_boss_spawn_position :: method(island_number: int) -> v2, bool {
        navmesh := player_navmesh;
        if navmesh == null {
            return get_reaper_boss_spawn_center(island_number), true;
        }

        center := get_reaper_boss_spawn_center(island_number);
        radius_sq := ISLAND1_BOSS_SPAWN_RADIUS * ISLAND1_BOSS_SPAWN_RADIUS;
        island_spawn_index := get_upcoming_night_number() + (max(island_number - 1, 0)).(s64);
        rng := get_run_rng(RUN_RNG_STREAM_ISLAND_BOSS_SPAWN, island_spawn_index);
        hint_as_int: int = 0;

        for attempt: 0..ISLAND1_BOSS_SPAWN_SAMPLE_ATTEMPTS-1 {
            angle := rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t := sqrt(rng_range_float(ref rng, 0.0, 1.0));
            dist := radius_t * ISLAND1_BOSS_SPAWN_RADIUS;
            desired_pos := v2{
                center.x + cos(angle) * dist,
                center.y + sin(angle) * dist
            };

            spawn_pos: v2;
            if !navmesh.try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                continue;
            }
            if length_squared(spawn_pos - center) <= radius_sq {
                return spawn_pos, true;
            }
        }

        fallback_pos: v2;
        if navmesh.try_find_closest_point_on_navmesh(center, ref fallback_pos, ref hint_as_int) {
            return fallback_pos, true;
        }

        return center, false;
    }

    clear_reaper_boss_defeat_flags :: method() {
        for island_index: 0..4 {
            reaper_boss_defeated_for_run[island_index] = false;
        }
    }

    is_reaper_boss_defeated_for_run :: method(island_number: int) -> bool {
        island_index := island_number - 1;
        if island_index < 0 return false;
        if island_index >= 5 return false;
        return reaper_boss_defeated_for_run[island_index];
    }

    set_reaper_boss_defeated_for_run :: method(island_number: int, defeated: bool) {
        island_index := island_number - 1;
        if island_index < 0 return;
        if island_index >= 5 return;
        reaper_boss_defeated_for_run[island_index] = defeated;
    }

    is_valid_reaper_boss_target_player :: method(player: Player) -> bool {
        if player == null return false;
        if player.entity == null return false;
        if player.health <= 0.0 return false;
        if player.is_dead_for_night_state() return false;
        if !should_mobs_ignore_beacon_safety() && BeaconSystem.is_position_inside_active_safety_zone(player.entity.world_position) {
            return false;
        }
        return true;
    }

    choose_reaper_boss_target_player :: method() -> Player {
        valid_players: [..]Player;
        foreach p: component_iterator(Player) {
            if !is_valid_reaper_boss_target_player(p) continue;
            valid_players.append(p);
        }

        if valid_players.count <= 0 {
            return null;
        }

        reaper_target_rng := get_run_rng(RUN_RNG_STREAM_REAPER_TARGET, get_upcoming_night_number());
        target_index := rng_range_int(ref reaper_target_rng, 0, valid_players.count - 1).(s64);
        return valid_players[target_index];
    }

    assign_active_reaper_target_player :: method(player: Player) {
        active_reaper_target_player_id = 0;
        if player == null return;
        if player.entity == null return;

        active_reaper_target_player_id = player.entity.id;
        if active_reaper_entity == null return;

        boss_mob := active_reaper_entity.get_component(Mob);
        if boss_mob == null return;
        boss_mob.set_boss_target_player(player.entity.id);
    }

    update_reaper_boss_state :: method() {
        if !Game.is_server() return;
        if active_reaper_entity == null return;

        if !#alive(active_reaper_entity) {
            active_reaper_entity = null;
            active_reaper_target_player_id = 0;
            active_reaper_island_number = 0;
            return;
        }

        boss_mob := active_reaper_entity.get_component(Mob);
        if boss_mob == null return;
        if !boss_mob.is_alive() {
            if active_reaper_island_number > 0 {
                set_reaper_boss_defeated_for_run(active_reaper_island_number, true);
                log_info("Island % boss defeated for this run.", {active_reaper_island_number});
            }
            active_reaper_entity = null;
            active_reaper_target_player_id = 0;
            active_reaper_island_number = 0;
            return;
        }

        if active_reaper_target_player_id != 0 {
            foreach p: component_iterator(Player) {
                if !is_valid_reaper_boss_target_player(p) continue;
                if p.entity.id != active_reaper_target_player_id continue;
                boss_mob.set_boss_target_player(active_reaper_target_player_id);
                return;
            }
        }

        next_target := choose_reaper_boss_target_player();
        if next_target == null return;
        assign_active_reaper_target_player(next_target);
    }

    notify_all_players_night_event_started :: method() {
        if current_night_event == .NONE return;
        if current_night_event == last_notified_night_event return;

        event_name := night_event_type_to_text(current_night_event);
        message := format_string(NIGHT_EVENT_NOTIFICATION_TEXT, {event_name});
        if current_night_event == .RAID {
            message = RAID_INCOMING_NOTIFICATION_TEXT;
        } else if current_night_event == .REAPER {
            message = REAPER_NOTIFICATION_TEXT;
        } else if current_night_event == .MOON_MERCHANT {
            message = MOON_MERCHANT_NOTIFICATION_TEXT;
        }
        show_broadcast_notification(message);
        last_notified_night_event = current_night_event;
        log_info("Broadcasted night event notification: %.", {event_name});
    }

    notify_all_players_player_downed :: method(downed_player: Player) {
        if downed_player == null return;
        name := downed_player.get_username();
        if name.count <= 0 {
            name = "A player";
        }

        message := format_string(PLAYER_DOWNED_NOTIFICATION_TEXT, {name});
        if Game.is_server() {
            sent_to_any_player := false;
            foreach p: component_iterator(Player) {
                if p == null continue;
                if p.entity == null continue;

                Notifier.notify(p, message);
                sent_to_any_player = true;
            }

            if sent_to_any_player {
                log_info("Sent downed notification for %.", {name});
            }
        }
    }

    update_night_event_notifications :: method() {
        if current_night_event == .NONE {
            last_notified_night_event = .NONE;
            return;
        }
        notify_all_players_night_event_started();
    }

    is_raid_event_active :: method() -> bool {
        return current_night_event == .RAID;
    }

    is_supply_drop_event_active :: method() -> bool {
        return current_night_event == .SUPPLY_DROP;
    }

    is_reaper_event_active :: method() -> bool {
        return current_night_event == .REAPER;
    }

    can_players_damage_bosses :: method() -> bool {
        return Island >= 5;
    }

    is_moon_merchant_event_active :: method() -> bool {
        return current_night_event == .MOON_MERCHANT;
    }

    should_mobs_ignore_beacon_safety :: method() -> bool {
        return current_night_event == .RAID;
    }

    get_supply_drop_arrow_target :: method() -> v2, bool {
        if current_night_event != .SUPPLY_DROP return {0.0, 0.0}, false;

        if active_supply_drop_entity != null && #alive(active_supply_drop_entity) {
            return active_supply_drop_entity.world_position, true;
        }

        supply_drop_spawn_entity := get_supply_drop_spawn_entity(Island);
        if supply_drop_spawn_entity != null {
            return supply_drop_spawn_entity.world_position, true;
        }

        return {0.0, 0.0}, false;
    }

    should_draw_island5_story_boss_arrow :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if should_show_voyage_scene() return false;
        if get_current_player_island_number() != 5 return false;
        if has_log_page_for_run(ISLAND5_BOSS_LOG_PAGE_INDEX) return false;

        spawn_point := get_boss_spawn_point_for_island(5);
        return spawn_point != null;
    }

    get_island5_story_boss_arrow_target :: method() -> v2, bool {
        if !should_draw_island5_story_boss_arrow() return {0.0, 0.0}, false;

        spawn_point := get_boss_spawn_point_for_island(5);
        if spawn_point == null return {0.0, 0.0}, false;
        return spawn_point.world_position, true;
    }

    try_begin_island5_story_boss_spawn :: method() {
        if island5_story_boss_defeat_handled return;
        if island5_story_boss_spawn_triggered return;

        island5_story_boss_spawn_triggered = true;
        island5_story_boss_spawn_time_seconds = get_time() + ISLAND5_BOSS_SPAWN_DELAY_SECONDS;
        log_info("Island 5 story boss spawn queued for % seconds from now.", {ISLAND5_BOSS_SPAWN_DELAY_SECONDS});
    }

    clear_island5_story_boss :: method() {
        if active_island5_story_boss_entity != null && #alive(active_island5_story_boss_entity) {
            active_island5_story_boss_entity.destroy();
        }

        active_island5_story_boss_entity = null;
        island5_story_boss_spawn_triggered = false;
        island5_story_boss_spawn_time_seconds = 0.0;
        island5_story_boss_defeat_handled = false;
    }

    spawn_island5_story_boss :: method() {
        if !Game.is_server() return;
        if active_island5_story_boss_entity != null && #alive(active_island5_story_boss_entity) return;

        if Island5BossMob.count <= 0 {
            island5_story_boss_spawn_triggered = false;
            log_info("Island 5 story boss skipped: Island5BossMob is empty.", {});
            return;
        }

        prefab := get_asset(Prefab_Asset, Island5BossMob);
        if prefab == null {
            island5_story_boss_spawn_triggered = false;
            log_info("Island 5 story boss skipped: prefab missing at '%'.", {Island5BossMob});
            return;
        }

        spawn_point := get_boss_spawn_point_for_island(5);
        if spawn_point == null {
            island5_story_boss_spawn_triggered = false;
            log_info("Island 5 story boss skipped: island 5 boss spawn point is missing.", {});
            return;
        }

        active_island5_story_boss_entity = Scene.instantiate(prefab);
        if active_island5_story_boss_entity == null {
            island5_story_boss_spawn_triggered = false;
            log_info("Island 5 story boss failed to instantiate prefab '%'.", {Island5BossMob});
            return;
        }

        island5_story_boss_spawn_triggered = false;
        active_island5_story_boss_entity.set_local_position(spawn_point.world_position);

        boss_mob := active_island5_story_boss_entity.get_component(Mob);
        if boss_mob != null {
            boss_mob.start_spawn_intro(ISLAND5_BOSS_INTRO_ANIMATION, ISLAND5_BOSS_INTRO_WAIT_SECONDS);
        }

        log_info("Island 5 story boss spawned at (%, %).", {
            spawn_point.world_position.x,
            spawn_point.world_position.y
        });
    }

    update_island5_story_boss_state :: method() {
        if current_phase != .IN_ROUND return;
        if should_show_voyage_scene() return;
        if get_current_player_island_number() != 5 return;
        if island5_story_boss_defeat_handled return;

        if active_island5_story_boss_entity != null {
            if !#alive(active_island5_story_boss_entity) {
                active_island5_story_boss_entity = null;
                return;
            } else {
                boss_mob := active_island5_story_boss_entity.get_component(Mob);
                if boss_mob != null && !boss_mob.is_alive() {
                    island5_story_boss_defeat_handled = true;
                    active_island5_story_boss_entity = null;
                    start_run_complete_sequence();
                    log_info("Island 5 story boss defeated. Triggering run complete.", {});
                    return;
                }
                return;
            }
        }

        if !has_log_page_for_run(ISLAND5_BOSS_LOG_PAGE_INDEX) return;
        if !island5_story_boss_spawn_triggered return;
        if get_time() < island5_story_boss_spawn_time_seconds return;

        spawn_island5_story_boss();
    }

    is_night_warning_window_active :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if day_night_phase != .DAY return false;

        time_until_night := DAY_DURATION_SECONDS - day_night_phase_time_seconds;
        return time_until_night > 0.0 && time_until_night <= NIGHT_WARNING_LEAD_TIME_SECONDS;
    }

    begin_day_night_blend_transition :: method() {
        day_night_blend_from = day_night_blend;
        day_night_blend_to = get_target_night_blend();
        day_night_blend_transition_time_seconds = 0.0;
    }

    smooth_day_night_visual_t :: method(t: float) -> float {
        t = clamp(t, 0.0, 1.0);
        return t * t * (3.0 - 2.0 * t);
    }

    get_visual_night_blend :: method() -> float {
        if current_phase != .IN_ROUND return 0.0;
        if run_complete_sequence_active return 0.0;
        if should_pause_day_night_for_voyage() return 0.0;
        if should_lock_day_night_for_final_island() return 1.0;

        if day_night_phase == .DAY {
            sunrise_t := smooth_day_night_visual_t(day_night_phase_time_seconds / DAY_NIGHT_BLEND_TRANSITION_SECONDS);
            sunrise_blend := lerp(POST_PROCESSING_SUNRISE_BLEND, 0.0, sunrise_t);

            dusk_start_time := max(DAY_DURATION_SECONDS - NIGHT_WARNING_LEAD_TIME_SECONDS, 0.0);
            if day_night_phase_time_seconds <= dusk_start_time {
                return sunrise_blend;
            }

            dusk_progress := (day_night_phase_time_seconds - dusk_start_time) / NIGHT_WARNING_LEAD_TIME_SECONDS;
            dusk_t := smooth_day_night_visual_t(dusk_progress);
            dusk_blend := lerp(0.0, POST_PROCESSING_SUNSET_BLEND, dusk_t);
            return max(sunrise_blend, dusk_blend);
        }

        sunset_t := smooth_day_night_visual_t(day_night_phase_time_seconds / DAY_NIGHT_BLEND_TRANSITION_SECONDS);
        sunset_blend := lerp(POST_PROCESSING_SUNSET_BLEND, 1.0, sunset_t);

        dawn_start_time := max(NIGHT_DURATION_SECONDS - DAY_NIGHT_BLEND_TRANSITION_SECONDS, 0.0);
        if day_night_phase_time_seconds < dawn_start_time {
            return sunset_blend;
        }

        dawn_progress := (day_night_phase_time_seconds - dawn_start_time) / DAY_NIGHT_BLEND_TRANSITION_SECONDS;
        dawn_t := smooth_day_night_visual_t(dawn_progress);
        dawn_blend := lerp(1.0, POST_PROCESSING_SUNRISE_BLEND, dawn_t);
        return min(sunset_blend, dawn_blend);
    }

    apply_day_night_post_processing :: method() {
        visual_night_blend := get_visual_night_blend();

        color_grade := Post_Processing.Color_Grade_Config{
            color_filter = v3{
                lerp(1.0, 0.83, visual_night_blend),
                lerp(1.0, 0.88, visual_night_blend),
                lerp(1.0, 1.06, visual_night_blend)
            },
            saturation = lerp(1.0, 0.82, visual_night_blend),
            contrast = lerp(1.0, 1.12, visual_night_blend)
        };
        Post_Processing.color_grade(color_grade);

        bloom := Post_Processing.Bloom_Config{
            bloom_amount = lerp(0.0, 0.08, visual_night_blend)
        };
        Post_Processing.bloom(bloom);

        vignette := Post_Processing.Vignette_Config{
            radius = lerp(2.0, 1.45, visual_night_blend),
            softness = lerp(1.0, 0.72, visual_night_blend)
        };
        Post_Processing.vignette(vignette);

        film_grain := Post_Processing.Film_Grain_Config{
            strength = lerp(0.0, 0.018, visual_night_blend),
            noise_scale = lerp(1.0, 1.5, visual_night_blend)
        };
        Post_Processing.film_grain(film_grain);

        chromatic_aberration := Post_Processing.Chromatic_Aberration_Config{
            channel_offsets = v3{
                lerp(0.0, 0.0005, visual_night_blend),
                0.0,
                lerp(0.0, -0.0005, visual_night_blend)
            },
            focal_point = v2{0.5, 0.5}
        };
        Post_Processing.chromatic_aberration(chromatic_aberration);
    }

    update_day_night_blend :: method(dt: float) {
        day_night_blend_transition_time_seconds += dt;
        t := clamp(day_night_blend_transition_time_seconds / DAY_NIGHT_BLEND_TRANSITION_SECONDS, 0.0, 1.0);
        day_night_blend = lerp(day_night_blend_from, day_night_blend_to, t);
    }

    get_target_night_blend :: method() -> float {
        if day_night_phase == .NIGHT return 1.0;
        return 0.0;
    }

    is_night_time :: method() -> bool {
        if should_pause_day_night_for_voyage() return false;
        return day_night_phase == .NIGHT;
    }

    get_night_blend :: method() -> float {
        return get_visual_night_blend();
    }

    get_day_alpha_target :: method() -> float {
        return 1.0 - get_visual_night_blend();
    }

    get_day_night_clock_hours :: method() -> float {
        if current_phase != .IN_ROUND {
            return 0.0;
        }
        if should_pause_day_night_for_voyage() {
            return 0.0;
        }

        if day_night_phase == .DAY {
            t := clamp(day_night_phase_time_seconds / DAY_DURATION_SECONDS, 0.0, 1.0);
            return t * 12.0;
        }

        t := clamp(day_night_phase_time_seconds / NIGHT_DURATION_SECONDS, 0.0, 1.0);
        return 12.0 + t * 12.0;
    }

    update_round_start_sequence :: method() {
        if current_phase != .IN_ROUND return;
        if round_start_teleport_done return;
        if phase_time_seconds < ROUND_START_FADE_OUT_SECONDS return;

        round_start_teleport_done = true;
        teleport_all_players_to_island1_spawn();
    }

    get_round_start_overlay_alpha :: method() -> float {
        if current_phase != .IN_ROUND return 0.0;

        fade_out_end := ROUND_START_FADE_OUT_SECONDS;
        black_hold_end := fade_out_end + ROUND_START_BLACK_HOLD_SECONDS;
        fade_in_end := black_hold_end + ROUND_START_FADE_IN_SECONDS;

        if phase_time_seconds <= fade_out_end {
            return clamp(phase_time_seconds / ROUND_START_FADE_OUT_SECONDS, 0.0, 1.0);
        }

        if phase_time_seconds <= black_hold_end {
            return 1.0;
        }

        if phase_time_seconds <= fade_in_end {
            fade_in_t := clamp((phase_time_seconds - black_hold_end) / ROUND_START_FADE_IN_SECONDS, 0.0, 1.0);
            return 1.0 - fade_in_t;
        }

        return 0.0;
    }

    get_game_over_overlay_alpha :: method() -> float {
        if !game_over_sequence_active return 0.0;

        elapsed := get_time() - game_over_sequence_start_time;
        fade_out_end := GAME_OVER_FADE_OUT_SECONDS;
        black_hold_end := fade_out_end + GAME_OVER_BLACK_HOLD_SECONDS;
        fade_in_end := black_hold_end + GAME_OVER_FADE_IN_SECONDS;

        if elapsed <= fade_out_end {
            return clamp(elapsed / GAME_OVER_FADE_OUT_SECONDS, 0.0, 1.0);
        }

        if elapsed <= black_hold_end {
            return 1.0;
        }

        if elapsed <= fade_in_end {
            fade_in_t := clamp((elapsed - black_hold_end) / GAME_OVER_FADE_IN_SECONDS, 0.0, 1.0);
            return 1.0 - fade_in_t;
        }

        return 0.0;
    }

    get_run_complete_overlay_alpha :: method() -> float {
        if !run_complete_sequence_active return 0.0;

        elapsed := get_time() - run_complete_sequence_start_time;
        total_time := this.get_run_complete_total_duration_seconds();
        fade_out_start := max(total_time - RUN_COMPLETE_OVERLAY_FADE_OUT_SECONDS, RUN_COMPLETE_OVERLAY_FADE_IN_SECONDS);

        if elapsed <= RUN_COMPLETE_OVERLAY_FADE_IN_SECONDS {
            return clamp(elapsed / RUN_COMPLETE_OVERLAY_FADE_IN_SECONDS, 0.0, 1.0) * RUN_COMPLETE_OVERLAY_MAX_ALPHA;
        }

        if elapsed >= fade_out_start {
            fade_out_t := clamp((elapsed - fade_out_start) / RUN_COMPLETE_OVERLAY_FADE_OUT_SECONDS, 0.0, 1.0);
            return (1.0 - fade_out_t) * RUN_COMPLETE_OVERLAY_MAX_ALPHA;
        }

        return RUN_COMPLETE_OVERLAY_MAX_ALPHA;
    }

    get_island_transition_overlay_alpha :: method() -> float {
        if !island_transition_active return 0.0;

        elapsed := get_time() - island_transition_start_time;
        fade_out_end := ISLAND_TRANSITION_FADE_OUT_SECONDS;
        black_hold_end := fade_out_end + ISLAND_TRANSITION_BLACK_HOLD_SECONDS;
        fade_in_end := black_hold_end + ISLAND_TRANSITION_FADE_IN_SECONDS;

        if elapsed <= fade_out_end {
            return clamp(elapsed / ISLAND_TRANSITION_FADE_OUT_SECONDS, 0.0, 1.0);
        }

        if elapsed <= black_hold_end {
            return 1.0;
        }

        if elapsed <= fade_in_end {
            fade_in_t := clamp((elapsed - black_hold_end) / ISLAND_TRANSITION_FADE_IN_SECONDS, 0.0, 1.0);
            return 1.0 - fade_in_t;
        }

        return 0.0;
    }

    should_draw_game_over_text :: method() -> bool {
        if !game_over_sequence_active return false;
        elapsed := get_time() - game_over_sequence_start_time;
        return elapsed <= GAME_OVER_TEXT_DURATION_SECONDS;
    }

    should_draw_run_complete_text :: method() -> bool {
        if !run_complete_sequence_active return false;
        elapsed := get_time() - run_complete_sequence_start_time;
        return elapsed <= this.get_run_complete_total_duration_seconds();
    }

    get_run_complete_sequence_elapsed_seconds :: method() -> float {
        if !run_complete_sequence_active return 0.0;
        return get_time() - run_complete_sequence_start_time;
    }

    get_run_complete_highest_island :: method() -> int {
        return run_complete_sequence_highest_island;
    }

    get_run_complete_moon_reward_amount :: method() -> s64 {
        return run_complete_sequence_moon_reward;
    }

    get_game_over_nights_lasted :: method() -> s64 {
        return game_over_nights_lasted;
    }

    should_draw_round_start_text :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if !round_start_teleport_done return false;
        text_start_time := ROUND_START_FADE_OUT_SECONDS;
        text_end_time := text_start_time + ROUND_START_TEXT_DURATION_SECONDS;
        return phase_time_seconds >= text_start_time && phase_time_seconds <= text_end_time;
    }

    try_auto_start_from_lobby :: method() {
        if current_phase != .LOBBY return;
        if game_over_sequence_active return;
        if run_complete_sequence_active return;

        player_count := get_player_count();
        if player_count < PLAYERS_REQUIRED_TO_START return;

        log_info("Auto-starting game at %/% players.", {player_count, PLAYERS_REQUIRED_TO_START});
        start_game();
    }

    update_damage_numbers :: method(dt: float) {
        i: s64 = 0;
        while i < damage_numbers.count {
            dn := damage_numbers[i];
            if dn == null {
                damage_numbers.ordered_remove_by_index(i);
                continue;
            }

            dn.T += dt;
            if dn.T >= damage_number_lifetime_seconds {
                damage_numbers.ordered_remove_by_index(i);
                continue;
            }

            dn.Position.y += damage_number_rise_speed * dt;
            if dn.DoingFading {
                fade_t := clamp(dn.T / damage_number_lifetime_seconds, 0.0, 1.0);
                dn.Color.w = 1.0 - fade_t;
            }

            damage_numbers[i] = dn;
            i += 1;
        }
    }

    draw_damage_numbers :: method() {
        if damage_numbers.count <= 0 return;

        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        for dn: damage_numbers {
            if dn == null continue;

            ts := dn.TextSettings;
            if ts.size <= 0.0 {
                ts = UI.default_text_settings();
                ts.size = 0.30;
                ts.halign = .CENTER;
                ts.valign = .CENTER;
                ts.do_outline = true;
                ts.outline_thickness = 2;
                ts.outline_color = {0, 0, 0, 1};
            }
            ts.color = dn.Color;
            if dn.SpaceText {
                ts.spacing_multiplier = 1.1;
            }

            text_pos := dn.Position;
            text_rect := Rect{text_pos, text_pos}.grow(0.12, 0.42, 0.12, 0.42);
            UI.push_z(text_pos.y - 0.0002);
            UI.text(text_rect, ts, dn.Text);
            UI.pop_z();
        }
    }
}
