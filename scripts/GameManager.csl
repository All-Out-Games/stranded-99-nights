g_game_manager: GameManager;

DamageNumbers :: class {
    Text: string;
    Position: v2;
    Color: v4;
    T: float;
    TextSettings: Text_Settings;
    SpaceText: bool;
    DoingFading: bool;
    LastPosition: v2;
}

Game_Phase :: enum {
    LOBBY;
    IN_ROUND;
    POST_ROUND;
}

Day_Night_Phase :: enum {
    DAY;
    NIGHT;
}

Night_Event_Type :: enum {
    NONE;
    RAID;
    SUPPLY_DROP;
}

night_event_type_to_text :: proc(event_type: Night_Event_Type) -> string {
    switch event_type {
        case .RAID:        return "Raid";
        case .SUPPLY_DROP: return "Supply Drop";
        case .NONE:        return "None";
    }
    return "None";
}

Music_Track :: enum {
    NONE;
    DAY;
    NIGHT;
}

Voyage_State :: enum {
    NONE;
    TO_VOYAGE;
    VOYAGING;
    TO_ISLAND;
}

g_start_music_sound_id: u64;

Game_Sfx_Event :: enum {
    NONE;
    ROUND_START;
    NIGHT_START;
    DAY_START;
    GAME_OVER;
    RESOURCE_GATHER;
    ITEM_PICKUP;
    UI_CLICK;
    UI_ERROR;
    CRAFT_SUCCESS;
    CHEST_OPEN;
    ITEM_DROP;
    BEACON_UPGRADE;
    NIGHT_WARNING;
    REVIVE;
    DEATH;
    MOB_ATTACK;
    DAMAGE_HIT;
    DODGE_ROLL;
}

game_sfx_path_for_event :: proc(event: Game_Sfx_Event) -> string {
    switch event {
        case .ROUND_START:     return "fight_start.wav";
        case .NIGHT_START:     return "Unknown/night_time_change.wav";
        case .DAY_START:       return "Music/day_night_change.wav";
        case .GAME_OVER:       return "decline_fight.wav";
        case .RESOURCE_GATHER: return "SFX/gather_material.wav";
        case .ITEM_PICKUP:     return "pickup_item.wav";
        case .UI_CLICK:        return "ui_click.wav";
        case .UI_ERROR:        return "Unknown/ui_error.wav";
        case .CRAFT_SUCCESS:   return "SFX/craft_item.wav";
        case .CHEST_OPEN:      return "chest_open.wav";
        case .ITEM_DROP:       return "SFX/drop_item.wav";
        case .BEACON_UPGRADE:  return "reward.wav";
        case .NIGHT_WARNING:   return "Music/icicle_warning.wav";
        case .REVIVE:          return "SFX/revive.wav";
        case .DEATH:           return "SFX/death.wav";
        case .MOB_ATTACK:      return "slime_attack.wav";
        case .DAMAGE_HIT:      return "bullet_bodyimpact.wav";
        case .DODGE_ROLL:      return "SFX/dodge_roll.wav";
        case .NONE:            return "";
    }
    return "";
}

game_sfx_default_volume_for_event :: proc(event: Game_Sfx_Event) -> float {
    switch event {
        case .ROUND_START:     return 0.40;
        case .NIGHT_START:     return 0.35;
        case .DAY_START:       return 0.30;
        case .GAME_OVER:       return 0.45;
        case .RESOURCE_GATHER: return 0.28;
        case .ITEM_PICKUP:     return 0.35;
        case .UI_CLICK:        return 0.30;
        case .UI_ERROR:        return 0.35;
        case .CRAFT_SUCCESS:   return 0.45;
        case .CHEST_OPEN:      return 0.45;
        case .ITEM_DROP:       return 0.30;
        case .BEACON_UPGRADE:  return 0.50;
        case .NIGHT_WARNING:   return 0.45;
        case .REVIVE:          return 0.45;
        case .DEATH:           return 0.45;
        case .MOB_ATTACK:      return 0.40;
        case .DAMAGE_HIT:      return 0.35;
        case .DODGE_ROLL:      return 0.40;
        case .NONE:            return 0.35;
    }
    return 0.35;
}

game_sfx_play :: proc(event: Game_Sfx_Event, follow_entity: Entity = null, volume_scale: float = 1.0) {
    if event == .NONE return;
    if event == .NIGHT_WARNING && Game.is_server() return;

    path := game_sfx_path_for_event(event);
    if path.count <= 0 return;

    sfx := get_asset(SFX_Asset, path);
    if sfx == null return;

    desc := SFX.default_sfx_desc();
    desc.channel = .SFX;
    if follow_entity != null {
        desc.entity_to_follow = follow_entity.id;
    }
    desc.volume = clamp(game_sfx_default_volume_for_event(event) * max(volume_scale, 0.0), 0.0, 1.0);
    SFX.play(sfx, desc);
}

get_game_manager :: proc() -> GameManager {
    return g_game_manager;
}

ensure_game_manager_exists :: proc() -> GameManager {
    if g_game_manager != null return g_game_manager;

    foreach manager: component_iterator(GameManager) {
        g_game_manager = manager;
        break;
    }

    if g_game_manager == null {
        entity := Scene.create_entity();
        g_game_manager = entity->add_component(GameManager);
        log_info("GameManager singleton created at runtime.", {});
    }

    return g_game_manager;
}

try_force_start_game :: proc(player: Player, source: string) {
    if !Game.is_server() return;

    manager := ensure_game_manager_exists();
    if manager == null {
        if player != null {
            //Notifier.notify(player, "GameManager is unavailable.");
        }
        return;
    }

    if manager->is_round_active() {
        if player != null {
            //Notifier.notify(player, "Round is already active.");
        }
        return;
    }

    manager->start_game();

    if player != null {
       // Notifier.notify(player, "Forced game start.");
        log_info("% forced start_game via %", {player->get_username(), source});
    } else {
        log_info("Forced start_game via %", {source});
    }
}

start :: proc(player: Player) {
    try_force_start_game(player, "/start");
} @chat_command @youtuber

g :: proc(player: Player, item_id: string, quantity: s64 = 1) {
    if player == null return;

    if player.default_inventory == null || player.default_inventory.self == null || player.default_inventory.capacity <= 0 {
       // Notifier.notify(player, "Inventory is unavailable.");
        return;
    }

    defn := ItemManager.TryFindItem(item_id);
    if defn == null {
        defn = try_find_reusable_weapon_item_def_by_id(item_id);
    }
    if defn == null {
        //Notifier.notify(player, "Unknown item id: %", {item_id});
        return;
    }

    if quantity <= 0 {
        //Notifier.notify(player, "Quantity must be greater than 0.");
        return;
    }

    room := Items.calculate_room_in_inventory_for_item(defn, player.default_inventory);
    if room <= 0 {
       // Notifier.notify(player, "No room for %", {defn->get_name()});
        return;
    }

    give_count := quantity;
    if give_count > room {
        give_count = room;
    }

    item := Items.create_item_instance(defn, give_count);
    if item == null || item.self == null {
       // Notifier.notify(player, "Failed to create item.");
        return;
    }

    Items.move_item_to_inventory(item, player.default_inventory);
    if give_count < quantity {
       // Notifier.notify(player, "Given % x% (requested: %, limited by room)", {defn->get_name(), give_count, quantity});
        return;
    }

    //Notifier.notify(player, "Given % x%", {defn->get_name(), give_count});
} @chat_command @youtuber

island :: proc(player: Player, island_index: int) {
    if !Game.is_server() return;
    if player == null return;

    if island_index <= 0 {
        Notifier.notify(player, "Island must be greater than 0.");
        return;
    }

    manager := ensure_game_manager_exists();
    if manager == null {
        Notifier.notify(player, "GameManager is unavailable.");
        return;
    }

    manager.Island = island_index;
    //Notifier.notify(player, "Set island to %.", {island_index});
    log_info("% set island to % via /island", {player->get_username(), island_index});
} @chat_command @youtuber

beacon :: proc(player: Player, beacon_level: int) {
    if !Game.is_server() return;
    if player == null return;

    if beacon_level < 1 || beacon_level > Beacon.MAX_LEVEL {
        Notifier.notify(player, "Beacon level must be between 1 and %.", {Beacon.MAX_LEVEL});
        return;
    }

    updated_count: s64 = 0;
    next_level := beacon_level.(s64);
    foreach active_beacon: component_iterator(Beacon) {
        if active_beacon == null continue;

        active_beacon->set_beacon_level(next_level);
        updated_count += 1;
    }

    if updated_count <= 0 {
        Notifier.notify(player, "Beacon is unavailable.");
        return;
    }

    Notifier.notify(player, "Set Beacon level to %.", {next_level});
    log_info("% set beacon level to % via /beacon", {player->get_username(), next_level});
} @chat_command @youtuber

GameManager :: class : Component {

    damage_numbers: [..]DamageNumbers;
    player_navmesh: Navmesh @ao_serialize;
    lobby_spawn: Entity @ao_serialize;
    island1_spawn: Entity @ao_serialize;
    Islands: [..]Entity @ao_serialize;
    VoyageScene: Entity @ao_serialize;
    damage_number_lifetime_seconds: float @ao_serialize;
    damage_number_rise_speed: float @ao_serialize;
    
    current_phase: Game_Phase;
    game_time_seconds: float;
    phase_time_seconds: float;
    Island: int;
    loaded_island: int;
    day_night_phase: Day_Night_Phase;
    day_night_phase_time_seconds: float;
    day_night_blend: float;
    day_night_blend_from: float;
    day_night_blend_to: float;
    day_night_blend_transition_time_seconds: float;
    nights: s64;
    current_night_event: Night_Event_Type;
    raid_spawn_cap_multiplier: s64 @ao_serialize;
    night_event_min_completed_nights_before_roll: s64 @ao_serialize;
    night_event_none_weight: float @ao_serialize;
    night_event_raid_weight: float @ao_serialize;
    night_event_supply_drop_weight: float @ao_serialize;
    night_event_weight_scale_start: float @ao_serialize;
    night_event_weight_scale_gain_per_completed_night: float @ao_serialize;
    night_event_weight_scale_cap: float @ao_serialize;
    SupplyDropPrefab: string @ao_serialize;
    Island1BossMob: string @ao_serialize;
    island1_boss_spawn_point: Entity @ao_serialize;
    SupplyDrops: [..]Entity @ao_serialize;
    active_supply_drop_entity: Entity;
    active_island1_boss_entity: Entity;
    island1_boss_defeated_for_run: bool;
    island1_boss_spawns_enabled_for_run: bool;
    last_notified_night_event: Night_Event_Type;
    broadcast_notification_text: string;
    broadcast_notification_end_time: float;

    DAY_DURATION_SECONDS :: 90.0;
    NIGHT_DURATION_SECONDS :: 60.0;
    DAY_NIGHT_BLEND_TRANSITION_SECONDS :: 5.0;
    NIGHT_WARNING_LEAD_TIME_SECONDS :: 10.0;
    PLAYERS_REQUIRED_TO_START :: 3;
    NIGHT_WARNING_NOTIFICATION_TEXT :: "Night is almost here! Get back to the Beacon!";
    SURVIVED_NIGHT_NOTIFICATION_TEXT :: "You Survived the Night! % more to go!";
    SURVIVED_NIGHT_REWARD_NOTIFICATION_TEXT :: "+% % for surviving the night!";
    SURVIVED_NIGHT_REWARD_CURRENCY :: "Moons";
    SURVIVED_NIGHT_REWARD_AMOUNT :: 1;
    MAX_TRACKED_SURVIVAL_NIGHT :: 99;
    NON_NIGHT_ONLY_SPAWNER_DOUBLING_NIGHTS :: 5.0;
    NIGHT_SURVIVAL_SAVE_KEY_FORMAT :: "night_survived_%";
    NIGHT_EVENT_NOTIFICATION_TEXT :: "Night Event: %!";
    PLAYER_DOWNED_NOTIFICATION_TEXT :: "% has been downed!";
    VOYAGE_FAILED_NOTIFICATION_TEXT :: "Voyage Failed! Try Again!";
    BROADCAST_NOTIFICATION_DURATION_SECONDS :: 5.0;
    ROUND_START_FADE_OUT_SECONDS :: 1.0;
    ROUND_START_BLACK_HOLD_SECONDS :: 1.0;
    ROUND_START_FADE_IN_SECONDS :: 1.0;
    ROUND_START_TEXT_DURATION_SECONDS :: 5.0;
    ISLAND_TRANSITION_FADE_OUT_SECONDS :: 0.5;
    ISLAND_TRANSITION_BLACK_HOLD_SECONDS :: 0.75;
    ISLAND_TRANSITION_FADE_IN_SECONDS :: 0.5;
    ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS :: 4.0;
    ISLAND_TRANSITION_PLAYER_SPAWN_SAMPLE_ATTEMPTS :: 8;
    ISLAND_TRANSITION_FREEZE_REASON :: "island_transition";
    VOYAGE_DURATION_SECONDS :: 45.0;
    VOYAGE_STARTING_HEALTH :: 300.0;
    GAME_OVER_FADE_OUT_SECONDS :: 1.0;
    GAME_OVER_BLACK_HOLD_SECONDS :: 1.25;
    GAME_OVER_FADE_IN_SECONDS :: 1.0;
    GAME_OVER_TEXT_DURATION_SECONDS :: 10.0;
    ISLAND1_BOSS_SPAWN_RADIUS :: 20.0;
    ISLAND1_BOSS_SPAWN_SAMPLE_ATTEMPTS :: 8;
    DAY_MUSIC_ASSET_PATH :: "Music/WoP.wav";
    NIGHT_MUSIC_ASSET_PATH :: "Music/FtI.wav";
    LOBBY_MATCHMAKING_PRIORITY :: 1;
    IN_ROUND_MATCHMAKING_PRIORITY :: 0;
    warned_player_user_ids_for_current_day: [..]string;
    warned_player_entities_for_current_day: [..]Entity;
    round_start_teleport_done: bool;
    island_transition_active: bool;
    island_transition_disable_done: bool;
    island_transition_applied: bool;
    island_transition_freeze_applied: bool;
    island_transition_start_time: float;
    island_transition_target_island: int;
    voyage_state: Voyage_State;
    voyage_timer_start_time: float;
    voyage_returning_after_destruction: bool;
    VoyageHealth: float;
    last_enabled_island_number: int;
    game_over_sequence_active: bool;
    game_over_sequence_restart_done: bool;
    game_over_sequence_start_time: float;
    game_over_nights_lasted: s64;
    picked_up_log_page_indices: [..]int;

    ao_start :: method() {
        if g_game_manager != null && g_game_manager != this {
            log_info("Duplicate GameManager detected; destroying duplicate.", {});
            entity->destroy();
            return;
        }

        g_game_manager = this;
        if damage_number_lifetime_seconds <= 0.0 { damage_number_lifetime_seconds = 0.65; }
        if damage_number_rise_speed <= 0.0 { damage_number_rise_speed = 1.4; }
        if raid_spawn_cap_multiplier <= 1 { raid_spawn_cap_multiplier = 2; }
        if night_event_min_completed_nights_before_roll <= 0 { night_event_min_completed_nights_before_roll = 2; }
        if night_event_none_weight <= 0.0 { night_event_none_weight = 65.0; }
        if night_event_raid_weight <= 0.0 { night_event_raid_weight = 25.0; }
        if night_event_supply_drop_weight <= 0.0 { night_event_supply_drop_weight = 10.0; }
        if night_event_weight_scale_start <= 0.0 { night_event_weight_scale_start = 0.1; }
        if night_event_weight_scale_gain_per_completed_night <= 0.0 { night_event_weight_scale_gain_per_completed_night = 0.1; }
        if night_event_weight_scale_cap <= 0.0 { night_event_weight_scale_cap = 1.0; }
        last_notified_night_event = .NONE;
        reset_game_state();
        loaded_island = Island;
        island_transition_target_island = Island;
        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_freeze_applied = false;
        island_transition_start_time = 0.0;
        voyage_state = .NONE;
        voyage_timer_start_time = 0.0;
        voyage_returning_after_destruction = false;
        last_enabled_island_number = -1;
        apply_navmesh_lock_to_all_players();
        sync_active_island_entity();
        if !Game.is_server() {
            if g_start_music_sound_id == 0 {
                music_asset := get_asset(SFX_Asset, DAY_MUSIC_ASSET_PATH);
                if music_asset != null {
                    desc := SFX.default_sfx_desc();
                    desc.loop = true;
                    desc.channel = .MUSIC;
                    desc.volume = 0.35;
                    g_start_music_sound_id = SFX.play(music_asset, desc);
                } else {
                    log_info("Startup music asset missing: %", {DAY_MUSIC_ASSET_PATH});
                }
            }
        }
    }

    ao_update :: method(dt: float) {
        //if Game.is_server() {
            update_damage_numbers(dt);
       // }

        // Keep core game state authoritative on the server.
        // Music playback is client-side so each player always hears it.

        sync_active_island_entity();
        disable_island1_boss_spawns_for_current_run();
        try_start_island_transition_if_needed();
        update_island_transition();
        sync_island_transition_freeze_state();
        if island_transition_active return;
        update_voyage_timer();

        game_time_seconds += dt;
        phase_time_seconds += dt;
        update_island1_boss_state();

        switch current_phase {
            case .LOBBY: {
                // Lobby state: waiting for players/game start conditions.
                try_auto_start_from_lobby();
            }
            case .IN_ROUND: {
                // Round state: active gameplay should run here.
                update_round_start_sequence();
                update_day_night_cycle(dt);
                update_night_event_notifications();
                update_day_night_blend(dt);
            }
            case .POST_ROUND: {
                // Post round state: cleanup, score display, and reset hooks.
            }
        }

        update_game_over_sequence();

    }

    ao_late_update :: method(dt: float) {
        if Game.is_server() return;
        draw_damage_numbers();
    }

    ao_end :: method() {
        if !Game.is_server() {
            if g_start_music_sound_id != 0 {
                SFX.stop(g_start_music_sound_id);
                g_start_music_sound_id = 0;
            }
        }
        if g_game_manager == this {
            g_game_manager = null;
        }
    }

    start_game :: method() {
        transition_to_phase(.IN_ROUND);
        game_time_seconds = 0.0;
    }

    stop_game :: method() {
        transition_to_phase(.POST_ROUND);
    }

    reset_game_state :: method() {
        clear_active_night_event();
        clear_island1_boss();
        clear_broadcast_notification();
        game_time_seconds = 0.0;
        phase_time_seconds = 0.0;
        Island = 1;
        loaded_island = Island;
        island_transition_target_island = Island;
        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_freeze_applied = false;
        island_transition_start_time = 0.0;
        voyage_state = .NONE;
        voyage_timer_start_time = 0.0;
        voyage_returning_after_destruction = false;
        VoyageHealth = VOYAGE_STARTING_HEALTH;
        last_enabled_island_number = -1;
        nights = 0;
        island1_boss_defeated_for_run = false;
        island1_boss_spawns_enabled_for_run = true;
        sync_active_island_entity();
        current_phase = .LOBBY;
        on_enter_phase(current_phase);
    }

    transition_to_phase :: method(next_phase: Game_Phase) {
        if current_phase == next_phase return;

        on_exit_phase(current_phase);
        current_phase = next_phase;
        phase_time_seconds = 0.0;
        on_enter_phase(current_phase);
    }

    on_enter_phase :: method(phase: Game_Phase) {
        switch phase {
            case .LOBBY: {
                log_info("GameManager phase -> LOBBY", {});
                apply_matchmaking_priority_for_phase(phase);
            }
            case .IN_ROUND: {
                log_info("GameManager phase -> IN_ROUND", {});
                apply_matchmaking_priority_for_phase(phase);
                if !Game.is_server() {
                    game_sfx_play(.ROUND_START);
                }
                run_round_start_poi_setup();
                nights = 0;
                reset_day_night_cycle();
                current_night_event = .NONE;
                reset_beacons_for_round();
                reset_voyage_preps_for_round();
                round_start_teleport_done = false;
                game_over_sequence_active = false;
                game_over_sequence_restart_done = false;
                game_over_sequence_start_time = 0.0;
            }
            case .POST_ROUND: {
                log_info("GameManager phase -> POST_ROUND", {});
            }
        }
    }

    apply_matchmaking_priority_for_phase :: method(phase: Game_Phase) {
        if !Game.is_server() return;

        switch phase {
            case .LOBBY: {
                Server.set_matchmaking_priority(LOBBY_MATCHMAKING_PRIORITY);
            }
            case .IN_ROUND: {
                Server.set_matchmaking_priority(IN_ROUND_MATCHMAKING_PRIORITY);
            }
            case .POST_ROUND: {
                // Keep matchmaking off while post-round cleanup runs.
                Server.set_matchmaking_priority(IN_ROUND_MATCHMAKING_PRIORITY);
            }
        }
    }

    on_exit_phase :: method(phase: Game_Phase) {
        switch phase {
            case .LOBBY: {
                // Exit lobby hooks go here.
            }
            case .IN_ROUND: {
                // Exit round hooks go here.
                clear_active_night_event();
                clear_island1_boss();
                day_night_phase = .DAY;
                day_night_phase_time_seconds = 0.0;
                day_night_blend = 0.0;
                day_night_blend_from = 0.0;
                day_night_blend_to = 0.0;
                day_night_blend_transition_time_seconds = 0.0;
            }
            case .POST_ROUND: {
                // Exit post-round hooks go here.
            }
        }
    }

    start_round :: method() {
        transition_to_phase(.IN_ROUND);
    }

    end_round :: method() {
        transition_to_phase(.POST_ROUND);
    }

    go_to_lobby :: method() {
        transition_to_phase(.LOBBY);
    }

    is_round_active :: method() -> bool {
        return current_phase == .IN_ROUND;
    }

    get_phase :: method() -> Game_Phase {
        return current_phase;
    }

    get_phase_time_seconds :: method() -> float {
        return phase_time_seconds;
    }

    clear_broadcast_notification :: method() {
        broadcast_notification_text = "";
        broadcast_notification_end_time = 0.0;
    }

    show_broadcast_notification :: method(message: string) {
        if message.count <= 0 return;
        broadcast_notification_text = message;
        broadcast_notification_end_time = get_time() + BROADCAST_NOTIFICATION_DURATION_SECONDS;
    }

    should_draw_broadcast_notification :: method() -> bool {
        if broadcast_notification_text.count <= 0 return false;
        return get_time() <= broadcast_notification_end_time;
    }

    get_broadcast_notification_text :: method() -> string {
        if !should_draw_broadcast_notification() return "";
        return broadcast_notification_text;
    }

    get_game_time_seconds :: method() -> float {
        return game_time_seconds;
    }

    get_nights :: method() -> s64 {
        return nights;
    }

    get_night_survival_credit_amount :: method() -> s64 {
        if Island == 3 return 4;
        if Island == 2 return 2;
        return 1;
    }

    get_night_survival_reward_amount :: method() -> s64 {
        return this->get_night_survival_credit_amount();
    }

    apply_night_survival_progress :: method() {
        credit_amount := this->get_night_survival_credit_amount();
        if credit_amount <= 0 return;

        previous_nights := nights;
        nights += credit_amount;

        survived_night := previous_nights + 1;
        while survived_night <= nights {
            this->increment_global_night_survival_count(survived_night);
            survived_night += 1;
        }
    }

    is_voyage_damage_redirect_active :: method() -> bool {
        return current_phase == .IN_ROUND && voyage_state == .VOYAGING;
    }

    apply_voyage_damage :: method(amount: float) -> float {
        if amount <= 0.0 return 0.0;
        if !is_voyage_damage_redirect_active() return 0.0;

        absorbed := min(amount, VoyageHealth);
        if absorbed > 0.0 {
            foreach voyage_boat: component_iterator(VoyageBoat) {
                voyage_boat->trigger_damage_feedback();
            }
        }
        VoyageHealth = max(VoyageHealth - amount, 0.0);
        if VoyageHealth <= 0.0 {
            if Game.is_server() {
                show_broadcast_notification(VOYAGE_FAILED_NOTIFICATION_TEXT);
            }
            start_voyage_return_transition(loaded_island, true);
        }
        return absorbed;
    }

    should_draw_voyage_health_bar :: method() -> bool {
        return is_voyage_damage_redirect_active();
    }

    get_voyage_health_fill_t :: method() -> float {
        return clamp(VoyageHealth / VOYAGE_STARTING_HEALTH, 0.0, 1.0);
    }

    get_voyage_mob_damage :: method() -> float {
        return max((Island * 5 - 5).(float), 0.0);
    }

    should_mobs_path_to_closest_reachable_target_point :: method() -> bool {
        return current_phase == .IN_ROUND && voyage_state == .VOYAGING;
    }

    get_non_night_only_spawner_spawn_scale :: method() -> float {
        completed_nights := max(nights, 0);
        if completed_nights <= 0 return 1.0;

        return pow(2.0, completed_nights.(float) / NON_NIGHT_ONLY_SPAWNER_DOUBLING_NIGHTS);
    }

    is_tracked_survival_night :: method(night_number: s64) -> bool {
        return night_number >= 1 && night_number <= MAX_TRACKED_SURVIVAL_NIGHT;
    }

    get_night_survival_save_key :: method(night_number: s64) -> string {
        return format_string(NIGHT_SURVIVAL_SAVE_KEY_FORMAT, {night_number});
    }

    increment_global_night_survival_count :: method(night_number: s64) {
        // Only the server should write global save state.
        if !Game.is_server() return;
        if !this->is_tracked_survival_night(night_number) return;

        key := this->get_night_survival_save_key(night_number);
        Save.increment_game_int(key, 1);
    }

    get_global_night_survival_count :: method(night_number: s64) -> s64 {
        if !this->is_tracked_survival_night(night_number) return 0;

        key := this->get_night_survival_save_key(night_number);
        return Save.get_game_int(key, 0);
    }

    get_player_count :: method() -> s64 {
        player_count: s64 = 0;
        foreach p: component_iterator(Player) {
            player_count += 1;
        }
        return player_count;
    }

    get_required_players_to_start :: method() -> s64 {
        return PLAYERS_REQUIRED_TO_START;
    }

    is_private_server :: method() -> bool {
        _, is_private := Server.get_private_server_host_id();
        return is_private;
    }

    can_player_force_start_from_lobby :: method(player: Player) -> bool {
        if player == null return false;
        if current_phase != .LOBBY return false;
        if game_over_sequence_active return false;
        return true;
    }

    on_player_joined :: method(player: Player) {
        lock_player_to_navmesh(player);
        if island_transition_active && player != null {
            player->add_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
        }
        teleport_player_to_phase_spawn(player);
    }

    has_log_page_for_run :: method(log_index: int) -> bool {
        if log_index <= 0 return false;

        for acquired_index: picked_up_log_page_indices {
            if acquired_index == log_index {
                return true;
            }
        }
        return false;
    }

    acquire_log_page_for_run :: method(log_index: int) -> bool {
        if log_index <= 0 return false;
        if this->has_log_page_for_run(log_index) return false;

        picked_up_log_page_indices->append(log_index);
        i := picked_up_log_page_indices.count - 1;
        while i > 0 {
            prev_index := i - 1;
            if picked_up_log_page_indices[prev_index] <= picked_up_log_page_indices[i] {
                break;
            }

            swap := picked_up_log_page_indices[prev_index];
            picked_up_log_page_indices[prev_index] = picked_up_log_page_indices[i];
            picked_up_log_page_indices[i] = swap;
            i = prev_index;
        }
        return true;
    }

    get_picked_up_log_page_count :: method() -> int {
        return picked_up_log_page_indices.count;
    }

    get_picked_up_log_page_at :: method(display_index: int) -> int, bool {
        if display_index < 0 return 0, false;
        if display_index >= picked_up_log_page_indices.count return 0, false;
        return picked_up_log_page_indices[display_index], true;
    }

    reset_log_pages_for_full_restart :: method() {
        picked_up_log_page_indices->clear();

        foreach log_page: component_iterator(LogPage) {
            if log_page == null continue;
            log_page->reset_for_run_restart();
        }
    }

    teleport_player_to_phase_spawn :: method(player: Player) {
        if player == null return;
        if player.entity == null return;

        if current_phase == .IN_ROUND {
            if should_player_spawn_in_voyage_scene() {
                teleport_player_to_voyage_scene(player);
                return;
            }
            teleport_player_near_beacon_for_round(player);
            return;
        }

        teleport_player_to_lobby_spawn(player);
    }

    get_respawn_position_for_player :: method(player: Player) -> v2 {
        if current_phase == .IN_ROUND {
            if should_player_spawn_in_voyage_scene() {
                return get_voyage_scene_position();
            }
            if player != null && player.entity != null {
                return sample_player_position_near_beacon(player);
            }
        }

        if lobby_spawn != null {
            return lobby_spawn.world_position;
        }
        if island1_spawn != null {
            return island1_spawn.world_position;
        }
        return entity.world_position;
    }

    teleport_player_to_lobby_spawn :: method(player: Player) {
        if player == null || player.entity == null return;
        if lobby_spawn == null return;

        player.entity->set_local_position(lobby_spawn.world_position);
    }

    teleport_player_to_island1_spawn :: method(player: Player) {
        if player == null || player.entity == null return;
        if island1_spawn == null return;

        player.entity->set_local_position(island1_spawn.world_position);
    }

    teleport_all_players_to_island1_spawn :: method() {
        if island1_spawn == null return;

        foreach player: component_iterator(Player) {
            teleport_player_to_island1_spawn(player);
        }
    }

    teleport_player_near_beacon_for_round :: method(player: Player) {
        if player == null || player.entity == null return;
        player.entity->set_local_position(sample_player_position_near_beacon(player));
    }

    get_voyage_scene_position :: method() -> v2 {
        voyage_pos := v2{0.0, 0.0};
        if VoyageScene != null {
            voyage_pos = VoyageScene.world_position;
        }
        return voyage_pos;
    }

    teleport_player_to_voyage_scene :: method(player: Player) {
        if player == null || player.entity == null return;
        player.entity->set_local_position(get_voyage_scene_position());
    }

    reset_beacons_for_round :: method() {
        if !Game.is_server() return;

        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            beacon->set_fuel_for_round(Beacon.DEFAULT_STARTING_FUEL);
        }
    }

    reset_voyage_preps_for_round :: method() {
        foreach prep: component_iterator(VoyagePrep) {
            if prep == null continue;
            prep->reset_for_round();
        }
    }

    run_round_start_poi_setup :: method() {
        poi_rng := rng_seed_time();
        spawned_count: s64 = 0;
        total_count: s64 = 0;
        foreach poi: component_iterator(POI) {
            if poi == null continue;
            total_count += 1;
            if poi->spawn_for_round(ref poi_rng) {
                spawned_count += 1;
            }
        }

        if total_count > 0 {
            log_info("POI round start complete: %/% spawned.", {spawned_count, total_count});
        }

        rebuild_player_navmesh_for_round_start();
    }

    rebuild_player_navmesh_for_round_start :: method() {
        if player_navmesh == null return;

        ok := player_navmesh->rebuild_immediately();
        if !ok {
            player_navmesh->mark_for_rebuild();
            log_info("Player navmesh immediate rebuild failed; scheduled deferred rebuild.", {});
        }
    }

    rebuild_player_navmesh_for_scene_transition :: method() {
        if player_navmesh == null return;

        // Schedule a follow-up rebuild after visibility/collider changes settle.
        player_navmesh->mark_for_rebuild();

        ok := player_navmesh->rebuild_immediately();
        if !ok {
            log_info("Scene transition navmesh immediate rebuild failed; deferred rebuild scheduled.", {});
        }

        player_navmesh->mark_for_rebuild();
    }

    lock_player_to_navmesh :: method(player: Player) {
        if player == null return;

        agent := player.entity->get_component(Movement_Agent);
        if agent == null return;

        // Null clears navmesh lock, so editor assignment controls behavior.
        agent->set_navmesh_to_lock_to(player_navmesh);
    }

    apply_navmesh_lock_to_all_players :: method() {
        foreach player: component_iterator(Player) {
            lock_player_to_navmesh(player);
        }
    }

    get_island_entity :: method(island_number: int) -> Entity {
        island_index := island_number - 1;
        if island_index < 0 return null;
        if island_index >= Islands.count return null;
        return Islands[island_index];
    }

    get_supply_drop_spawn_entity :: method(island_number: int) -> Entity {
        supply_drop_index := island_number - 1;
        if supply_drop_index < 0 return null;
        if supply_drop_index >= SupplyDrops.count return null;
        return SupplyDrops[supply_drop_index];
    }

    try_start_next_island_voyage :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if island_transition_active return false;
        if voyage_state != .NONE return false;

        next_island := Island + 1;
        if get_island_entity(next_island) == null {
            log_info("Voyage start skipped: island % is not assigned in Islands.", {next_island});
            return false;
        }

        Island = next_island;
        return true;
    }

    sync_active_island_entity :: method() {
        if last_enabled_island_number == Island return;

        island_index: int = 0;
        while island_index < Islands.count {
            island_entity := Islands[island_index];
            if island_entity != null {
                island_entity->set_local_enabled(island_index == Island - 1);
            }
            island_index += 1;
        }

        last_enabled_island_number = Island;
    }

    should_show_voyage_scene :: method() -> bool {
        switch voyage_state {
            case .NONE: {
                return false;
            }
            case .TO_VOYAGE: {
                return island_transition_applied;
            }
            case .VOYAGING: {
                return true;
            }
            case .TO_ISLAND: {
                return !island_transition_disable_done;
            }
        }
        return false;
    }

    should_player_spawn_in_voyage_scene :: method() -> bool {
        return should_show_voyage_scene();
    }

    try_start_island_transition_if_needed :: method() {
        if Island == loaded_island return;
        if island_transition_active return;
        if voyage_state != .NONE return;

        target_island_entity := get_island_entity(Island);
        if target_island_entity == null {
            log_info("Island transition skipped: island % is not assigned in Islands.", {Island});
            Island = loaded_island;
            return;
        }

        island_transition_active = true;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_start_time = get_time();
        island_transition_target_island = Island;
        voyage_state = .TO_VOYAGE;
        log_info("Island transition started: % -> %.", {loaded_island, island_transition_target_island});
    }

    update_island_transition :: method() {
        if !island_transition_active return;

        elapsed := get_time() - island_transition_start_time;
        if !island_transition_disable_done && elapsed >= ISLAND_TRANSITION_FADE_OUT_SECONDS {
            switch voyage_state {
                case .TO_VOYAGE: {
                    if Game.is_server() {
                        destroy_all_mobs_for_game_over();
                        despawn_all_dropped_items_for_game_over();
                    }
                }
                case .TO_ISLAND: {
                    if Game.is_server() && voyage_returning_after_destruction {
                        destroy_all_mobs_for_game_over();
                    }
                }
                case .VOYAGING: {
                }
                case .NONE: {
                }
            }
            island_transition_disable_done = true;
            return;
        }

        if island_transition_disable_done && !island_transition_applied {
            switch voyage_state {
                case .TO_VOYAGE: {
                    island_transition_applied = true;
                    rebuild_player_navmesh_for_scene_transition();
                    teleport_all_players_to_voyage_scene();
                }
                case .TO_ISLAND: {
                    loaded_island = island_transition_target_island;
                    island_transition_applied = true;
                    rebuild_player_navmesh_for_scene_transition();
                    teleport_all_players_near_beacon_for_island_transition();
                }
                case .VOYAGING: {
                    island_transition_applied = true;
                }
                case .NONE: {
                    island_transition_applied = true;
                }
            }
        }

        total_time := ISLAND_TRANSITION_FADE_OUT_SECONDS +
            ISLAND_TRANSITION_BLACK_HOLD_SECONDS +
            ISLAND_TRANSITION_FADE_IN_SECONDS;
        if elapsed < total_time return;

        island_transition_active = false;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_start_time = 0.0;
        switch voyage_state {
            case .TO_VOYAGE: {
                voyage_state = .VOYAGING;
                voyage_timer_start_time = get_time();
                VoyageHealth = VOYAGE_STARTING_HEALTH;
            }
            case .TO_ISLAND: {
                voyage_state = .NONE;
                island_transition_target_island = loaded_island;
                voyage_returning_after_destruction = false;
            }
            case .VOYAGING: {
            }
            case .NONE: {
            }
        }
        log_info("Island transition finished on island %.", {loaded_island});
    }

    sync_island_transition_freeze_state :: method() {
        if island_transition_freeze_applied == island_transition_active return;

        island_transition_freeze_applied = island_transition_active;
        foreach player: component_iterator(Player) {
            if player == null continue;
            if island_transition_active {
                player->add_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
            } else {
                player->remove_freeze_reason(ISLAND_TRANSITION_FREEZE_REASON);
            }
        }
    }

    get_beacon_arrow_target :: method() -> v2, bool {
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.entity == null continue;
            return beacon.entity.world_position, true;
        }

        if island1_spawn != null {
            return island1_spawn.world_position, true;
        }

        return {0.0, 0.0}, false;
    }

    get_current_beacon_position :: method() -> v2 {
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.entity == null continue;
            return beacon.entity.world_position;
        }

        foreach beacon_spawn: component_iterator(BeaconSpawn) {
            if beacon_spawn == null continue;
            if beacon_spawn.entity == null continue;
            return beacon_spawn.entity.world_position;
        }

        island_entity := get_island_entity(loaded_island);
        if island_entity != null {
            return island_entity.world_position;
        }
        return entity.world_position;
    }

    get_island_transition_beacon_position :: method() -> v2 {
        foreach beacon_spawn: component_iterator(BeaconSpawn) {
            if beacon_spawn == null continue;
            if beacon_spawn.entity == null continue;
            return beacon_spawn.entity.world_position;
        }

        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            if beacon.entity == null continue;
            return beacon.entity.world_position;
        }

        island_entity := get_island_entity(loaded_island);
        if island_entity != null {
            return island_entity.world_position;
        }
        return entity.world_position;
    }

    sample_player_position_near_beacon :: method(player: Player) -> v2 {
        center := get_current_beacon_position();
        rng: u64 = rng_seed(player.entity.id);
        advance_count := max(loaded_island, 1);
        angle: float = 0.0;
        radius_t: float = 0.0;
        advance_step: int = 0;
        while advance_step < advance_count {
            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            advance_step += 1;
        }

        desired_pos := v2{
            center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
            center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
        };

        navmesh := player_navmesh;
        if navmesh == null {
            return desired_pos;
        }

        hint_as_int: int = 0;
        attempt: int = 0;
        while attempt < ISLAND_TRANSITION_PLAYER_SPAWN_SAMPLE_ATTEMPTS {
            spawn_pos: v2;
            if navmesh->try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                return spawn_pos;
            }

            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            desired_pos = v2{
                center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
                center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
            };
            attempt += 1;
        }

        snapped_center: v2;
        if navmesh->try_find_closest_point_on_navmesh(center, ref snapped_center, ref hint_as_int) {
            return snapped_center;
        }
        return center;
    }

    sample_island_transition_player_position :: method(player: Player) -> v2 {
        center := get_island_transition_beacon_position();
        rng: u64 = rng_seed(player.entity.id);
        advance_count := max(island_transition_target_island, 1);
        angle: float = 0.0;
        radius_t: float = 0.0;
        advance_step: int = 0;
        while advance_step < advance_count {
            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            advance_step += 1;
        }

        desired_pos := v2{
            center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
            center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
        };

        navmesh := player_navmesh;
        if navmesh == null {
            return desired_pos;
        }

        hint_as_int: int = 0;
        attempt: int = 0;
        while attempt < ISLAND_TRANSITION_PLAYER_SPAWN_SAMPLE_ATTEMPTS {
            spawn_pos: v2;
            if navmesh->try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                return spawn_pos;
            }

            angle = rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t = sqrt(rng_range_float(ref rng, 0.0, 1.0));
            desired_pos = v2{
                center.x + cos(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS,
                center.y + sin(angle) * radius_t * ISLAND_TRANSITION_PLAYER_SPAWN_RADIUS
            };
            attempt += 1;
        }

        snapped_center: v2;
        if navmesh->try_find_closest_point_on_navmesh(center, ref snapped_center, ref hint_as_int) {
            return snapped_center;
        }
        return center;
    }

    teleport_all_players_near_beacon_for_island_transition :: method() {
        foreach player: component_iterator(Player) {
            if player == null continue;
            if player.entity == null continue;
            player.entity->set_local_position(sample_island_transition_player_position(player));
        }
    }

    teleport_all_players_to_voyage_scene :: method() {
        foreach player: component_iterator(Player) {
            if player == null continue;
            if player.entity == null continue;
            teleport_player_to_voyage_scene(player);
        }
    }

    start_voyage_return_transition :: method(target_island: int, caused_by_destruction: bool) {
        if current_phase != .IN_ROUND return;
        if voyage_state != .VOYAGING return;
        if island_transition_active return;

        if caused_by_destruction {
            reset_voyage_preps_for_round();
        }

        Island = target_island;
        island_transition_target_island = target_island;
        island_transition_active = true;
        island_transition_disable_done = false;
        island_transition_applied = false;
        island_transition_start_time = get_time();
        voyage_state = .TO_ISLAND;
        voyage_returning_after_destruction = caused_by_destruction;
    }

    update_voyage_timer :: method() {
        if voyage_state != .VOYAGING return;
        if get_time() - voyage_timer_start_time < VOYAGE_DURATION_SECONDS return;

        start_voyage_return_transition(island_transition_target_island, false);
    }

    should_draw_voyage_timer :: method() -> bool {
        return current_phase == .IN_ROUND && voyage_state == .VOYAGING;
    }

    should_use_voyage_camera_zoom :: method() -> bool {
        return current_phase == .IN_ROUND && should_show_voyage_scene();
    }

    should_pause_day_night_for_voyage :: method() -> bool {
        return current_phase == .IN_ROUND && should_show_voyage_scene();
    }

    force_day_start_for_voyage :: method() {
        if day_night_phase == .DAY &&
            day_night_phase_time_seconds == 0.0 &&
            day_night_blend == 0.0 &&
            day_night_blend_from == 0.0 &&
            day_night_blend_to == 0.0 &&
            day_night_blend_transition_time_seconds == 0.0 {
            return;
        }

        day_night_phase = .DAY;
        day_night_phase_time_seconds = 0.0;
        day_night_blend = 0.0;
        day_night_blend_from = 0.0;
        day_night_blend_to = 0.0;
        day_night_blend_transition_time_seconds = 0.0;
    }

    get_voyage_progress_t :: method() -> float {
        if voyage_state != .VOYAGING return 0.0;
        elapsed := get_time() - voyage_timer_start_time;
        return clamp(elapsed / VOYAGE_DURATION_SECONDS, 0.0, 1.0);
    }


    reset_day_night_cycle :: method() {
        day_night_phase = .DAY;
        day_night_phase_time_seconds = 0.0;
        day_night_blend = 0.0;
        day_night_blend_from = 0.0;
        day_night_blend_to = 0.0;
        day_night_blend_transition_time_seconds = 0.0;
        warned_player_user_ids_for_current_day->clear();
        warned_player_entities_for_current_day->clear();
        log_info("Day/Night -> DAY", {});
    }

    update_day_night_cycle :: method(dt: float) {
        if should_pause_day_night_for_voyage() {
            force_day_start_for_voyage();
            return;
        }

        day_night_phase_time_seconds += dt;

        if day_night_phase == .DAY {
            if day_night_phase_time_seconds >= DAY_DURATION_SECONDS {
                send_night_warning();
                day_night_phase = .NIGHT;
                day_night_phase_time_seconds = 0.0;
                begin_day_night_blend_transition();
                roll_and_apply_night_event();
                spawn_island1_boss_for_night();
                if !Game.is_server() {
                    game_sfx_play(.NIGHT_START);
                }
                log_info("Day/Night -> NIGHT", {});
            }
            return;
        }

        if day_night_phase_time_seconds >= NIGHT_DURATION_SECONDS {
            clear_active_night_event();
            clear_island1_boss();
            day_night_phase = .DAY;
            day_night_phase_time_seconds = 0.0;
            warned_player_user_ids_for_current_day->clear();
            warned_player_entities_for_current_day->clear();
            apply_night_survival_progress();
            begin_day_night_blend_transition();
            grant_night_survival_currency_rewards();
            revive_dead_players_for_day_start();
            notify_all_players_survived_night();
            if !Game.is_server() {
                game_sfx_play(.DAY_START);
            }
            log_info("Day/Night -> DAY (Nights: %)", {nights});
        }
    }

    grant_night_survival_currency_rewards :: method() {
        // Currency transactions should only execute on the server.
        if !Game.is_server() return;

        reward_amount := this->get_night_survival_reward_amount();
        if reward_amount <= 0 return;

        rewarded_count: s64 = 0;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;
            if p->is_dead_for_night_state() continue;

            Economy.deposit_currency(p, SURVIVED_NIGHT_REWARD_CURRENCY, reward_amount);
            //Notifier.notify(p, SURVIVED_NIGHT_REWARD_NOTIFICATION_TEXT, {
              //  reward_amount,
              //  SURVIVED_NIGHT_REWARD_CURRENCY
            //});
            rewarded_count += 1;
        }

        log_info("Granted % % currency to % night survivor(s).", {
            reward_amount,
            SURVIVED_NIGHT_REWARD_CURRENCY,
            rewarded_count
        });
    }

    revive_dead_players_for_day_start :: method() {
        foreach p: component_iterator(Player) {
            if p == null continue;
            if !p->is_dead_for_night_state() continue;
            p->revive_for_day_start();
        }
    }

    are_all_players_dead_for_night :: method() -> bool {
        player_count: s64 = 0;
        dead_count: s64 = 0;
        foreach p: component_iterator(Player) {
            if p == null continue;
            player_count += 1;
            if p->is_dead_for_night_state() {
                dead_count += 1;
            }
        }
        if player_count <= 0 return false;
        return dead_count >= player_count;
    }

    start_game_over_sequence :: method() {
        if game_over_sequence_active return;
        game_over_sequence_active = true;
        game_over_sequence_restart_done = false;
        game_over_sequence_start_time = get_time();
        game_over_nights_lasted = nights;
        if !Game.is_server() {
            game_sfx_play(.GAME_OVER);
        }
        log_info("Game Over sequence started.", {});
    }

    update_game_over_sequence :: method() {
        if !game_over_sequence_active {
            if current_phase == .IN_ROUND && day_night_phase == .NIGHT {
                if are_all_players_dead_for_night() {
                    start_game_over_sequence();
                }
            }
            return;
        }

        elapsed := get_time() - game_over_sequence_start_time;
        if !game_over_sequence_restart_done && elapsed >= GAME_OVER_FADE_OUT_SECONDS {
            run_game_over_restart();
            game_over_sequence_restart_done = true;
        }

        fade_total_time := GAME_OVER_FADE_OUT_SECONDS + GAME_OVER_BLACK_HOLD_SECONDS + GAME_OVER_FADE_IN_SECONDS;
        total_time := max(fade_total_time, GAME_OVER_TEXT_DURATION_SECONDS);
        if elapsed >= total_time {
            game_over_sequence_active = false;
            game_over_sequence_restart_done = false;
            game_over_sequence_start_time = 0.0;
        }
    }

    run_game_over_restart :: method() {
        if !Game.is_server() return;

        cleanup_world_for_game_restart();

        foreach p: component_iterator(Player) {
            if p == null continue;
            p->reset_for_game_restart();
        }

        reset_log_pages_for_full_restart();
        reset_beacons_for_full_restart();
        reset_voyage_preps_for_full_restart();
        reset_game_state();

        foreach p: component_iterator(Player) {
            if p == null continue;
            teleport_player_to_lobby_spawn(p);
        }
    }

    cleanup_world_for_game_restart :: method() {
        if !Game.is_server() return;

        clear_island1_boss();
        despawn_all_pois_for_transition();
        destroy_all_mobs_for_game_over();
        despawn_all_dropped_items_for_game_over();
    }

    despawn_all_pois_for_transition :: method() {
        removed_count: s64 = 0;

        foreach poi: component_iterator(POI) {
            if poi == null continue;
            if poi.spawned_entity == null continue;

            poi->destroy_spawned_entity();
            removed_count += 1;
        }

        if removed_count > 0 {
            log_info("Transition cleanup despawned % POI spawn(s).", {removed_count});
        }
    }

    destroy_all_mobs_for_game_over :: method() {
        removed_count: s64 = 0;

        foreach spawner: component_iterator(MobSpawner) {
            if spawner == null continue;
            removed_count += spawner.spawned_mobs.count;
            spawner->destroy_all_spawned_mobs();
            spawner->clear_temporary_spawn_cap_bonus();
        }

        foreach mob: component_iterator(Mob) {
            if mob == null continue;
            if mob.entity == null continue;
            if !#alive(mob.entity) continue;
            mob.entity->destroy();
            removed_count += 1;
        }

        if removed_count > 0 {
            log_info("Game Over cleanup removed % mob(s).", {removed_count});
        }
    }

    despawn_all_dropped_items_for_game_over :: method() {
        removed_count: s64 = 0;

        foreach dropped: component_iterator(Dropped_Item) {
            if dropped == null continue;
            if dropped.item != null {
                Items.destroy_item_instance(dropped.item);
                dropped.item = null;
            }
            if dropped.entity != null && #alive(dropped.entity) {
                dropped.entity->destroy();
                removed_count += 1;
            }
        }

        foreach dropped: component_iterator(Item_Drop_Magnet) {
            if dropped == null continue;
            if dropped.entity != null && #alive(dropped.entity) {
                dropped.entity->destroy();
                removed_count += 1;
            }
        }

        if removed_count > 0 {
            log_info("Game Over cleanup despawned % dropped item(s).", {removed_count});
        }
    }

    reset_beacons_for_full_restart :: method() {
        foreach beacon: component_iterator(Beacon) {
            if beacon == null continue;
            beacon.level = 1;
            beacon->clear_stockpile();
            beacon->set_fuel_for_round(Beacon.DEFAULT_STARTING_FUEL);
            beacon->apply_level_world_state();
            beacon->refresh_prompt_text();
        }
    }

    reset_voyage_preps_for_full_restart :: method() {
        foreach prep: component_iterator(VoyagePrep) {
            if prep == null continue;
            prep->reset_for_round();
        }
    }

    send_night_warning :: method() {
        notify_all_players_night_warning();
    }

    notify_all_players_night_warning :: method() {
        show_broadcast_notification(NIGHT_WARNING_NOTIFICATION_TEXT);
        sent_to_any_player := false;
        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;

            sent_to_any_player = true;
            log_info("Sent night warning to %", {p->get_username()});
        }
        if sent_to_any_player {
            game_sfx_play(.NIGHT_WARNING);
        }
    }

    was_player_warned_this_day :: method(user_id: string) -> bool {
        for warned_id: warned_player_user_ids_for_current_day {
            if warned_id == user_id {
                return true;
            }
        }
        return false;
    }

    was_player_entity_warned_this_day :: method(player_entity: Entity) -> bool {
        for warned_entity: warned_player_entities_for_current_day {
            if warned_entity == player_entity {
                return true;
            }
        }
        return false;
    }

    notify_all_players_survived_night :: method() {
        remaining_nights := max(99 - nights, 0);
        message := format_string(SURVIVED_NIGHT_NOTIFICATION_TEXT, {remaining_nights});
        show_broadcast_notification(message);
        log_info("Broadcasted survived-night notification (remaining: %).", {remaining_nights});
    }

    roll_and_apply_night_event :: method() {
        //if !Game.is_server() return;
        clear_active_night_event();
        current_night_event = .NONE;

        if nights < night_event_min_completed_nights_before_roll {
            log_info("Night event skipped: completed nights % below unlock threshold %.", {
                nights,
                night_event_min_completed_nights_before_roll
            });
            return;
        }

        unlocked_nights := nights - night_event_min_completed_nights_before_roll;
        event_weight_scale := night_event_weight_scale_start +
            unlocked_nights.(float) * night_event_weight_scale_gain_per_completed_night;
        event_weight_scale = clamp(event_weight_scale, 0.0, night_event_weight_scale_cap);

        none_weight := max(night_event_none_weight, 0.0);
        raid_weight := max(night_event_raid_weight, 0.0) * event_weight_scale;
        supply_weight := max(night_event_supply_drop_weight, 0.0) * event_weight_scale;
        total_weight := none_weight + raid_weight + supply_weight;
        if total_weight <= 0.0 return;

        roll_rng := rng_seed_time();
        roll := rng_range_float(ref roll_rng, 0.0, total_weight);
        if roll < none_weight {
            current_night_event = .NONE;
        } else if roll < none_weight + raid_weight {
            current_night_event = .RAID;
        } else {
            current_night_event = .SUPPLY_DROP;
        }

        if current_night_event == .NONE return;

        apply_active_night_event();
        notify_all_players_night_event_started();
        log_info("Night event roll applied with scale % after % completed nights.", {
            format_float(event_weight_scale, decimals=2),
            nights
        });
    }

    apply_active_night_event :: method() {
        if !Game.is_server() return;

        switch current_night_event {
            case .RAID: {
                apply_raid_event();
            }
            case .SUPPLY_DROP: {
                apply_supply_drop_event();
            }
            case .NONE: {
            }
        }
    }

    clear_active_night_event :: method() {
        if Game.is_server() {
            clear_raid_event();
            clear_supply_drop_event();
        }
        current_night_event = .NONE;
    }

    apply_raid_event :: method() {
        multiplier := max(raid_spawn_cap_multiplier, 2);

        // Snapshot the spawners before force-filling so entity creation does not
        // invalidate the live component iterator during the raid setup pass.
        spawners: [..]MobSpawner;
        foreach spawner: component_iterator(MobSpawner) {
            if spawner == null continue;
            spawners->append(spawner);
        }

        for spawner: spawners {
            if spawner == null continue;
            bonus := max(spawner.max_mobs * (multiplier - 1), 0);
            spawner->set_temporary_spawn_cap_bonus(bonus);
        }

        for spawner: spawners {
            if spawner == null continue;
            spawner->force_fill_to_current_cap();
        }
        log_info("Night event started: RAID (spawn cap x%).", {multiplier});
    }

    clear_raid_event :: method() {
        foreach spawner: component_iterator(MobSpawner) {
            if spawner == null continue;
            spawner->clear_temporary_spawn_cap_bonus();
        }
    }

    apply_supply_drop_event :: method() {
        if SupplyDropPrefab.count <= 0 {
            log_info("Night event Supply Drop skipped: SupplyDropPrefab is empty.", {});
            return;
        }

        prefab := get_asset(Prefab_Asset, SupplyDropPrefab);
        if prefab == null {
            log_info("Night event Supply Drop skipped: prefab missing at '%'.", {SupplyDropPrefab});
            return;
        }

        supply_drop_spawn_entity := get_supply_drop_spawn_entity(Island);
        if supply_drop_spawn_entity == null {
            log_info("Night event Supply Drop skipped: island % has no assigned SupplyDrops entry.", {Island});
            return;
        }
        spawn_pos := supply_drop_spawn_entity.world_position;

        active_supply_drop_entity = Scene.instantiate(prefab);
        if active_supply_drop_entity == null {
            log_info("Night event Supply Drop failed to instantiate prefab '%'.", {SupplyDropPrefab});
            return;
        }

        active_supply_drop_entity->set_local_position(spawn_pos);
        log_info("Night event started: SUPPLY DROP at (%, %).", {spawn_pos.x, spawn_pos.y});
    }

    clear_supply_drop_event :: method() {
        if active_supply_drop_entity != null && #alive(active_supply_drop_entity) {
            active_supply_drop_entity->destroy();
        }
        active_supply_drop_entity = null;
    }

    get_island1_boss_spawn_center :: method() -> v2 {
        if island1_boss_spawn_point != null {
            return island1_boss_spawn_point.world_position;
        }
        if island1_spawn != null {
            return island1_spawn.world_position;
        }
        return entity.world_position;
    }

    sample_island1_boss_spawn_position :: method() -> v2, bool {
        navmesh := player_navmesh;
        if navmesh == null {
            return get_island1_boss_spawn_center(), false;
        }

        center := get_island1_boss_spawn_center();
        radius_sq := ISLAND1_BOSS_SPAWN_RADIUS * ISLAND1_BOSS_SPAWN_RADIUS;
        rng := rng_seed_time();
        hint_as_int: int = 0;

        for attempt: 0..ISLAND1_BOSS_SPAWN_SAMPLE_ATTEMPTS-1 {
            angle := rng_range_float(ref rng, 0.0, 6.2831853);
            radius_t := sqrt(rng_range_float(ref rng, 0.0, 1.0));
            dist := radius_t * ISLAND1_BOSS_SPAWN_RADIUS;
            desired_pos := v2{
                center.x + cos(angle) * dist,
                center.y + sin(angle) * dist
            };

            spawn_pos: v2;
            if !navmesh->try_find_closest_point_on_navmesh(desired_pos, ref spawn_pos, ref hint_as_int) {
                continue;
            }
            if length_squared(spawn_pos - center) <= radius_sq {
                return spawn_pos, true;
            }
        }

        fallback_pos: v2;
        if navmesh->try_find_closest_point_on_navmesh(center, ref fallback_pos, ref hint_as_int) {
            return fallback_pos, true;
        }

        return center, false;
    }

    disable_island1_boss_spawns_for_current_run :: method() {
        if !island1_boss_spawns_enabled_for_run return;
        if Island <= 1 && loaded_island <= 1 && island_transition_target_island <= 1 return;

        island1_boss_spawns_enabled_for_run = false;
        clear_island1_boss();
        log_info("Island 1 boss spawns disabled until the next full reset.", {});
    }

    spawn_island1_boss_for_night :: method() {
        if !Game.is_server() return;
        if !island1_boss_spawns_enabled_for_run return;
        if island1_boss_defeated_for_run return;
        if Island1BossMob.count <= 0 return;
        if active_island1_boss_entity != null && #alive(active_island1_boss_entity) return;

        prefab := get_asset(Prefab_Asset, Island1BossMob);
        if prefab == null {
            log_info("Island 1 boss spawn skipped: prefab missing at '%'.", {Island1BossMob});
            return;
        }

        active_island1_boss_entity = Scene.instantiate(prefab);
        if active_island1_boss_entity == null {
            log_info("Island 1 boss spawn failed for prefab '%'.", {Island1BossMob});
            return;
        }

        spawn_pos, found_spawn_pos := sample_island1_boss_spawn_position();
        if !found_spawn_pos {
            log_info("Island 1 boss spawn failed: no valid navmesh position found near spawn point.", {});
            active_island1_boss_entity->destroy();
            active_island1_boss_entity = null;
            return;
        }

        active_island1_boss_entity->set_local_position(spawn_pos);
        log_info("Island 1 boss spawned at (%, %).", {spawn_pos.x, spawn_pos.y});
    }

    clear_island1_boss :: method() {
        if active_island1_boss_entity != null && #alive(active_island1_boss_entity) {
            active_island1_boss_entity->destroy();
        }
        active_island1_boss_entity = null;
    }

    update_island1_boss_state :: method() {
        if !Game.is_server() return;
        if active_island1_boss_entity == null return;

        if !#alive(active_island1_boss_entity) {
            active_island1_boss_entity = null;
            return;
        }

        boss_mob := active_island1_boss_entity->get_component(Mob);
        if boss_mob == null return;
        if boss_mob->is_alive() return;

        island1_boss_defeated_for_run = true;
        active_island1_boss_entity = null;
        log_info("Island 1 boss defeated for this run.", {});
    }

    notify_all_players_night_event_started :: method() {
        if current_night_event == .NONE return;
        if current_night_event == last_notified_night_event return;

        event_name := night_event_type_to_text(current_night_event);
        message := format_string(NIGHT_EVENT_NOTIFICATION_TEXT, {event_name});
        show_broadcast_notification(message);
        last_notified_night_event = current_night_event;
        log_info("Broadcasted night event notification: %.", {event_name});
    }

    notify_all_players_player_downed :: method(downed_player: Player) {
        if downed_player == null return;
        name := downed_player->get_username();
        if name.count <= 0 {
            name = "A player";
        }

        message := format_string(PLAYER_DOWNED_NOTIFICATION_TEXT, {name});
        if Game.is_server() {
            sent_to_any_player := false;
            foreach p: component_iterator(Player) {
                if p == null continue;
                if p.entity == null continue;

                Notifier.notify(p, message);
                sent_to_any_player = true;
            }

            if sent_to_any_player {
                log_info("Sent downed notification for %.", {name});
            }
        }
    }

    update_night_event_notifications :: method() {
        if current_night_event == .NONE {
            last_notified_night_event = .NONE;
            return;
        }
        notify_all_players_night_event_started();
    }

    is_raid_event_active :: method() -> bool {
        return current_night_event == .RAID;
    }

    is_supply_drop_event_active :: method() -> bool {
        return current_night_event == .SUPPLY_DROP;
    }

    should_mobs_ignore_beacon_safety :: method() -> bool {
        return current_night_event == .RAID;
    }

    get_supply_drop_arrow_target :: method() -> v2, bool {
        if current_night_event != .SUPPLY_DROP return {0.0, 0.0}, false;

        if active_supply_drop_entity != null && #alive(active_supply_drop_entity) {
            return active_supply_drop_entity.world_position, true;
        }

        supply_drop_spawn_entity := get_supply_drop_spawn_entity(Island);
        if supply_drop_spawn_entity != null {
            return supply_drop_spawn_entity.world_position, true;
        }

        return {0.0, 0.0}, false;
    }

    is_night_warning_window_active :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if day_night_phase != .DAY return false;

        time_until_night := DAY_DURATION_SECONDS - day_night_phase_time_seconds;
        return time_until_night > 0.0 && time_until_night <= NIGHT_WARNING_LEAD_TIME_SECONDS;
    }

    begin_day_night_blend_transition :: method() {
        day_night_blend_from = day_night_blend;
        day_night_blend_to = get_target_night_blend();
        day_night_blend_transition_time_seconds = 0.0;
    }

    update_day_night_blend :: method(dt: float) {
        day_night_blend_transition_time_seconds += dt;
        t := clamp(day_night_blend_transition_time_seconds / DAY_NIGHT_BLEND_TRANSITION_SECONDS, 0.0, 1.0);
        day_night_blend = lerp(day_night_blend_from, day_night_blend_to, t);
    }

    get_target_night_blend :: method() -> float {
        if day_night_phase == .NIGHT return 1.0;
        return 0.0;
    }

    is_night_time :: method() -> bool {
        if should_pause_day_night_for_voyage() return false;
        return day_night_phase == .NIGHT;
    }

    get_night_blend :: method() -> float {
        if should_pause_day_night_for_voyage() return 0.0;
        return day_night_blend;
    }

    get_day_alpha_target :: method() -> float {
        if current_phase != .IN_ROUND return 1.0;
        if should_pause_day_night_for_voyage() return 1.0;
        return 1.0 - day_night_blend;
    }

    get_day_night_clock_hours :: method() -> float {
        if current_phase != .IN_ROUND {
            return 0.0;
        }
        if should_pause_day_night_for_voyage() {
            return 0.0;
        }

        if day_night_phase == .DAY {
            t := clamp(day_night_phase_time_seconds / DAY_DURATION_SECONDS, 0.0, 1.0);
            return t * 12.0;
        }

        t := clamp(day_night_phase_time_seconds / NIGHT_DURATION_SECONDS, 0.0, 1.0);
        return 12.0 + t * 12.0;
    }

    update_round_start_sequence :: method() {
        if current_phase != .IN_ROUND return;
        if round_start_teleport_done return;
        if phase_time_seconds < ROUND_START_FADE_OUT_SECONDS return;

        round_start_teleport_done = true;
        teleport_all_players_to_island1_spawn();
    }

    get_round_start_overlay_alpha :: method() -> float {
        if current_phase != .IN_ROUND return 0.0;

        fade_out_end := ROUND_START_FADE_OUT_SECONDS;
        black_hold_end := fade_out_end + ROUND_START_BLACK_HOLD_SECONDS;
        fade_in_end := black_hold_end + ROUND_START_FADE_IN_SECONDS;

        if phase_time_seconds <= fade_out_end {
            return clamp(phase_time_seconds / ROUND_START_FADE_OUT_SECONDS, 0.0, 1.0);
        }

        if phase_time_seconds <= black_hold_end {
            return 1.0;
        }

        if phase_time_seconds <= fade_in_end {
            fade_in_t := clamp((phase_time_seconds - black_hold_end) / ROUND_START_FADE_IN_SECONDS, 0.0, 1.0);
            return 1.0 - fade_in_t;
        }

        return 0.0;
    }

    get_game_over_overlay_alpha :: method() -> float {
        if !game_over_sequence_active return 0.0;

        elapsed := get_time() - game_over_sequence_start_time;
        fade_out_end := GAME_OVER_FADE_OUT_SECONDS;
        black_hold_end := fade_out_end + GAME_OVER_BLACK_HOLD_SECONDS;
        fade_in_end := black_hold_end + GAME_OVER_FADE_IN_SECONDS;

        if elapsed <= fade_out_end {
            return clamp(elapsed / GAME_OVER_FADE_OUT_SECONDS, 0.0, 1.0);
        }

        if elapsed <= black_hold_end {
            return 1.0;
        }

        if elapsed <= fade_in_end {
            fade_in_t := clamp((elapsed - black_hold_end) / GAME_OVER_FADE_IN_SECONDS, 0.0, 1.0);
            return 1.0 - fade_in_t;
        }

        return 0.0;
    }

    get_island_transition_overlay_alpha :: method() -> float {
        if !island_transition_active return 0.0;

        elapsed := get_time() - island_transition_start_time;
        fade_out_end := ISLAND_TRANSITION_FADE_OUT_SECONDS;
        black_hold_end := fade_out_end + ISLAND_TRANSITION_BLACK_HOLD_SECONDS;
        fade_in_end := black_hold_end + ISLAND_TRANSITION_FADE_IN_SECONDS;

        if elapsed <= fade_out_end {
            return clamp(elapsed / ISLAND_TRANSITION_FADE_OUT_SECONDS, 0.0, 1.0);
        }

        if elapsed <= black_hold_end {
            return 1.0;
        }

        if elapsed <= fade_in_end {
            fade_in_t := clamp((elapsed - black_hold_end) / ISLAND_TRANSITION_FADE_IN_SECONDS, 0.0, 1.0);
            return 1.0 - fade_in_t;
        }

        return 0.0;
    }

    should_draw_game_over_text :: method() -> bool {
        if !game_over_sequence_active return false;
        elapsed := get_time() - game_over_sequence_start_time;
        return elapsed <= GAME_OVER_TEXT_DURATION_SECONDS;
    }

    get_game_over_nights_lasted :: method() -> s64 {
        return game_over_nights_lasted;
    }

    should_draw_round_start_text :: method() -> bool {
        if current_phase != .IN_ROUND return false;
        if !round_start_teleport_done return false;
        text_start_time := ROUND_START_FADE_OUT_SECONDS;
        text_end_time := text_start_time + ROUND_START_TEXT_DURATION_SECONDS;
        return phase_time_seconds >= text_start_time && phase_time_seconds <= text_end_time;
    }

    try_auto_start_from_lobby :: method() {
        if current_phase != .LOBBY return;
        if game_over_sequence_active return;

        player_count := get_player_count();
        if player_count < PLAYERS_REQUIRED_TO_START return;

        log_info("Auto-starting game at %/% players.", {player_count, PLAYERS_REQUIRED_TO_START});
        start_game();
    }

    update_damage_numbers :: method(dt: float) {
        i: s64 = 0;
        while i < damage_numbers.count {
            dn := damage_numbers[i];
            if dn == null {
                damage_numbers->ordered_remove_by_index(i);
                continue;
            }

            dn.T += dt;
            if dn.T >= damage_number_lifetime_seconds {
                damage_numbers->ordered_remove_by_index(i);
                continue;
            }

            dn.Position.y += damage_number_rise_speed * dt;
            if dn.DoingFading {
                fade_t := clamp(dn.T / damage_number_lifetime_seconds, 0.0, 1.0);
                dn.Color.w = 1.0 - fade_t;
            }

            damage_numbers[i] = dn;
            i += 1;
        }
    }

    draw_damage_numbers :: method() {
        if damage_numbers.count <= 0 return;

        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        for dn: damage_numbers {
            if dn == null continue;

            ts := dn.TextSettings;
            if ts.size <= 0.0 {
                ts = UI.default_text_settings();
                ts.size = 0.30;
                ts.halign = .CENTER;
                ts.valign = .CENTER;
                ts.do_outline = true;
                ts.outline_thickness = 2;
                ts.outline_color = {0, 0, 0, 1};
            }
            ts.color = dn.Color;
            if dn.SpaceText {
                ts.spacing_multiplier = 1.1;
            }

            text_pos := dn.Position;
            text_rect := Rect{text_pos, text_pos}->grow(0.12, 0.42, 0.12, 0.42);
            UI.push_z(text_pos.y - 0.0002);
            UI.text(text_rect, ts, dn.Text);
            UI.pop_z();
        }
    }
}
