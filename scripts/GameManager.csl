g_game_manager: GameManager;

DamageNumbers :: class {
    Text: string;
    Position: v2;
    Color: v4;
    T: float;
    TextSettings: Text_Settings;
    SpaceText: bool;
    DoingFading: bool;
    LastPosition: v2;
}

Game_Phase :: enum {
    LOBBY;
    IN_ROUND;
    POST_ROUND;
}

Day_Night_Phase :: enum {
    DAY;
    NIGHT;
}

Night_Event_Type :: enum {
    NONE;
    RAID;
    SUPPLY_DROP;
    REAPER;
    MOON_MERCHANT;
}

night_event_type_to_text :: proc(event_type: Night_Event_Type) -> string {
    switch event_type {
        case .RAID:          return "Raid";
        case .SUPPLY_DROP:   return "Supply Drop";
        case .REAPER:        return "Monster";
        case .MOON_MERCHANT: return MOON_MERCHANT_DISPLAY_NAME;
        case .NONE:          return "None";
    }
    return "None";
}

Music_Track :: enum {
    NONE;
    DAY;
    NIGHT;
}

Voyage_State :: enum {
    NONE;
    TO_VOYAGE;
    VOYAGING;
    TO_ISLAND;
}

g_start_music_sound_id: u64;
g_current_music_track: Music_Track;
g_local_run_complete_sfx_sequence_start_time: float = -1.0;
g_local_run_complete_sfx_stage_played: int = -1;

Game_Sfx_Event :: enum {
    NONE;
    ROUND_START;
    NIGHT_START;
    DAY_START;
    GAME_OVER;
    RUN_COMPLETE;
    RUN_COMPLETE_STEP;
    RESOURCE_GATHER;
    ITEM_PICKUP;
    UI_CLICK;
    UI_ERROR;
    CRAFT_SUCCESS;
    CHEST_OPEN;
    ITEM_DROP;
    BEACON_UPGRADE;
    NIGHT_WARNING;
    REVIVE;
    DEATH;
    MOB_ATTACK;
    DAMAGE_HIT;
    DODGE_ROLL;
}

game_sfx_path_for_event :: proc(event: Game_Sfx_Event) -> string {
    switch event {
        case .ROUND_START:     return "fight_start.wav";
        case .NIGHT_START:     return "Unknown/night_time_change.wav";
        case .DAY_START:       return "Music/day_night_change.wav";
        case .GAME_OVER:       return "decline_fight.wav";
        case .RUN_COMPLETE:    return "reward.wav";
        case .RUN_COMPLETE_STEP:return "ui_click2.wav";
        case .RESOURCE_GATHER: return "SFX/gather_material.wav";
        case .ITEM_PICKUP:     return "pickup_item.wav";
        case .UI_CLICK:        return "ui_click2.wav";
        case .UI_ERROR:        return "Unknown/ui_error.wav";
        case .CRAFT_SUCCESS:   return "SFX/craft_item.wav";
        case .CHEST_OPEN:      return "chest_open.wav";
        case .ITEM_DROP:       return "SFX/drop_item.wav";
        case .BEACON_UPGRADE:  return "reward.wav";
        case .NIGHT_WARNING:   return "Music/icicle_warning.wav";
        case .REVIVE:          return "SFX/revive.wav";
        case .DEATH:           return "SFX/death.wav";
        case .MOB_ATTACK:      return "slime_attack.wav";
        case .DAMAGE_HIT:      return "bullet_bodyimpact.wav";
        case .DODGE_ROLL:      return "SFX/dodge_roll.wav";
        case .NONE:            return "";
    }
    return "";
}

game_sfx_default_volume_for_event :: proc(event: Game_Sfx_Event) -> float {
    switch event {
        case .ROUND_START:     return 0.40;
        case .NIGHT_START:     return 0.35;
        case .DAY_START:       return 0.30;
        case .GAME_OVER:       return 0.45;
        case .RUN_COMPLETE:    return 0.55;
        case .RUN_COMPLETE_STEP:return 0.32;
        case .RESOURCE_GATHER: return 0.28;
        case .ITEM_PICKUP:     return 0.35;
        case .UI_CLICK:        return 0.50;
        case .UI_ERROR:        return 0.35;
        case .CRAFT_SUCCESS:   return 0.45;
        case .CHEST_OPEN:      return 0.45;
        case .ITEM_DROP:       return 0.30;
        case .BEACON_UPGRADE:  return 0.50;
        case .NIGHT_WARNING:   return 0.45;
        case .REVIVE:          return 0.45;
        case .DEATH:           return 0.45;
        case .MOB_ATTACK:      return 0.40;
        case .DAMAGE_HIT:      return 0.35;
        case .DODGE_ROLL:      return 0.40;
        case .NONE:            return 0.35;
    }
    return 0.35;
}

is_local_player_entity :: proc(target: Entity) -> bool {
    if target == null return false;

    foreach player: component_iterator(Player) {
        if player == null || player.entity == null continue;
        if player.entity.id != target.id continue;
        return player.is_local();
    }

    return false;
}

game_sfx_play :: proc(event: Game_Sfx_Event, follow_entity: Entity = null, volume_scale: float = 1.0) {
    if event == .NONE return;
    if event == .NIGHT_WARNING && Game.is_server() return;
    if event == .UI_CLICK {
        // UI clicks should only be heard by the player who triggered them.
        if !is_local_player_entity(follow_entity) return;
    }

    path := game_sfx_path_for_event(event);
    if path.count <= 0 return;

    sfx := get_asset(SFX_Asset, path);
    if sfx == null return;

    desc := SFX.default_sfx_desc();
    desc.channel = .SFX;
    if follow_entity != null {
        desc.entity_to_follow = follow_entity.id;
    }
    desc.volume = clamp(game_sfx_default_volume_for_event(event) * max(volume_scale, 0.0), 0.0, 1.0);
    SFX.play(sfx, desc);
}

music_track_asset_path :: proc(track: Music_Track) -> string {
    switch track {
        case .DAY:   return "Music/WoP.wav";
        case .NIGHT: return "Music/FtI.wav";
        case .NONE:  return "";
    }

    return "";
}

stop_current_music_track :: proc() {
    if g_start_music_sound_id != 0 {
        SFX.stop(g_start_music_sound_id);
        g_start_music_sound_id = 0;
    }

    g_current_music_track = .NONE;
}

play_music_track :: proc(track: Music_Track) {
    if track == .NONE {
        stop_current_music_track();
        return;
    }
    if g_current_music_track == track && g_start_music_sound_id != 0 return;

    stop_current_music_track();

    asset_path := music_track_asset_path(track);
    if asset_path.count <= 0 return;

    music_asset := get_asset(SFX_Asset, asset_path);
    if music_asset == null {
        log_info("Music asset missing: %", {asset_path});
        return;
    }

    desc := SFX.default_sfx_desc();
    desc.loop = true;
    desc.channel = .MUSIC;
    desc.volume = 0.35;
    g_start_music_sound_id = SFX.play(music_asset, desc);
    g_current_music_track = track;
}

reset_local_run_complete_sfx_state :: proc() {
    g_local_run_complete_sfx_sequence_start_time = -1.0;
    g_local_run_complete_sfx_stage_played = -1;
}

play_local_run_complete_stage_sfx :: proc(stage: int) {
    switch stage {
        case 0: {
            game_sfx_play(.RUN_COMPLETE);
        }
        case 1: {
            game_sfx_play(.RUN_COMPLETE_STEP);
        }
        case 2: {
            game_sfx_play(.RUN_COMPLETE_STEP);
        }
        case 3: {
            game_sfx_play(.BEACON_UPGRADE);
        }
    }
}

get_game_manager :: proc() -> GameManager {
    return g_game_manager;
}

GameProgressTracking :: struct {
    ISLAND_REACHED_SAVE_KEY_FORMAT :: "island%";
    GAME_WINS_SAVE_KEY :: "game_wins";
    GAME_OVERS_SAVE_KEY :: "game_overs";
    NIGHTS_SURVIVED_SAVE_KEY :: "nights_survived";

    increment_player_stat :: proc(player: Player, save_key: string) {
        if player == null return;
        if save_key.count <= 0 return;
        if !Game.is_server() return;

        current_value := Save.get_int(player, save_key, 0);
        Save.set_int(player, save_key, current_value + 1);
    }

    increment_player_island_reached :: proc(player: Player, island_number: int) {
        if player == null return;
        if island_number <= 0 return;

        save_key := get_island_reached_save_key(island_number);
        increment_player_stat(player, save_key);
    }

    increment_all_players_island_reached :: proc(island_number: int) {
        if island_number <= 0 return;
        if !Game.is_server() return;

        foreach player: component_iterator(Player) {
            if player == null continue;
            increment_player_island_reached(player, island_number);
        }
    }

    get_island_reached_save_key :: proc(island_number: int) -> string {
        if island_number <= 0 return "";
        return format_string(ISLAND_REACHED_SAVE_KEY_FORMAT, {island_number});
    }

    increment_all_players_game_wins :: proc() {
        if !Game.is_server() return;

        foreach player: component_iterator(Player) {
            if player == null continue;
            increment_player_stat(player, GAME_WINS_SAVE_KEY);
        }
    }

    increment_all_players_game_overs :: proc() {
        if !Game.is_server() return;

        foreach player: component_iterator(Player) {
            if player == null continue;
            increment_player_stat(player, GAME_OVERS_SAVE_KEY);
        }
    }

    increment_player_nights_survived :: proc(player: Player) {
        increment_player_stat(player, NIGHTS_SURVIVED_SAVE_KEY);
    }
}

ensure_game_manager_exists :: proc() -> GameManager {
    if g_game_manager != null return g_game_manager;

    foreach manager: component_iterator(GameManager) {
        g_game_manager = manager;
        break;
    }

    if g_game_manager == null {
        entity := Scene.create_entity();
        g_game_manager = entity.add_component(GameManager);
        log_info("GameManager singleton created at runtime.", {});
    }

    return g_game_manager;
}

try_force_start_game :: proc(player: Player, source: string) {
    if !Game.is_server() return;

    manager := ensure_game_manager_exists();
    if manager == null {
        if player != null {
            //Notifier.notify(player, "GameManager is unavailable.");
        }
        return;
    }

    if manager.is_round_active() {
        if player != null {
            //Notifier.notify(player, "Round is already active.");
        }
        return;
    }
    if manager.run_complete_sequence_active {
        return;
    }

    manager.start_game();

    if player != null {
       // Notifier.notify(player, "Forced game start.");
        log_info("% forced start_game via %", {player.get_username(), source});
    } else {
        log_info("Forced start_game via %", {source});
    }
}

send_cheat_chat_message :: proc(player: Player, message: string) {
    if player == null return;
    Chat.server_send_message(message, player);
}

player_can_use_cheat_commands :: proc(player: Player) -> bool {
    if player == null return false;
    return player.is_admin() || player.is_youtuber();
}

show_cheat_command_help :: proc(player: Player, reason: string = "") {
    if player == null return;
    if !player_can_use_cheat_commands(player) return;

    if reason.count > 0 {
        send_cheat_chat_message(player, reason);
    }

    send_cheat_chat_message(player, "Cheat commands:");
    send_cheat_chat_message(player, "/start - Force-start the run if it has not started yet.");
    send_cheat_chat_message(player, "/win - Trigger the win sequence immediately.");
    send_cheat_chat_message(player, "/g <item_id> [quantity] - Give yourself an item.");
    send_cheat_chat_message(player, "/island <number> - Set the current island index (1 or greater).");
    send_cheat_chat_message(player, format_string("/beacon <level 1-%> - Set every Beacon to that level.", {Beacon.MAX_LEVEL}));
    send_cheat_chat_message(player, "/raid - Force the next night event to Raid.");
    send_cheat_chat_message(player, "/supply - Force the next night event to Supply Drop.");
    send_cheat_chat_message(player, "/merchant - Force the next night event to Fossil Merchant.");
    send_cheat_chat_message(player, "/monster - Force the next night event to Monster.");
    send_cheat_chat_message(player, "/cheats - Show this command list again.");
}

try_parse_positive_s64 :: proc(value: string) -> s64, bool {
    if value.count <= 0 {
        return 0, false;
    }

    start := 0;
    while start < value.count {
        ch := value[start];
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break;
        }
        start += 1;
    }

    end := value.count;
    while end > start {
        ch := value[end - 1];
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break;
        }
        end -= 1;
    }

    if start >= end {
        return 0, false;
    }

    parsed: s64 = 0;
    for i: start..end-1 {
        ch := value[i];
        if ch < 48 || ch > 57 {
            return 0, false;
        }

        digit := (ch - 48).(s64);
        parsed = parsed * 10 + digit;
    }

    return parsed, true;
}

start :: proc(player: Player, extra: string = "") {
    if player == null return;

    if extra.count > 0 {
        show_cheat_command_help(player, "Incorrect usage: /start");
        return;
    }

    try_force_start_game(player, "/start");
} @chat_command @youtuber

win :: proc(player: Player, extra: string = "") {
    if !Game.is_server() return;
    if player == null return;

    if extra.count > 0 {
        show_cheat_command_help(player, "Incorrect usage: /win");
        return;
    }

    manager := ensure_game_manager_exists();
    if manager == null {
        Notifier.notify(player, "GameManager is unavailable.");
        return;
    }

    manager.start_run_complete_sequence();
    log_info("% triggered /win", {player.get_username()});
} @chat_command @youtuber

cheats :: proc(player: Player, extra: string = "") {
    if player == null return;

    if extra.count > 0 {
        show_cheat_command_help(player, "Incorrect usage: /cheats");
        return;
    }

    show_cheat_command_help(player);
} @chat_command @youtuber

g :: proc(player: Player, item_id: string = "", quantity_text: string = "1") {
    if player == null return;

    if item_id.count <= 0 {
        show_cheat_command_help(player, "Incorrect usage: /g <item_id> [quantity]");
        return;
    }

    quantity, quantity_ok := try_parse_positive_s64(quantity_text);
    if !quantity_ok || quantity <= 0 {
        show_cheat_command_help(player, "Incorrect usage: /g <item_id> [quantity]");
        return;
    }

    if player.default_inventory == null || player.default_inventory.self == null || player.default_inventory.capacity <= 0 {
       // Notifier.notify(player, "Inventory is unavailable.");
        return;
    }

    defn := ItemManager.TryFindItem(item_id);
    if defn == null {
        defn = try_find_reusable_weapon_item_def_by_id(item_id);
    }
    if defn == null {
        show_cheat_command_help(player, format_string("Unknown item id: %", {item_id}));
        return;
    }

    if quantity <= 0 {
        //Notifier.notify(player, "Quantity must be greater than 0.");
        return;
    }

    room := Items.calculate_room_in_inventory_for_item(defn, player.default_inventory);
    if room <= 0 {
       // Notifier.notify(player, "No room for %", {defn.get_name()});
        return;
    }

    give_count := ItemManager.ClampSpawnCountToMaxStack(defn, quantity);
    if give_count > room {
        give_count = room;
    }

    item := ItemManager.CreateItemFromDefinition(defn, give_count);
    if item == null || item.self == null {
       // Notifier.notify(player, "Failed to create item.");
        return;
    }

    Items.move_item_to_inventory(item, player.default_inventory);
    if give_count < quantity {
       // Notifier.notify(player, "Given % x% (requested: %, limited by room)", {defn.get_name(), give_count, quantity});
        return;
    }

    //Notifier.notify(player, "Given % x%", {defn.get_name(), give_count});
} @chat_command @youtuber

island :: proc(player: Player, island_index_text: string = "") {
    if !Game.is_server() return;
    if player == null return;

    island_index_raw, island_index_ok := try_parse_positive_s64(island_index_text);
    if !island_index_ok || island_index_raw <= 0 {
        show_cheat_command_help(player, "Incorrect usage: /island <number>");
        return;
    }

    island_index := island_index_raw.(int);
    manager := ensure_game_manager_exists();
    if manager == null {
        Notifier.notify(player, "GameManager is unavailable.");
        return;
    }

    manager.Island = island_index;
    //Notifier.notify(player, "Set island to %.", {island_index});
    log_info("% set island to % via /island", {player.get_username(), island_index});
} @chat_command @youtuber

beacon :: proc(player: Player, beacon_level_text: string = "") {
    if !Game.is_server() return;
    if player == null return;

    beacon_level, beacon_level_ok := try_parse_positive_s64(beacon_level_text);
    if !beacon_level_ok || beacon_level < 1 || beacon_level > Beacon.MAX_LEVEL {
        show_cheat_command_help(
            player,
            format_string("Incorrect usage: /beacon <level 1-%>", {Beacon.MAX_LEVEL})
        );
        return;
    }

    updated_count: s64 = 0;
    next_level := beacon_level.(s64);
    foreach active_beacon: component_iterator(Beacon) {
        if active_beacon == null continue;

        active_beacon.set_beacon_level(next_level);
        updated_count += 1;
    }

    if updated_count <= 0 {
        Notifier.notify(player, "Beacon is unavailable.");
        return;
    }

    Notifier.notify(player, "Set Beacon level to %.", {next_level});
    log_info("% set beacon level to % via /beacon", {player.get_username(), next_level});
} @chat_command @youtuber

raid :: proc(player: Player, extra: string = "") {
    if !Game.is_server() return;
    if player == null return;

    if extra.count > 0 {
        show_cheat_command_help(player, "Incorrect usage: /raid");
        return;
    }

    manager := ensure_game_manager_exists();
    if manager == null {
        Notifier.notify(player, "GameManager is unavailable.");
        return;
    }

    manager.set_forced_next_night_event(.RAID);
    Notifier.notify(player, "Next night event forced to Raid.");
    log_info("% queued a forced Raid event via /raid", {player.get_username()});
} @chat_command @youtuber

