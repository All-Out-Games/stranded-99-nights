
draw_ability_name_label :: proc(button_rect: Rect, label: string) {
	if label.count <= 0 return;

	bg := get_asset(Texture_Asset, "$AO/white.png");

	// Draw a small strip at the bottom of the button for readability.
	label_rect := button_rect.inset(8).cut_bottom(30);
	UI.quad(label_rect, bg, v4.{0, 0, 0, 0.55});

	ts := UI.default_text_settings();
	ts.size = 22;
	ts.color = v4.{1, 1, 1, 1};
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(label_rect, ts, label);
}

Private_Server_Start_Ability :: class : Ability_Base {
    on_init :: proc(ability: Ability_Base) {
        ability.name = "Start Run";
        ability.icon = get_asset(Texture_Asset, "UI/BeaconImage.png");
        ability.disable_keybind = true;
    }

    can_use :: proc(ability: Ability_Base) -> bool {
        p := ability.player.(Player);
        manager := get_game_manager();
        if manager == null return false;
        return manager.can_player_vote_start_from_lobby(p);
    }

    on_update :: proc(ability: Ability_Base, params: ref Ability_Update_Params) {
        if !(params.clicked && params.can_use && ability.current_cooldown <= 0.0) return;

        p := ability.player.(Player);
        ability.current_cooldown = 0.5;

        manager := get_game_manager();
        if manager != null && manager.try_vote_to_start_run(p) {
            game_sfx_play(.UI_CLICK, p.entity);
        } else {
            game_sfx_play(.UI_ERROR, p.entity);
        }
    }

    on_draw_button :: proc(instance: Private_Server_Start_Ability, rect: Rect) {
        manager := get_game_manager();
        if manager == null {
		    draw_ability_name_label(rect, "Start Run");
            return;
        }

        p := instance.player.(Player);
        vote_count := manager.get_start_run_vote_count();
        required_votes := manager.get_required_start_run_votes();
        label := format_string("Start %/%", {vote_count, required_votes});
        if manager.has_player_voted_to_start_run(p) {
            label = format_string("Ready %/%", {vote_count, required_votes});
        }
		draw_ability_name_label(rect, label);
	}

}
