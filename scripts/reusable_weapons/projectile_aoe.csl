// AOE damage helper: damages mobs in radius
apply_aoe_damage :: proc(pos: v2, owner_id: u64, radius: float, damage: float) {
    if !Game.is_server() return;

    mob_damage_all_in_range_from_player(pos, radius, damage, owner_id);
}

// AOE projectile: standard projectile that explodes on impact
AOE_Projectile :: class : Component {
    damage: float;
    lifetime: float;
    direction: v2;
    owner_id: u64;
    speed: float;
    max_lifetime: float;
    aoe_radius: float;
    aoe_damage: float;

    ao_update :: method(dt: float) {
        lifetime += dt;
        if max_lifetime <= 0 {
            max_lifetime = 3.0;
        }
        if lifetime > max_lifetime {
            entity->destroy();
            return;
        }

        move := v2{direction.x * speed * dt, direction.y * speed * dt};
        entity->add_local_position(move);

        if Game.is_server() {
            pos := entity.world_position + v2{0, -0.5};
            hit_mob, mob_found := Scene.get_closest_component_in_range(pos, 0.8, Mob);
            if mob_found && hit_mob != null {
                if hit_mob->is_alive() {
                    mob_apply_damage_from_player(hit_mob, damage, owner_id);

                    if aoe_radius > 0 {
                        apply_aoe_damage(pos, owner_id, aoe_radius, aoe_damage);
                    }

                    sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/cannon_explode.wav");
                    sfx_desc := SFX.default_sfx_desc();
                    sfx_desc->set_position(pos);
                    sfx_desc.range_multiplier = 3.0;
                    SFX.play(sfx, sfx_desc);

                    entity->destroy();
                    return;
                }
            }
        }
    }
}

spawn_aoe_projectile :: proc(player: Player, direction: v2, wt: Weapon_Type) {
    if !Game.is_server() return;

    config := get_weapon_config(wt);
    bone_local := player.animator.instance->get_bone_local_position("PROJECTILE");
    barrel_dist := length(bone_local);
    dir := normalize_or_zero(direction);
    spawn_pos := v2{player.animator.entity.world_position.x + dir.x * barrel_dist, player.animator.entity.world_position.y + dir.y * barrel_dist};

    proj_entity := Scene.create_entity();
    proj_entity->set_local_position(spawn_pos);

    angle := atan2(dir.y, dir.x);
    proj_entity->set_local_rotation(to_degrees(angle));

    texture_path := "reusable_weapons/sprites/reusable-weapons/projectiles/shotgun_bullet2.png";
    proj_texture := get_asset(Texture_Asset, texture_path);
    sprite := proj_entity->add_component(Sprite_Renderer);
    sprite->set_texture(proj_texture);
    proj_entity->set_local_scale({2, 2});

    proj := proj_entity->add_component(AOE_Projectile);
    proj.damage = config.base_damage;
    proj.direction = normalize_or_zero(direction);
    proj.owner_id = player.entity.id;
    proj.speed = config.projectile_speed;
    proj.max_lifetime = config.projectile_lifetime;
    proj.aoe_radius = config.aoe_radius;
    proj.aoe_damage = config.aoe_damage;
}
