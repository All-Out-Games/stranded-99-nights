get_health_bar_textures :: proc() -> Texture_Asset, Texture_Asset, Texture_Asset {
    #static back := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_back.png");
    #static fill := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_fill.png");
    #static pip := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_pip.png");
    return back, fill, pip;
}

draw_health_bar :: proc(player: Player) {
    UI.push_world_draw_context();
    defer UI.pop_draw_context();
    UI.push_player_material(player);
    defer UI.pop_material();

    pos := player.entity.world_position;
    UI.push_z(pos.y - 0.0001);
    defer UI.pop_z();

    UI.push_scale_factor(5.0 / 540.0);
    defer UI.pop_scale_factor();

    health_rect := player.username_rect.top_center_rect().offset(0, 5);
    health_rect = health_rect.grow(13, 70, 0, 70);
    border_rect := health_rect.grow(5.5, 4, 5.5, 4).offset(0, -2);

    back, fill, pip := get_health_bar_textures();

    // Background
    UI.quad(border_rect, back, {1, 1, 1, 1});

    // Health fill
    health_pct := player.health / player.max_health;
    fill_rect := health_rect.subrect(0, 0, health_pct, 1);
    UI.quad(fill_rect, fill, {1, 1, 1, 1});

    // Pip markers
    total_pips :: 6;
    health_per_pip := player.max_health / total_pips.(float);
    left_offset :: 0.05;
    right_offset :: 0.05;
    available_width := 1.0 - left_offset - right_offset;
    pip_width := available_width / total_pips.(float);
    shrink :: 0.3;

    i := 0;
    while i < total_pips {
        pip_threshold := (i + 1).(float) * health_per_pip;
        if player.health >= pip_threshold {
            x_min := left_offset + i.(float) * pip_width;
            new_width := pip_width * shrink;
            new_x_min := x_min + (pip_width - new_width) / 2.0;
            new_x_max := new_x_min + new_width;
            pip_rect := health_rect.subrect(new_x_min, 0, new_x_max, 1);
            UI.quad(pip_rect, pip, {1, 1, 1, 1});
        }
        i += 1;
    }
}

draw_mob_health_bar :: proc(mob: Mob, material_player: Player = null) {
    if mob == null return;
    if mob.max_health <= 0.0 return;
    if mob.health <= 0.0 return;

    UI.push_world_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(1000);
    defer UI.pop_layer();

    if material_player != null {
        UI.push_player_material(material_player);
        defer UI.pop_material();
    }

    base_pos := mob.entity.world_position;
    pos := base_pos + v2{0, 1.65};
    // Keep y-sorting tied to the mob while layer forces the bar above world rigs.
    UI.push_z(base_pos.y - 0.0001);
    defer UI.pop_z();

    UI.push_scale_factor(5.0 / 540.0);
    defer UI.pop_scale_factor();

    health_rect := Rect{pos, pos}.grow(13, 70, 0, 70);
    border_rect := health_rect.grow(5.5, 4, 5.5, 4).offset(0, -2);

    back, fill, pip := get_health_bar_textures();

    UI.quad(border_rect, back, {1, 1, 1, 1});

    health_pct := clamp(mob.health / mob.max_health, 0.0, 1.0);
    fill_rect := health_rect.subrect(0, 0, health_pct, 1);
    UI.quad(fill_rect, fill, {1, 1, 1, 1});

    total_pips :: 6;
    health_per_pip := mob.max_health / total_pips.(float);
    left_offset :: 0.05;
    right_offset :: 0.05;
    available_width := 1.0 - left_offset - right_offset;
    pip_width := available_width / total_pips.(float);
    shrink :: 0.3;

    i := 0;
    while i < total_pips {
        pip_threshold := (i + 1).(float) * health_per_pip;
        if mob.health >= pip_threshold {
            x_min := left_offset + i.(float) * pip_width;
            new_width := pip_width * shrink;
            new_x_min := x_min + (pip_width - new_width) / 2.0;
            new_x_max := new_x_min + new_width;
            pip_rect := health_rect.subrect(new_x_min, 0, new_x_max, 1);
            UI.quad(pip_rect, pip, {1, 1, 1, 1});
        }
        i += 1;
    }
}
